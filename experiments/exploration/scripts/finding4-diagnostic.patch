diff -ruN a/crates/gordian-world/examples/directives.rs b/crates/gordian-world/examples/directives.rs
--- a/crates/gordian-world/examples/directives.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/gordian-world/examples/directives.rs	2026-10-05 03:23:55.476910261 +0000
@@ -0,0 +1,16 @@
+//! SCRATCH (not in the repository): list the harness directives of ComponentTimeout episodes.
+//! Public API only; no hidden-state feature.
+use gordian_world::{EpisodeClass, EpisodeSpec, generate};
+
+fn main() {
+    println!("seed\tdirectives");
+    for seed in 1000..1500u64 {
+        let ep = generate(&EpisodeSpec::new(seed, EpisodeClass::ComponentTimeout));
+        let d: Vec<String> = ep
+            .harness_directives()
+            .iter()
+            .map(|d| format!("{}:{:?}", d.component, d.mode))
+            .collect();
+        println!("{}\t{}", seed, d.join(";"));
+    }
+}
