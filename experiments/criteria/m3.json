        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "eq",
            "value": "slow_leak"
          }
        ]
      },
      "den": {
        "file": "incidents.csv",
        "agg": "count",
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "eq",
            "value": "slow_leak"
          }
        ]
      }
    },
    "calls_per_stream": {
      "kind": "ratio",
      "num": {
        "file": "results.csv",
        "agg": "sum",
        "columns": {
          "reasoner_calls": 1
        }
      },
      "den": {
        "per_stream": 1
