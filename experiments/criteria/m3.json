    "substrate_s_per_stream": {
      "kind": "ratio",
      "num": {
        "file": "results.csv",
        "agg": "sum",
        "columns": {
          "substrate_ns": 1
        }
      },
      "den": {
        "per_stream": 1
      },
      "scale": 1e-09
    },
    "cost_s_per_stream": {
      "kind": "ratio",
      "num": {
        "file": "results.csv",
        "agg": "sum",
        "columns": {
          "total_cost_ns": 1
        }
      },
      "den": {
        "per_stream": 1
      },
      "scale": 1e-09
    }
  },
  "clauses": [
    {
      "id": "r1.t100",
      "kind": "paired",
      "arm": "medium_t100",
      "minus": "reanchor",
      "measure": "hard_anchor_correct_share",
      "description": "Result 1 at 100 ms, M2's margin and bound: medium minus ReanchorNoticer, paired: point >= 0.03 and 5th percentile > 0.01",
      "tests": [
        {
          "on": "point",
          "op": ">=",
          "value": 0.03
        },
        {
          "on": "lower",
          "op": ">",
          "value": 0.01
        }
      ]
    },
    {
      "id": "bg.t100",
      "kind": "value",
      "arm": "medium_t100",
      "measure": "notices_on_background_per_stream",
      "description": "Background bound at 100 ms: point <= 6.82",
      "tests": [
        {
          "on": "point",
          "op": "<=",
          "value": 6.82
        }
      ]
    },
    {
      "id": "sp.t100",
      "kind": "value",
      "arm": "medium_t100",
      "measure": "strict_precision",
      "description": "Strict precision at 100 ms: pooled point >= 0.67",
      "tests": [
        {
          "on": "point",
          "op": ">=",
          "value": 0.67
        }
      ]
    },
