{
  "schema": "gordian-criterion/1",
  "id": "m3",
  "title": "M3: sub-tick support and strict precision; M2's result 1 at 500 ms and 2 s",
  "source": "docs/lab-queue.md, '## M3', 'Criterion, fixed by the chief before any M3 code or run (2026-10-06)': M2's two results, comparator ReanchorNoticer, M2's margins and bounds, plus strict precision >= 0.67, at 500 ms and 2 s; 'holds' means result 1 holds at both longer ticks",
  "runs": {
    "heldout": {
      "streams": {
        "first_seed": 20000,
        "count": 200
      }
    }
  },
  "arms": {
    "reanchor": {
      "run": "heldout",
      "dir": "sel_reanchor_privileged"
    },
    "rung_z2": {
      "run": "heldout",
      "dir": "sel_rung_z2_privileged"
    },
    "rung_z3": {
      "run": "heldout",
      "dir": "sel_rung_z3_privileged"
    },
    "ramp_over_re2": {
      "run": "heldout",
      "dir": "sel_ramp_over_re2_privileged"
    },
    "ramp_split_over_re2": {
      "run": "heldout",
      "dir": "sel_ramp_split_over_re2_privileged"
    },
    "medium_t100": {
      "run": "heldout",
      "dir": "sel_med_t100_privileged"
    },
    "medium_t100_subtick_off": {
      "run": "heldout",
      "dir": "sel_med_t100_subtick_off_privileged"
    },
    "m2_t100": {
      "run": "heldout",
      "dir": "sel_m2_t100_privileged"
    },
    "medium_t500": {
      "run": "heldout",
      "dir": "sel_med_t500_privileged"
    },
    "medium_t500_subtick_off": {
      "run": "heldout",
      "dir": "sel_med_t500_subtick_off_privileged"
    },
    "m2_t500": {
      "run": "heldout",
      "dir": "sel_m2_t500_privileged"
    },
    "medium_t2000": {
      "run": "heldout",
      "dir": "sel_med_t2000_privileged"
    },
    "medium_t2000_subtick_off": {
      "run": "heldout",
      "dir": "sel_med_t2000_subtick_off_privileged"
    },
    "m2_t2000": {
      "run": "heldout",
      "dir": "sel_m2_t2000_privileged"
    }
  },
  "bootstrap": {
    "unit": "stream",
    "resamples": 10000,
    "seed": 9950,
    "percentiles": [
      5,
      95
    ],
    "interval": "lower_higher",
    "chunk": 500
  },
  "measures": {
    "hard_noticed_share": {
      "kind": "ratio",
      "num": {
        "file": "notice_incidents.csv",
        "agg": "sum",
        "columns": {
          "noticed": 1
        },
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "ne",
            "value": "slow_leak"
          }
        ]
      },
      "den": {
        "file": "notice_incidents.csv",
        "agg": "count",
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "ne",
            "value": "slow_leak"
          }
        ]
      },
      "description": "hard non-leak incidents with a notice anchored on them (N2)"
    },
    "hard_anchor_correct_share": {
      "kind": "ratio",
      "num": {
        "file": "notice_incidents.csv",
        "agg": "sum",
        "columns": {
          "anchor_correct": 1
        },
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "ne",
            "value": "slow_leak"
          }
        ]
      },
      "den": {
        "file": "notice_incidents.csv",
        "agg": "count",
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "ne",
            "value": "slow_leak"
          }
        ]
      },
      "description": "hard non-leak incidents with an anchor-correct notice (N5)"
    },
    "hard_anchor_site_correct_share": {
      "kind": "ratio",
      "num": {
        "file": "notice_incidents.csv",
        "agg": "sum",
        "columns": {
          "anchor_site_correct": 1
        },
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "ne",
            "value": "slow_leak"
          }
        ]
      },
      "den": {
        "file": "notice_incidents.csv",
        "agg": "count",
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "ne",
            "value": "slow_leak"
          }
        ]
      }
    },
    "leak_noticed_share": {
      "kind": "ratio",
      "num": {
        "file": "notice_incidents.csv",
        "agg": "sum",
        "columns": {
          "noticed": 1
        },
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "eq",
            "value": "slow_leak"
          }
        ]
      },
      "den": {
        "file": "notice_incidents.csv",
        "agg": "count",
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "eq",
            "value": "slow_leak"
          }
        ]
      },
      "description": "slow-leak incidents with a notice anchored on them"
    },
    "leak_anchor_correct_share": {
      "kind": "ratio",
      "num": {
        "file": "notice_incidents.csv",
        "agg": "sum",
        "columns": {
          "anchor_correct": 1
        },
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "eq",
            "value": "slow_leak"
          }
        ]
      },
      "den": {
        "file": "notice_incidents.csv",
        "agg": "count",
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "eq",
            "value": "slow_leak"
          }
        ]
      }
    },
    "notices_on_background_per_stream": {
      "kind": "ratio",
      "num": {
        "file": "notices.csv",
        "agg": "sum",
        "columns": {
          "notices_on_background": 1
        }
      },
      "den": {
        "per_stream": 1
      },
      "description": "mean over streams of notices anchored on no incident (N8)"
    },
    "notice_precision": {
      "kind": "ratio",
      "num": {
        "file": "notices.csv",
        "agg": "sum",
        "columns": {
          "notices": 1,
          "notices_on_background": -1
        }
      },
      "den": {
        "file": "notices.csv",
        "agg": "sum",
        "columns": {
          "notices": 1
        }
      },
      "description": "notices anchored on an incident of any tier over all notices (N16)"
    },
    "strict_precision": {
      "kind": "ratio",
      "num": {
        "file": "notices.csv",
        "agg": "sum",
        "columns": {
          "notices_anchor_site_correct": 1
        }
      },
      "den": {
        "file": "notices.csv",
        "agg": "sum",
        "columns": {
          "notices": 1
        }
      },
      "description": "notices that are anchor-correct and site-correct over all notices"
    },
    "notices_per_incident": {
      "kind": "ratio",
      "num": {
        "file": "notices.csv",
        "agg": "sum",
        "columns": {
          "notices": 1,
          "notices_on_background": -1
        }
      },
      "den": {
        "file": "notice_incidents.csv",
        "agg": "count"
      },
      "description": "notices anchored on an incident of any tier over incidents of every tier"
    },
    "notices_per_stream": {
      "kind": "ratio",
      "num": {
        "file": "notices.csv",
        "agg": "sum",
        "columns": {
          "notices": 1
        }
      },
      "den": {
        "per_stream": 1
      }
    },
    "notices_on_decoy_per_stream": {
      "kind": "ratio",
      "num": {
        "file": "notices.csv",
        "agg": "sum",
        "columns": {
          "notices_on_decoy": 1
        }
      },
      "den": {
        "per_stream": 1
      }
    },
    "plain_noticed_share": {
      "kind": "ratio",
      "num": {
        "file": "notice_incidents.csv",
