{
  "schema": "gordian-criterion/1",
  "id": "a1b",
  "title": "A1b DRAFT: the engram against the record rung, family-keyed and carried across streams",
  "source": "DRAFT written by Lab 2 in unit E1 from W2 section 10.2 and the review log entries after W2 and A1a; the chief fixes the numbers and writes experiments/criteria/a1b.json before any A1b run",
  "readings": [
    "The primary population is the family form carried across streams; the site form is a secondary row (the review log, after W2).",
    "'Unasked correct' is the evaluator's K3: a correct declaration and no escalation about the incident, whoever made it; on hard incidents only a memory makes one.",
    "Collision share is over the recalls whose stored answer was right for its own incident (K5, K6); inherited errors are compared with the record rung's and have no absolute bound.",
    "The paired excess of unasked wrong declarations is read on plain incidents, where the cheap rung's own errors cancel against the control's.",
    "The stale-error clauses are evaluated with and without the reset at the stream boundary by running the arms twice; the carried version of a site-keyed arm fails by construction and is reported, not tuned.",
    "Cost is total_cost_ns plus noticer_ns (results.csv); total_cost_ns alone omits the medium's noticer charge."
  ],
  "runs": {
    "heldout": {
      "streams": {
        "first_seed": 40000,
        "count": 200
      }
    }
  },
  "arms": {
    "engram": {
      "run": "heldout",
      "dir": "sel_eng_family_carried_privileged"
    },
    "record": {
      "run": "heldout",
      "dir": "sel_rec_family_carried_privileged"
    },
    "control": {
      "run": "heldout",
      "dir": "sel_reanchor_privileged"
    }
  },
  "bootstrap": {
    "unit": "stream",
    "resamples": 10000,
    "seed": 9950,
    "percentiles": [
      5,
      95
    ],
    "interval": "lower_higher",
    "chunk": 500
  },
  "measures": {
    "recurrence_unasked_correct": {
      "kind": "ratio",
      "description": "hard incidents that repeat an earlier one (K1), declared correctly with no escalation about them (K3), over those incidents",
      "num": {
        "file": "memory_incidents.csv",
        "agg": "count",
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "recurrence_of",
            "op": "notnull"
          },
          {
            "column": "unasked_correct",
            "op": "eq",
            "value": true
          }
        ]
      },
      "den": {
        "file": "memory_incidents.csv",
        "agg": "count",
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "recurrence_of",
            "op": "notnull"
          }
        ]
      }
    },
    "reachable_unasked_correct": {
      "kind": "ratio",
      "description": "the same over the hard incidents a family-keyed memory can reach: a recurrence, or an earlier same-family-and-mode incident at another site",
      "num": {
        "file": "memory.csv",
        "agg": "sum",
        "columns": {
          "hard_reachable_unasked_correct": 1
        }
      },
      "den": {
        "file": "memory.csv",
        "agg": "sum",
        "columns": {
          "hard_reachable": 1
        }
      }
    },
    "hard_unasked_correct": {
      "kind": "ratio",
      "description": "hard incidents declared correctly with no escalation, over all hard incidents",
      "num": {
        "file": "memory.csv",
        "agg": "sum",
        "columns": {
          "unasked_correct_hard": 1
        }
      },
      "den": {
        "file": "results.csv",
        "agg": "sum",
        "columns": {
          "incidents_hard": 1
        }
      }
    },
    "collision_share": {
      "kind": "ratio",
      "description": "of the recalls whose stored answer was right for its own incident, the share that were wrong: collision or staleness (K6)",
      "num": {
        "file": "memory.csv",
        "agg": "sum",
        "columns": {
          "recalls_wrong_source_right": 1
        }
      },
      "den": {
        "file": "memory.csv",
        "agg": "sum",
        "columns": {
          "recalls_correct_source_right": 1,
          "recalls_wrong_source_right": 1
        }
      }
    },
    "collisions_per_stream": {
      "kind": "ratio",
      "description": "wrong recalls whose stored answer was right, per stream",
      "num": {
        "file": "memory.csv",
        "agg": "sum",
        "columns": {
          "recalls_wrong_source_right": 1
        }
      },
      "den": {
        "per_stream": 1
      }
    },
    "collisions_q90": {
      "kind": "quantile",
      "q": 0.9,
      "description": "the 90th percentile over streams of the collisions in a stream",
      "num": {
        "file": "memory.csv",
        "agg": "sum",
        "columns": {
          "recalls_wrong_source_right": 1
        }
      },
      "den": {
        "per_stream": 1
      }
    },
    "inherited_per_stream": {
      "kind": "ratio",
      "description": "wrong recalls whose stored answer was wrong for its own incident, per stream",
      "num": {
        "file": "memory.csv",
        "agg": "sum",
        "columns": {
          "recalls_wrong_source_wrong": 1
        }
      },
      "den": {
        "per_stream": 1
      }
    },
    "plain_unasked_wrong_per_stream": {
      "kind": "ratio",
      "description": "plain incidents with a wrong declaration and no escalation (every origin), per stream; read as the paired excess over the control",
      "num": {
        "file": "memory.csv",
        "agg": "sum",
        "columns": {
          "unasked_wrong_plain": 1
        }
      },
      "den": {
        "per_stream": 1
      }
    },
    "plain_displaced_per_stream": {
      "kind": "ratio",
      "description": "plain incidents the control declared correctly with no escalation and this arm did not: correct declarations a recall displaced, per stream",
      "num": {
        "file": "memory_incidents.csv",
        "agg": "count",
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "plain"
          },
          {
            "column": "unasked_correct@control",
            "op": "eq",
            "value": true
          },
          {
            "column": "unasked_correct",
            "op": "eq",
            "value": false
          }
        ],
        "join": {
          "arm": "control"
        }
      },
      "den": {
        "per_stream": 1
      }
    },
    "calls_per_stream": {
      "kind": "ratio",
      "description": "reasoner calls per stream",
      "num": {
        "file": "results.csv",
        "agg": "sum",
        "columns": {
          "reasoner_calls": 1
        }
      },
      "den": {
        "per_stream": 1
      }
    },
    "cost_s": {
      "kind": "ratio",
      "description": "modelled seconds per stream: total_cost_ns plus the noticer's charge",
      "num": {
        "file": "results.csv",
        "agg": "sum",
        "columns": {
          "total_cost_ns": 1,
          "noticer_ns": 1
        }
      },
      "den": {
        "per_stream": 1
      },
      "scale": 1e-09
    },
    "hard_recurrences_n": {
      "kind": "ratio",
      "description": "hard recurrences (the population of the floor and the margin)",
      "num": {
        "file": "memory_incidents.csv",
        "agg": "count",
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "recurrence_of",
            "op": "notnull"
          }
        ]
      },
      "den": {
        "per_stream": 1
      }
    },
    "reachable_n": {
      "kind": "ratio",
      "description": "hard incidents reachable by a family-keyed memory",
      "num": {
        "file": "memory.csv",
        "agg": "sum",
        "columns": {
          "hard_reachable": 1
        }
      },
      "den": {
        "per_stream": 1
      }
    }
  },
  "clauses": [
    {
      "id": "power_recurrences",
      "kind": "count",
      "arm": "control",
      "measure": "recurrence_unasked_correct",
      "description": "a precondition: the held-out range holds enough hard recurrences to resolve a paired margin of 0.10 (PROPOSAL: at least 70 of 83; W3's world C would raise it)",
      "tests": [
        {
          "on": "total",
          "op": ">=",
          "value": 70
        }
      ]
    },
    {
      "id": "power_reachable",
      "kind": "count",
      "arm": "control",
      "measure": "reachable_unasked_correct",
      "description": "a precondition: enough reachable hard incidents (PROPOSAL: at least 120; the held-out range holds 134)",
      "tests": [
        {
          "on": "total",
          "op": ">=",
          "value": 120
        }
      ]
    },
    {
      "id": "floor_recurrences",
      "kind": "value",
      "arm": "engram",
      "measure": "recurrence_unasked_correct",
      "description": "W2 10.2, the floor on hard recurrences: unasked correct at least 0.15 of them with the 90% lower bound above 0.075 (PROPOSAL, W2's)",
      "tests": [
        {
          "on": "point",
          "op": ">=",
          "value": 0.15
        },
        {
          "on": "lower",
          "op": ">",
          "value": 0.075
        }
      ]
    },
    {
      "id": "margin_over_record",
      "kind": "paired",
      "arm": "engram",
      "measure": "recurrence_unasked_correct",
      "description": "W2 10.2, the margin over the record rung of the same key form: +0.10 of hard recurrences with the lower bound above 0 (PROPOSAL, W2's)",
      "tests": [
        {
          "on": "point",
          "op": ">=",
          "value": 0.1
        },
        {
          "on": "lower",
          "op": ">",
          "value": 0
        }
      ],
      "minus": "record"
    },
    {
      "id": "reachable_over_record",
      "kind": "paired",
      "arm": "engram",
      "measure": "reachable_unasked_correct",
      "description": "the same margin on the reachable hard incidents, where the family form's cross-stream law lives (PROPOSAL: reported with the same bounds; the chief may fix another)",
      "tests": [
        {
          "on": "point",
          "op": ">=",
          "value": 0.1
        },
        {
          "on": "lower",
          "op": ">",
          "value": 0
        }
      ],
      "minus": "record"
    },
    {
      "id": "collision_share_bound",
      "kind": "value",
      "arm": "engram",
      "measure": "collision_share",
      "description": "W2 10.2(a): of the recalls whose stored answer was right for its own incident, at most 0.20 wrong, with the 90% upper bound at most 0.30 (PROPOSAL, W2's)",
      "tests": [
        {
          "on": "point",
          "op": "<=",
          "value": 0.2
        },
        {
          "on": "upper",
          "op": "<=",
          "value": 0.3
        }
      ]
    },
    {
      "id": "collisions_per_stream_bound",
      "kind": "value",
      "arm": "engram",
      "measure": "collisions_per_stream",
      "description": "W2 10.2(a): at most 0.25 such wrong recalls per stream (PROPOSAL, W2's)",
      "tests": [
        {
          "on": "point",
          "op": "<=",
          "value": 0.25
        }
      ]
    },
    {
      "id": "collisions_q90",
      "kind": "value",
      "arm": "engram",
      "measure": "collisions_q90",
      "description": "the tail: no more than one collision in the stream at the 90th percentile (PROPOSAL, a reading of 'per stream' that a mean can hide)",
      "tests": [
        {
          "on": "point",
          "op": "<=",
          "value": 1.0
        }
      ]
    },
    {
      "id": "inherited_not_above_record",
      "kind": "paired",
      "arm": "engram",
      "measure": "inherited_per_stream",
      "description": "W2 10.2(b): no more inherited wrong recalls per stream than the record rung of the same key form (no absolute bound)",
      "tests": [
        {
          "on": "point",
          "op": "<=",
          "value": 0.0
        }
      ],
      "minus": "record"
    },
    {
      "id": "plain_excess",
      "kind": "paired",
      "arm": "engram",
      "measure": "plain_unasked_wrong_per_stream",
      "description": "the review log's decision after A1a: the paired excess of plain incidents with a wrong unasked declaration over the memoryless control, per stream, at most 0.25 (A1c's acceptance, 5 in 20 streams) on the 90% upper bound (PROPOSAL)",
      "tests": [
        {
          "on": "upper",
          "op": "<=",
          "value": 0.25
        }
      ],
      "minus": "control"
    },
    {
      "id": "plain_displaced",
      "kind": "value",
      "arm": "engram",
      "measure": "plain_displaced_per_stream",
      "description": "correct plain declarations a recall displaced, per stream: none (PROPOSAL)",
      "tests": [
        {
          "on": "point",
          "op": "<=",
          "value": 0.0
        }
      ]
    },
    {
      "id": "cost_under_record",
      "kind": "paired",
      "arm": "engram",
      "measure": "cost_s",
      "description": "the engram costs no more per stream than the record rung, the noticer's charge included (PROPOSAL; W2's interval on the ceiling is about 3 points of the bill)",
      "tests": [
        {
          "on": "point",
          "op": "<=",
          "value": 0.0
        }
      ],
      "minus": "record"
    },
    {
      "id": "record_share",
      "kind": "value",
      "arm": "record",
      "measure": "recurrence_unasked_correct",
      "description": "W2 10.2's pre-accepted outcome: the record rung's share of hard recurrences above 0.27 puts +0.10 out of reach for any arm (PROPOSAL, W2's)",
      "tests": [
        {
          "on": "point",
          "op": ">",
          "value": 0.27
        }
      ]
    },
    {
      "id": "record_collision_bound",
      "kind": "value",
      "arm": "record",
      "measure": "collision_share",
      "description": "beside, never in the verdict: whether the record rung meets the collision bound it is the comparator for",
      "tests": [
        {
          "on": "point",
          "op": "<=",
          "value": 0.2
        }
      ]
    }
  ],
  "reports": [
    {
      "id": "shares",
      "kind": "table",
      "arms": [
        "engram",
        "record",
        "control"
      ],
      "measures": [
        "recurrence_unasked_correct",
        "reachable_unasked_correct",
        "hard_unasked_correct"
      ],
      "description": "unasked-correct shares by population"
    },
    {
      "id": "errors",
      "kind": "table",
      "arms": [
        "engram",
        "record"
      ],
      "measures": [
        "collision_share",
        "collisions_per_stream",
        "inherited_per_stream",
        "plain_unasked_wrong_per_stream"
      ],
      "description": "the two kinds of stale error and the plain-incident errors"
    },
    {
      "id": "cost",
      "kind": "paired_table",
      "pairs": [
        [
          "engram",
          "record"
        ],
        [
          "engram",
          "control"
        ],
        [
          "record",
          "control"
        ]
      ],
      "measures": [
        "calls_per_stream",
        "cost_s"
      ],
      "description": "calls and modelled seconds per stream, paired"
    }
  ],
  "verdict": {
    "name": "the memory holds: floor, margin, stale errors within the bound, no more inherited errors than the record rung, plain errors and cost bounded",
    "all": [
      "power_recurrences",
      "power_reachable",
      "floor_recurrences",
      "margin_over_record",
      {
        "name": "stale errors within the bound",
        "all": [
          "collision_share_bound",
          "collisions_per_stream_bound",
          "collisions_q90"
        ]
      },
      "inherited_not_above_record",
      "plain_excess",
      "plain_displaced",
      "cost_under_record"
    ]
  },
  "observations": {
    "record_collision_within_bound": {
      "all": [
        "record_collision_bound"
      ]
    },
    "reachable_margin_holds": {
      "all": [
        "reachable_over_record"
      ]
    }
  },
  "outcomes": {
    "name": "A1b's exclusive outcomes, in the order a reader should check them",
    "default": "no_gain_over_the_record_rung",
    "categories": [
      {
        "name": "underpowered",
        "when": {
          "not": {
            "all": [
              "power_recurrences",
              "power_reachable"
            ]
          }
        }
      },
      {
        "name": "stale_errors_exceed_the_bound",
        "when": {
          "not": {
            "name": "stale errors within the bound (outcome)",
            "all": [
              "collision_share_bound",
              "collisions_per_stream_bound",
              "collisions_q90"
            ]
          }
        }
      },
      {
        "name": "memory_holds",
        "when": {
          "all": [
            "floor_recurrences",
            "margin_over_record",
            "inherited_not_above_record",
            "plain_excess",
            "plain_displaced",
            "cost_under_record"
          ]
        }
      },
      {
        "name": "the_record_rung_captures_the_lever",
        "when": {
          "all": [
            "record_share",
            {
              "not": "margin_over_record"
            }
          ]
        }
      }
    ]
  }
}
