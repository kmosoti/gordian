{
  "schema": "gordian-criterion/1",
  "id": "m2",
  "title": "M2: the medium as a noticer, against ReanchorNoticer",
  "source": "docs/lab-queue.md, '## M2', 'Criterion, fixed by the chief before any M2 code or run (2026-10-06)', with its re-fix of 2026-10-06 (comparator ReanchorNoticer from B2's table) and the amendment of the same date; background bound 6.82 notices per stream",
  "runs": {
    "heldout": {
      "streams": {
        "first_seed": 20000,
        "count": 200
      }
    }
  },
  "arms": {
    "reanchor": {
      "run": "heldout",
      "dir": "sel_reanchor_privileged"
    },
    "rung_z2": {
      "run": "heldout",
      "dir": "sel_rung_z2_privileged"
    },
    "rung_z3": {
      "run": "heldout",
      "dir": "sel_rung_z3_privileged"
    },
    "medium_t100": {
      "run": "heldout",
      "dir": "sel_med_t100_privileged"
    },
    "medium_t100_sliding": {
      "run": "heldout",
      "dir": "sel_med_t100_sliding_privileged"
    },
    "medium_t100_abnormal_only": {
      "run": "heldout",
      "dir": "sel_med_t100_abnormal_only_privileged"
    },
    "medium_t500": {
      "run": "heldout",
      "dir": "sel_med_t500_privileged"
    },
    "medium_t500_sliding": {
      "run": "heldout",
      "dir": "sel_med_t500_sliding_privileged"
    },
    "medium_t500_abnormal_only": {
      "run": "heldout",
      "dir": "sel_med_t500_abnormal_only_privileged"
    },
    "medium_t2000": {
      "run": "heldout",
      "dir": "sel_med_t2000_privileged"
    },
    "medium_t2000_sliding": {
      "run": "heldout",
      "dir": "sel_med_t2000_sliding_privileged"
    },
    "medium_t2000_abnormal_only": {
      "run": "heldout",
      "dir": "sel_med_t2000_abnormal_only_privileged"
    },
    "medium_t100_lb100": {
      "run": "heldout",
      "dir": "sel_med_t100_lb100_privileged"
    },
    "medium_t100_lb200": {
      "run": "heldout",
      "dir": "sel_med_t100_lb200_privileged"
    },
    "medium_t100_lb500": {
      "run": "heldout",
      "dir": "sel_med_t100_lb500_privileged"
    },
    "medium_t100_lb1000": {
      "run": "heldout",
      "dir": "sel_med_t100_lb1000_privileged"
    },
    "medium_t100_binned": {
      "run": "heldout",
      "dir": "sel_med_t100_binned_privileged"
    }
  },
  "bootstrap": {
    "unit": "stream",
    "resamples": 10000,
    "seed": 9950,
    "percentiles": [
      5,
      95
    ],
    "interval": "lower_higher",
    "chunk": 500
  },
  "measures": {
    "hard_noticed_share": {
      "kind": "ratio",
      "num": {
        "file": "notice_incidents.csv",
        "agg": "sum",
        "columns": {
          "noticed": 1
        },
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "ne",
            "value": "slow_leak"
          }
        ]
      },
      "den": {
        "file": "notice_incidents.csv",
        "agg": "count",
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "ne",
            "value": "slow_leak"
          }
        ]
      },
      "description": "hard non-leak incidents with a notice anchored on them (N2)"
    },
    "hard_anchor_correct_share": {
      "kind": "ratio",
      "num": {
        "file": "notice_incidents.csv",
        "agg": "sum",
        "columns": {
          "anchor_correct": 1
        },
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "ne",
            "value": "slow_leak"
          }
        ]
      },
      "den": {
        "file": "notice_incidents.csv",
        "agg": "count",
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "ne",
            "value": "slow_leak"
          }
        ]
      },
      "description": "hard non-leak incidents with an anchor-correct notice (N5)"
    },
    "hard_anchor_site_correct_share": {
      "kind": "ratio",
      "num": {
        "file": "notice_incidents.csv",
        "agg": "sum",
        "columns": {
          "anchor_site_correct": 1
        },
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "ne",
            "value": "slow_leak"
          }
        ]
      },
      "den": {
        "file": "notice_incidents.csv",
        "agg": "count",
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "ne",
            "value": "slow_leak"
          }
        ]
      }
    },
    "leak_noticed_share": {
      "kind": "ratio",
      "num": {
        "file": "notice_incidents.csv",
        "agg": "sum",
        "columns": {
          "noticed": 1
        },
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "eq",
            "value": "slow_leak"
          }
        ]
      },
      "den": {
        "file": "notice_incidents.csv",
        "agg": "count",
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "eq",
            "value": "slow_leak"
          }
        ]
      },
      "description": "slow-leak incidents with a notice anchored on them"
    },
    "leak_anchor_correct_share": {
      "kind": "ratio",
      "num": {
        "file": "notice_incidents.csv",
        "agg": "sum",
        "columns": {
          "anchor_correct": 1
        },
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "eq",
            "value": "slow_leak"
          }
        ]
      },
      "den": {
        "file": "notice_incidents.csv",
        "agg": "count",
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "eq",
            "value": "slow_leak"
          }
        ]
      }
    },
    "notices_on_background_per_stream": {
      "kind": "ratio",
      "num": {
        "file": "notices.csv",
        "agg": "sum",
        "columns": {
          "notices_on_background": 1
        }
      },
      "den": {
        "per_stream": 1
      },
      "description": "mean over streams of notices anchored on no incident (N8)"
    },
    "notice_precision": {
      "kind": "ratio",
      "num": {
        "file": "notices.csv",
        "agg": "sum",
        "columns": {
          "notices": 1,
          "notices_on_background": -1
        }
      },
      "den": {
        "file": "notices.csv",
        "agg": "sum",
        "columns": {
          "notices": 1
        }
      },
      "description": "notices anchored on an incident of any tier over all notices (N16)"
    },
    "strict_precision": {
      "kind": "ratio",
      "num": {
        "file": "notices.csv",
        "agg": "sum",
        "columns": {
          "notices_anchor_site_correct": 1
        }
      },
      "den": {
        "file": "notices.csv",
        "agg": "sum",
        "columns": {
          "notices": 1
        }
      },
      "description": "notices that are anchor-correct and site-correct over all notices"
    },
    "notices_per_incident": {
      "kind": "ratio",
      "num": {
        "file": "notices.csv",
        "agg": "sum",
        "columns": {
          "notices": 1,
          "notices_on_background": -1
        }
      },
      "den": {
        "file": "notice_incidents.csv",
        "agg": "count"
      },
      "description": "notices anchored on an incident of any tier over incidents of every tier"
    },
    "plain_noticed_share": {
      "kind": "ratio",
      "num": {
        "file": "notice_incidents.csv",
        "agg": "sum",
        "columns": {
          "noticed": 1
        },
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "plain"
          }
        ]
      },
      "den": {
        "file": "notice_incidents.csv",
        "agg": "count",
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "plain"
          }
        ]
      }
    },
    "quality": {
      "kind": "ratio",
      "num": {
        "file": "incidents.csv",
        "agg": "sum",
        "columns": {
          "correct_by_deadline": 1
        },
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "ne",
            "value": "slow_leak"
          }
        ]
      },
      "den": {
        "file": "incidents.csv",
        "agg": "count",
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "ne",
            "value": "slow_leak"
          }
        ]
      },
      "description": "hard non-leak incidents declared correctly by their deadline"
    },
    "leak_quality": {
      "kind": "ratio",
      "num": {
        "file": "incidents.csv",
        "agg": "sum",
        "columns": {
          "correct_by_deadline": 1
        },
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "eq",
            "value": "slow_leak"
          }
        ]
      },
      "den": {
        "file": "incidents.csv",
        "agg": "count",
        "where": [
          {
            "column": "tier",
            "op": "eq",
            "value": "hard"
          },
          {
            "column": "family",
            "op": "eq",
            "value": "slow_leak"
          }
        ]
      }
    },
    "substrate_s_per_stream": {
      "kind": "ratio",
      "num": {
        "file": "results.csv",
        "agg": "sum",
        "columns": {
          "substrate_ns": 1
        }
      },
      "den": {
        "per_stream": 1
      },
      "scale": 1e-09
    },
    "cost_s_per_stream": {
      "kind": "ratio",
      "num": {
        "file": "results.csv",
        "agg": "sum",
        "columns": {
          "total_cost_ns": 1
        }
      },
      "den": {
        "per_stream": 1
      },
      "scale": 1e-09
    }
  },
  "clauses": [
    {
      "id": "r1.t100",
      "kind": "paired",
      "arm": "medium_t100",
      "minus": "reanchor",
      "measure": "hard_anchor_correct_share",
      "description": "Result 1 at 100 ms: anchor-correct share on hard non-leak incidents, medium minus ReanchorNoticer, paired: point >= 0.03 and 5th percentile > 0.01",
      "tests": [
        {
          "on": "point",
          "op": ">=",
          "value": 0.03
        },
        {
          "on": "lower",
          "op": ">",
          "value": 0.01
        }
      ]
    },
    {
      "id": "r2.t100",
      "kind": "paired",
      "arm": "medium_t100",
      "minus": "reanchor",
