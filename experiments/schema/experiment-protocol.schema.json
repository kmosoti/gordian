{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gordian.dev/schema/experiment-protocol-v1.json",
  "title": "ExperimentProtocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_format", "experiment_id", "class", "hypothesis", "falsification",
    "conditions", "baseline_condition", "population", "metrics", "analysis_plan",
    "exclusion_rule", "environment", "registered_at", "registered_by"
  ],
  "properties": {
    "protocol_format": { "const": "gordian-experiment-protocol-v1" },
    "experiment_id":   { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "class":           { "enum": ["agent-trial", "benchmark", "classification", "fault-injection"] },
    "issue":           { "type": "integer", "description": "the issue that runs this experiment" },
    "hypothesis":      { "type": "object", "additionalProperties": false,
                         "required": ["h0", "h1"],
                         "properties": { "h0": { "type": "string" }, "h1": { "type": "string" } } },
    "falsification":   { "type": "string", "minLength": 1 },
    "conditions":      { "type": "array", "minItems": 2,
                         "items": { "type": "object", "required": ["id", "description"] } },
    "baseline_condition": { "type": "string" },
    "population":      { "type": "object", "additionalProperties": false,
                         "required": ["workloads", "sampling", "seeds"],
                         "properties": {
                           "workloads": { "type": "array", "minItems": 1 },
                           "sampling":  { "type": "string" },
                           "strata":    { "type": "array", "items": { "type": "object", "required": ["id", "boundary"] } },
                           "seeds":     { "type": "array", "items": { "type": "integer" }, "minItems": 1 } } },
    "metrics":         { "type": "array", "minItems": 1,
                         "items": { "type": "object", "required": ["id", "unit", "direction"] } },
    "analysis_plan":   { "type": "object", "additionalProperties": false,
                         "required": ["primary_metric", "effect_size", "min_n",
                                      "multiplicity", "stopping_rule"],
                         "properties": {
                           "primary_metric": { "type": "string" },
                           "effect_size":    { "type": "object",
                                               "required": ["measure", "minimum_relevant"] },
                           "min_n":          { "type": "integer", "minimum": 1 },
                           "multiplicity":   { "enum": ["holm", "none"] },
                           "uncertainty":    { "type": "string" },
                           "stopping_rule":  { "type": "string" } } },
    "exclusion_rule":  { "type": "string", "minLength": 1 },
    "environment":     { "type": "object",
                         "required": ["source_commit", "toolchains", "hardware_class"] },
    "artifacts":       { "type": "array", "items": { "type": "string" } },
    "threats":         { "type": "array", "items": { "type": "string" } },
    "registered_at":   { "type": "string", "format": "date-time" },
    "registered_by":   { "type": "string" }
  }
}
