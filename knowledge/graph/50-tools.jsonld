    {"@id":"tool:jujutsu","@type":["Tool"],"name":"Jujutsu","summary":"Distributed version control system used as Gordian's preferred Change Graph substrate because logical change IDs, exact commit IDs, workspaces, operation history, revsets, and first-class conflicts map well to isolated agent execution.","status":"candidate","relations":[{"predicate":"supportedBy","target":"source:jj-docs"},{"predicate":"supportedBy","target":"source:jj-changelog"},{"predicate":"testedBy","target":"experiment:jj-baseline"},{"predicate":"testedBy","target":"experiment:jj-vs-git"},{"predicate":"supportedBy","target":"source:jj-conflicts"}],"verification":[]},
    {"@id":"tool:git","@type":["Tool"],"name":"Git","summary":"Compatibility VCS and experimental control condition for evaluating whether Jujutsu's change/workspace semantics materially reduce Gordian orchestration complexity.","status":"candidate","url":"https://git-scm.com/docs","relations":[{"predicate":"contrastsWith","target":"tool:jujutsu"},{"predicate":"testedBy","target":"experiment:jj-vs-git"},{"predicate":"contrastsWith","target":"source:mimram-digiusto-2013"}],"verification":[]},
    {"@id":"tool:petgraph","@type":["Tool"],"name":"petgraph","summary":"Rust graph library used initially for stable directed graph indexing, traversal, and export in research tooling; must be benchmarked against specialized representations before becoming architecture-critical.","status":"adopted","relations":[{"predicate":"supportedBy","target":"source:petgraph"},{"predicate":"implementedBy","target":"artifact:gordian-kg"},{"predicate":"testedBy","target":"experiment:knowledge-graph-benchmarks"}],"verification":[]},
    {"@id":"tool:lean4","@type":["Tool"],"name":"Lean 4","summary":"Theorem prover and executable specification language used under formal/ for Gordian's abstract safety models; not a production runtime dependency.","status":"adopted","url":"https://lean-lang.org/","relations":[{"predicate":"implementedBy","target":"artifact:formal-kernel"},{"predicate":"usedBy","target":"algorithm:differential-conformance"},{"predicate":"testedBy","target":"experiment:formal-value"},{"predicate":"supportedBy","target":"source:cedar-vgd-fse-2024"}],"verification":[]},
    {"@id":"tool:nanoda","@type":["Tool"],"name":"nanoda","summary":"Independent Lean 4 type checker. Candidate second checker for the formal kernel; not enabled in CI (.github/workflows/verify.yml sets nanoda: false), so no node may claim it verifies anything today.","status":"not-enabled","url":"https://github.com/leanprover/nanoda_lib","relations":[{"predicate":"relatedTo","target":"artifact:formal-kernel"}],"verification":[]},
    {"@id":"tool:axiom-audit","@type":["Tool"],"name":"axiom-audit","summary":"Lean environment audit used to prevent hidden/home-rolled axioms or admitted proof assumptions from silently entering theorem claims.","status":"adopted","url":"https://github.com/leanprover-community/axiom-audit","relations":[{"predicate":"verifiedBy","target":"artifact:formal-kernel"}],"verification":[]},
    {"@id":"tool:cedar","@type":["Tool"],"name":"Cedar Policy","summary":"Rust authorization engine/language with Lean formal specification and differential testing; candidate for Gordian capability policy pending threat-model and performance evaluation.","status":"candidate","relations":[{"predicate":"supportedBy","target":"source:cedar-rust"},{"predicate":"supportedBy","target":"source:cedar-spec"},{"predicate":"testedBy","target":"experiment:authorization-engine"},{"predicate":"supportedBy","target":"source:cedar-lang-oopsla-2024"},{"predicate":"supportedBy","target":"source:cedar-vgd-fse-2024"}],"verification":[]},
    {"@id":"tool:proptest","@type":["Tool"],"name":"proptest","summary":"Rust property-testing framework for generated Mission Graph, event-history, evidence, and scheduler cases with shrinking of failing examples.","status":"candidate","relations":[{"predicate":"supportedBy","target":"source:proptest"},{"predicate":"implements","target":"foundation:property-testing"}],"verification":[]},
    {"@id":"tool:kani","@type":["Tool"],"name":"Kani","summary":"Rust bit-precise model checker for bounded verification of panics, overflow, unsafe behavior, and selected correctness harnesses.","status":"candidate","relations":[{"predicate":"supportedBy","target":"source:kani"},{"predicate":"implements","target":"foundation:model-checking"},{"predicate":"testedBy","target":"experiment:verification-stack"}],"verification":[]},
