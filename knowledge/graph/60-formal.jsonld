  "@graph": [
    {"@id":"assumption:rank-decreases","@type":["Assumption"],"name":"Dependency edges strictly decrease a natural rank","summary":"Certificate premise for the current Lean acyclicity theorem. Runtime must produce/check a rank satisfying this premise; the theorem does not prove arbitrary input graphs already have one.","status":"assumed","relations":[{"predicate":"requiredBy","target":"theorem:no-ranked-dependency-cycle"}],"verification":[],"statement":"Every hard dependency edge in an admitted Mission Graph strictly decreases a natural-number rank assigned by the runtime."},
    {"@id":"assumption:declared-resource-completeness","@type":["Assumption"],"name":"Declared semantic resources approximate real accesses","summary":"Semantic concurrency admission relies on declarations being useful approximations. The formal non-interference predicate cannot prove declarations capture every real dependency.","status":"assumed","relations":[{"predicate":"requiredBy","target":"algorithm:semantic-conflict-admission"},{"predicate":"testedBy","target":"experiment:semantic-conflict-prediction"}],"verification":[],"statement":"The semantic resources an Atom declares include every semantic resource its execution actually reads or writes."},
    {"@id":"assumption:fingerprint-completeness","@type":["Assumption"],"name":"Evidence fingerprint includes every relevant identity","summary":"Mismatch theorems prove equality requirements once fields are chosen; engineering correctness also requires the fingerprint dependency boundary not omit a relevant input/environment/verifier dependency.","status":"assumed","relations":[{"predicate":"requiredBy","target":"algorithm:evidence-compatibility"},{"predicate":"testedBy","target":"experiment:evidence-mutation"}],"verification":[],"statement":"The seven fingerprint components bind every input whose change could alter a verifier's verdict on a candidate."},
    {"@id":"assumption:pure-projector","@type":["Assumption"],"name":"Event projector is a pure deterministic function of recorded history","summary":"Replay theorem assumes a fixed functional projector; implementation must keep clocks, network reads, LLM calls, and external side effects outside replay semantics.","status":"assumed","relations":[{"predicate":"requiredBy","target":"theorem:replay-equal-history"},{"predicate":"testedBy","target":"experiment:replay-faults"}],"verification":[],"statement":"The event projector is a total pure function of the recorded event history alone: it reads no clock, no network, and no model output."},
    {"@id":"assumption:role-enforcement","@type":["Assumption"],"name":"Runtime credentials refine abstract role/capability policy","summary":"Lean can show Worker lacks promotion capability in the model; real security additionally requires secret isolation, OS/process policy, remote permissions, and token enforcement.","status":"assumed","relations":[{"predicate":"requiredBy","target":"claim:harness-reliability"},{"predicate":"testedBy","target":"experiment:authorization-engine"}],"verification":[],"statement":"The runtime credentials issued to an actor grant no authority beyond the capability its abstract role holds in the Lean policy model."},
    {"@id":"theorem:no-ranked-dependency-cycle","@type":["Theorem"],"name":"Rank-decreasing hard dependency graphs contain no directed cycle","summary":"If every hard dependency edge strictly decreases a natural-number rank, no node can depend transitively on itself.","status":"proof-source-present","statement":"DependsPath g a a -> False, assuming each dependency edge strictly decreases rank.","relations":[{"predicate":"requires","target":"assumption:rank-decreases"},{"predicate":"formalizes","target":"foundation:dag"},{"predicate":"formalizes","target":"concept:mission-graph"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Graph.lean#no_dependency_cycle","status":"ci-check-required","note":"Machine-checked status requires the exact repository CI proof job to pass without admitted axioms."}],"content":"mechanism","class":"substantive"},
    {"@id":"theorem:quark-not-global-target","@type":["Theorem"],"name":"Quarks are excluded from globally dependable work kinds","summary":"The current formal kind predicate does not permit Quark as a global dependency target.","status":"proof-source-present","statement":"not GloballyDependable WorkKind.quark.","relations":[{"predicate":"formalizes","target":"concept:quark"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Graph.lean#quark_not_globally_dependable","status":"ci-check-required","note":"Proves policy encoding, not empirical optimality of the Atom/Quark boundary."}],"content":"definitional","class":"structural"},
    {"@id":"theorem:dispatch-requires-enabled","@type":["Theorem"],"name":"Dispatchability implies enabled state","summary":"A DispatchWitness structurally contains an EnabledWitness.","status":"proof-source-present","statement":"Dispatchable f -> Enabled f.","relations":[{"predicate":"formalizes","target":"algorithm:greedy-list-scheduler"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Scheduler.lean#dispatchable_implies_enabled","status":"ci-check-required"}],"content":"projection","class":"regression-guard"},
    {"@id":"theorem:dispatch-requires-dependencies","@type":["Theorem"],"name":"Dispatchability implies dependency satisfaction","summary":"A formal dispatch witness necessarily contains a dependency-satisfaction witness.","status":"proof-source-present","statement":"Dispatchable f -> f.dependenciesSatisfied.","relations":[{"predicate":"formalizes","target":"concept:atom"},{"predicate":"formalizes","target":"algorithm:greedy-list-scheduler"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Scheduler.lean#dispatchable_implies_dependencies_satisfied","status":"ci-check-required"}],"content":"projection","class":"regression-guard"},
    {"@id":"theorem:dispatch-requires-preconditions","@type":["Theorem"],"name":"Dispatchability implies preconditions hold","summary":"A formal dispatch witness necessarily contains its precondition witness.","status":"proof-source-present","statement":"Dispatchable f -> f.preconditionsHold.","relations":[{"predicate":"formalizes","target":"concept:atom"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Scheduler.lean#dispatchable_implies_preconditions","status":"ci-check-required"}],"content":"projection","class":"regression-guard"},
    {"@id":"theorem:dispatch-requires-authorization","@type":["Theorem"],"name":"Dispatchability implies authorization validity","summary":"A formal dispatch witness necessarily contains authorization validity.","status":"proof-source-present","statement":"Dispatchable f -> f.authorizationValid.","relations":[{"predicate":"formalizes","target":"concept:authority-model"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Scheduler.lean#dispatchable_implies_authorization","status":"ci-check-required"}],"content":"projection","class":"regression-guard"},
    {"@id":"theorem:evidence-commit-mismatch","@type":["Theorem"],"name":"Exact state mismatch invalidates evidence compatibility","summary":"Evidence whose exact state identity differs from the current candidate's cannot produce the formal compatibility witness.","status":"proof-source-present","statement":"e.exactStateId != c.exactStateId -> not Compatible e c.","relations":[{"predicate":"requires","target":"assumption:fingerprint-completeness"},{"predicate":"formalizes","target":"algorithm:evidence-compatibility"},{"predicate":"formalizes","target":"claim:exact-artifact-verification"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Evidence.lean#exact_state_mismatch_invalidates","status":"ci-check-required"}],"content":"projection","class":"regression-guard"},
    {"@id":"theorem:evidence-spec-mismatch","@type":["Theorem"],"name":"Specification mismatch invalidates evidence compatibility","summary":"Evidence for a different immutable specification revision cannot produce the formal compatibility witness.","status":"proof-source-present","statement":"e.specRevision != c.specRevision -> not Compatible e c.","relations":[{"predicate":"requires","target":"assumption:fingerprint-completeness"},{"predicate":"formalizes","target":"algorithm:evidence-compatibility"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Evidence.lean#spec_mismatch_invalidates","status":"ci-check-required"}],"content":"projection","class":"regression-guard"},
    {"@id":"theorem:evidence-input-mismatch","@type":["Theorem"],"name":"Input mismatch invalidates evidence compatibility","summary":"Evidence with a different bound input digest cannot produce the formal compatibility witness.","status":"proof-source-present","statement":"e.inputDigest != c.inputDigest -> not Compatible e c.","relations":[{"predicate":"requires","target":"assumption:fingerprint-completeness"},{"predicate":"formalizes","target":"algorithm:evidence-compatibility"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Evidence.lean#input_mismatch_invalidates","status":"ci-check-required"}],"content":"projection","class":"regression-guard"},
    {"@id":"theorem:evidence-environment-mismatch","@type":["Theorem"],"name":"Environment mismatch invalidates evidence compatibility","summary":"Evidence with a different relevant environment digest cannot produce the formal compatibility witness.","status":"proof-source-present","statement":"e.environmentDigest != c.environmentDigest -> not Compatible e c.","relations":[{"predicate":"requires","target":"assumption:fingerprint-completeness"},{"predicate":"formalizes","target":"algorithm:evidence-compatibility"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Evidence.lean#environment_mismatch_invalidates","status":"ci-check-required"}],"content":"projection","class":"regression-guard"},
    {"@id":"theorem:evidence-verifier-mismatch","@type":["Theorem"],"name":"Verifier mismatch invalidates evidence compatibility","summary":"Evidence produced by a different verifier definition cannot produce the formal compatibility witness.","status":"proof-source-present","statement":"e.verifierDigest != c.verifierDigest -> not Compatible e c.","relations":[{"predicate":"requires","target":"assumption:fingerprint-completeness"},{"predicate":"formalizes","target":"algorithm:evidence-compatibility"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Evidence.lean#verifier_mismatch_invalidates","status":"ci-check-required"}],"content":"projection","class":"regression-guard"},
    {"@id":"theorem:worker-cannot-promote","@type":["Theorem"],"name":"Worker role cannot promote the accepted frontier","summary":"The abstract role policy grants accepted-source promotion only to Coordinator, not Worker.","status":"proof-source-present","statement":"not CanPromoteAccepted Role.worker.","relations":[{"predicate":"requires","target":"assumption:role-enforcement"},{"predicate":"formalizes","target":"concept:authority-model"},{"predicate":"formalizes","target":"concept:accepted-frontier"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Authority.lean#worker_cannot_promote","status":"ci-check-required"}],"content":"definitional","class":"structural"},
    {"@id":"theorem:coordinator-cannot-deploy","@type":["Theorem"],"name":"Coordinator does not receive deployment authority by default","summary":"The abstract role policy keeps deployment authority separate from accepted-frontier promotion.","status":"proof-source-present","statement":"not CanDeploy Role.coordinator.","relations":[{"predicate":"requires","target":"assumption:role-enforcement"},{"predicate":"formalizes","target":"concept:deployment-frontier"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Authority.lean#coordinator_cannot_deploy_by_default","status":"ci-check-required"}],"content":"definitional","class":"structural"},
    {"@id":"theorem:accepted-conflict-free","@type":["Theorem"],"name":"Accepted candidates carry conflict-free evidence","summary":"The formal AcceptanceWitness contains a conflict-free premise along with reconciliation, verification, freshness, and authorization.","status":"proof-source-present","statement":"Acceptable f -> f.conflictFree.","relations":[{"predicate":"formalizes","target":"algorithm:candidate-admission"},{"predicate":"formalizes","target":"concept:accepted-frontier"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Acceptance.lean#accepted_implies_conflict_free","status":"ci-check-required","note":"Only proves the abstract conflict predicate required by the witness; semantic conflict detection completeness is external."}],"content":"projection","class":"regression-guard"},
    {"@id":"theorem:accepted-verified","@type":["Theorem"],"name":"Accepted candidates carry required verification evidence","summary":"The formal AcceptanceWitness contains a required-verification premise.","status":"proof-source-present","statement":"Acceptable f -> f.requiredVerificationPasses.","relations":[{"predicate":"formalizes","target":"algorithm:candidate-admission"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Acceptance.lean#accepted_implies_verified","status":"ci-check-required"}],"content":"projection","class":"regression-guard"},
    {"@id":"theorem:accepted-fresh","@type":["Theorem"],"name":"Accepted candidates carry fresh-evidence premise","summary":"The formal AcceptanceWitness contains evidence freshness.","status":"proof-source-present","statement":"Acceptable f -> f.evidenceFresh.","relations":[{"predicate":"formalizes","target":"algorithm:candidate-admission"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Acceptance.lean#accepted_implies_fresh_evidence","status":"ci-check-required"}],"content":"projection","class":"regression-guard"},
    {"@id":"theorem:declared-noninterference-symmetric","@type":["Theorem"],"name":"Declared non-interference predicate is symmetric","summary":"The selected declared read/write disjointness predicate yields the same Boolean/logical result under reversed candidate order.","status":"proof-source-present","statement":"DeclaredNonInterfering a b -> DeclaredNonInterfering b a.","relations":[{"predicate":"requires","target":"assumption:declared-resource-completeness"},{"predicate":"formalizes","target":"algorithm:semantic-conflict-admission"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Conflict.lean#declared_noninterference_symmetric","status":"ci-check-required","note":"Does not prove real semantic independence."}],"content":"mechanism","class":"substantive"},
    {"@id":"theorem:replay-equal-history","@type":["Theorem"],"name":"Equal event history yields equal projection under a fixed pure projector","summary":"The current replay theorem intentionally isolates the true engineering obligation: purity/determinism and complete history capture.","status":"proof-source-present","statement":"a = b -> replay project a = replay project b.","relations":[{"predicate":"requires","target":"assumption:pure-projector"},{"predicate":"formalizes","target":"algorithm:event-projection"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Replay.lean#replay_same_history","status":"ci-check-required"}],"content":"definitional","class":"structural"},
    {"@id":"theorem:transition-invariant-preservation","@type":["Theorem"],"name":"Legal Mission execution transitions preserve global safety invariants","summary":"Planned umbrella theorem family over a formal state/event transition relation.","status":"planned","statement":"Invariant s and ValidTransition s e s' -> Invariant s'.","relations":[{"predicate":"formalizes","target":"concept:execution-history"},{"predicate":"testedBy","target":"experiment:lean-rust-conformance"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Transition.lean","status":"planned"}],"content":"mechanism","class":"substantive"},
    {"@id":"theorem:satisfied-requires-admission","@type":["Theorem"],"name":"Satisfaction requires an admitted integration candidate","summary":"An Atom is Satisfied only when the evidence counted for it belongs to an IntegrationCandidate reachable in the accepted frontier's transitive parents.","status":"proof-source-present","statement":"Satisfied F a -> exists i, i in transitiveParents F.integrationCandidate and subjectOf (evidenceFor a) = i.","content":"mechanism","class":"substantive","relations":[{"predicate":"formalizes","target":"concept:accepted-frontier"},{"predicate":"formalizes","target":"algorithm:candidate-admission"},{"predicate":"formalizes","target":"concept:atom"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Frontier.lean#satisfied_requires_admission","status":"ci-check-required"}]},
    {"@id":"theorem:required-verifier-missing","@type":["Theorem"],"name":"A missing required verifier defeats satisfaction","summary":"If the verifier manifest requires a verifier for which no compatible passing evidence exists, the Atom is not Satisfied.","status":"proof-source-present","statement":"(exists v, v in requiredVerifiers a and no compatible passing evidence for v) -> not Satisfied F a.","content":"mechanism","class":"substantive","relations":[{"predicate":"formalizes","target":"concept:verifier-manifest"},{"predicate":"formalizes","target":"concept:acceptance-predicate"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Frontier.lean#not_satisfied_when_required_verifier_missing","status":"ci-check-required"}]},
    {"@id":"theorem:integration-needs-own-evidence","@type":["Theorem"],"name":"An integration candidate needs evidence of its own","summary":"Component candidates passing independently does not produce an acceptance witness for the integration candidate composing them.","status":"proof-source-present","statement":"(forall c in I.parents, Acceptable c) -> not necessarily Acceptable I; Acceptable I requires evidence whose subject is I.","content":"mechanism","class":"substantive","relations":[{"predicate":"formalizes","target":"concept:integration-candidate"},{"predicate":"formalizes","target":"algorithm:candidate-admission"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Frontier.lean#integration_needs_own_evidence","status":"ci-check-required","note":"This is the formal counterpart of experiment:integration-composition; it states non-compositionality as an obligation, not as an empirical rate."}]},
    {"@id":"theorem:lease-exclusion","@type":["Theorem"],"name":"No two live exclusive leases share a subject","summary":"Over LeaseSubject rather than over an informal semantic resource, two distinct live exclusive leases on the same subject cannot coexist under legal transitions.","status":"proof-source-present","statement":"ValidState s -> not exists l1 l2, l1 != l2 and Live s l1 and Live s l2 and l1.exclusive and l2.exclusive and l1.subject = l2.subject.","content":"mechanism","class":"substantive","relations":[{"predicate":"formalizes","target":"algorithm:lease-arbitration"},{"predicate":"formalizes","target":"concept:lease"},{"predicate":"testedBy","target":"experiment:lease-faults"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Lease.lean#no_two_live_exclusive","status":"ci-check-required","note":"Supersedes the earlier planned lease node, whose statement ranged over a semantic resource and therefore had no counterpart for the one-writer-per-evolving-change invariant."}]},
    {"@id":"theorem:logical-change-never-shared-write","@type":["Theorem"],"name":"A logical change never has two concurrent writers on the normal path","summary":"The LeaseSubject::LogicalChange constructor makes the one-writer-per-evolving-change invariant a corollary of lease exclusion.","status":"proof-source-present","statement":"ValidState s -> not exists l1 l2, l1 != l2 and Live s l1 and Live s l2 and l1.subject = LeaseSubject.logicalChange k and l2.subject = LeaseSubject.logicalChange k.","content":"mechanism","class":"substantive","relations":[{"predicate":"formalizes","target":"concept:lease"},{"predicate":"formalizes","target":"concept:change-graph"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Lease.lean#logical_change_never_shared_write","status":"ci-check-required"}]},
    {"@id":"theorem:superseded-holder-rejected","@type":["Theorem"],"name":"A superseded lease holder cannot regain authority","summary":"An operation carrying a fencing token below the subject's current token is rejected, so a stale holder resuming after a pause cannot write.","status":"proof-source-present","statement":"l.fencingToken < currentToken s l.subject -> not Authorized s l op.","content":"mechanism","class":"substantive","relations":[{"predicate":"formalizes","target":"foundation:fencing-tokens"},{"predicate":"formalizes","target":"algorithm:lease-arbitration"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Lease.lean#superseded_holder_rejected","status":"ci-check-required"}]},
    {"@id":"theorem:retry-policy-total","@type":["Theorem"],"name":"The retry policy is total over effect classes","summary":"retryPolicy is defined by exhaustive case analysis with no wildcard branch, so adding an EffectClass constructor is a compile error rather than a silent default.","status":"proof-source-present","statement":"forall e : EffectClass, retryPolicy e is defined by an exhaustive match.","content":"definitional","class":"structural","relations":[{"predicate":"formalizes","target":"concept:effect-class"},{"predicate":"formalizes","target":"algorithm:reconciliation"}],"verification":[{"method":"Lean4","target":"formal/Gordian/EffectClass.lean#retryPolicy","status":"ci-check-required"}]},
    {"@id":"theorem:irreversible-never-auto-retried","@type":["Theorem"],"name":"Irreversible effects are never automatically retried","summary":"The retry policy assigns the irreversible class a non-automatic disposition.","status":"proof-source-present","statement":"retryPolicy EffectClass.irreversible != RetryDisposition.automatic.","content":"definitional","class":"structural","relations":[{"predicate":"formalizes","target":"concept:effect-class"}],"verification":[{"method":"Lean4","target":"formal/Gordian/EffectClass.lean#irreversible_never_auto_retried","status":"ci-check-required"}]},
    {"@id":"theorem:judgment-never-overwrites","@type":["Theorem"],"name":"A judgment effect never overwrites a recorded judgment","summary":"Re-running a judgment-class activity records a new observation rather than replacing the recorded one.","status":"proof-source-present","statement":"retryPolicy EffectClass.judgment = RetryDisposition.recordNew.","content":"definitional","class":"structural","relations":[{"predicate":"formalizes","target":"concept:effect-class"},{"predicate":"formalizes","target":"concept:event"}],"verification":[{"method":"Lean4","target":"formal/Gordian/EffectClass.lean#judgment_never_overwrites","status":"ci-check-required"}]},
    {"@id":"theorem:globally-dependable-iff-atom","@type":["Theorem"],"name":"Atoms are exactly the globally dependable work kinds","summary":"Strengthens the one-directional quark exclusion into an iff over the WorkKind enumeration, so a new kind cannot silently become a global dependency target.","status":"proof-source-present","statement":"GloballyDependable k <-> k = WorkKind.atom.","content":"definitional","class":"structural","relations":[{"predicate":"formalizes","target":"concept:atom"},{"predicate":"formalizes","target":"concept:quark"},{"predicate":"formalizes","target":"concept:mission-graph"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Graph.lean#globally_dependable_iff_atom","status":"ci-check-required"}]},
    {"@id":"theorem:dependency-mismatch-invalidates","@type":["Theorem"],"name":"Transitive dependency mismatch invalidates evidence compatibility","summary":"Evidence bound to a different transitive dependency digest cannot produce the formal compatibility witness.","status":"proof-source-present","statement":"e.dependencyDigest != c.dependencyDigest -> not Compatible e c.","content":"projection","class":"regression-guard","relations":[{"predicate":"requires","target":"assumption:fingerprint-completeness"},{"predicate":"formalizes","target":"algorithm:evidence-compatibility"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Evidence.lean#dependency_mismatch_invalidates","status":"ci-check-required"}]},
    {"@id":"theorem:canonicalization-mismatch-invalidates","@type":["Theorem"],"name":"Canonicalization scheme mismatch invalidates evidence compatibility","summary":"Evidence produced under a different canonicalization scheme cannot produce the formal compatibility witness; this is the sixth binding component invariants.md requires and the one the previous five-field record omitted.","status":"proof-source-present","statement":"e.canonicalizationScheme != c.canonicalizationScheme -> not Compatible e c.","content":"projection","class":"regression-guard","relations":[{"predicate":"requires","target":"assumption:fingerprint-completeness"},{"predicate":"formalizes","target":"algorithm:evidence-compatibility"},{"predicate":"formalizes","target":"claim:exact-artifact-verification"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Evidence.lean#canonicalization_mismatch_invalidates","status":"ci-check-required"}]},
    {"@id":"assumption:compositional-verifier-inheritance","@type":["Assumption"],"name":"A compositional verifier inherits its verdict onto an integration candidate","summary":"Batch admission avoids re-running every verifier by trusting the VerifierManifestEntry.compositional flag. Nothing proves an author's claim that a verifier is compositional; this assumption is what the flag asserts, and experiment:compositional-verifier-inheritance measures how often it is false.","status":"assumed","statement":"A verifier declared compositional yields the same verdict on an integration candidate containing the component it passed on.","relations":[{"predicate":"requiredBy","target":"algorithm:candidate-admission"},{"predicate":"testedBy","target":"experiment:compositional-verifier-inheritance"},{"predicate":"requiredBy","target":"concept:verifier-manifest"}],"verification":[]},
    {"@id":"theorem:fresh-pass-has-record","@type":["Theorem"],"name":"A fresh passing verdict has a recorded evidence entry","summary":"The Verified rule counts only verdicts that exist as records in the evidence store bound to the named subject, so 'the verifier passed' cannot be asserted without a retrievable record naming the subject it passed on.","status":"proof-source-present","statement":"freshPass S v s = true -> exists e, e in S.records and e.verifier = v and e.subject = s and e.verdict = Verdict.pass.","content":"mechanism","class":"substantive","relations":[{"predicate":"formalizes","target":"algorithm:evidence-compatibility"},{"predicate":"formalizes","target":"concept:evidence"},{"predicate":"requires","target":"assumption:fingerprint-completeness"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Frontier.lean#freshPass_has_record","status":"ci-check-required"}]}
  ]
}
