{
  "@graph": [
    {"@id":"assumption:rank-decreases","@type":["Assumption"],"name":"Dependency edges strictly decrease a natural rank","summary":"Certificate premise for the current Lean acyclicity theorem. Runtime must produce/check a rank satisfying this premise; the theorem does not prove arbitrary input graphs already have one.","status":"explicit-proof-assumption","relations":[{"predicate":"requiredBy","target":"theorem:no-ranked-dependency-cycle"}],"verification":[]},
    {"@id":"assumption:declared-resource-completeness","@type":["Assumption"],"name":"Declared semantic resources approximate real accesses","summary":"Semantic concurrency admission relies on declarations being useful approximations. The formal non-interference predicate cannot prove declarations capture every real dependency.","status":"empirical-assumption","relations":[{"predicate":"requiredBy","target":"algorithm:semantic-conflict-admission"},{"predicate":"testedBy","target":"experiment:semantic-conflict-prediction"}],"verification":[]},
    {"@id":"assumption:fingerprint-completeness","@type":["Assumption"],"name":"Evidence fingerprint includes every relevant identity","summary":"Mismatch theorems prove equality requirements once fields are chosen; engineering correctness also requires the fingerprint dependency boundary not omit a relevant input/environment/verifier dependency.","status":"engineering-assumption","relations":[{"predicate":"requiredBy","target":"algorithm:evidence-compatibility"},{"predicate":"testedBy","target":"experiment:evidence-mutation"}],"verification":[]},
    {"@id":"assumption:pure-projector","@type":["Assumption"],"name":"Event projector is a pure deterministic function of recorded history","summary":"Replay theorem assumes a fixed functional projector; implementation must keep clocks, network reads, LLM calls, and external side effects outside replay semantics.","status":"architecture-assumption","relations":[{"predicate":"requiredBy","target":"theorem:replay-equal-history"},{"predicate":"testedBy","target":"experiment:replay-faults"}],"verification":[]},
    {"@id":"assumption:role-enforcement","@type":["Assumption"],"name":"Runtime credentials refine abstract role/capability policy","summary":"Lean can show Worker lacks promotion capability in the model; real security additionally requires secret isolation, OS/process policy, remote permissions, and token enforcement.","status":"implementation-assumption","relations":[{"predicate":"requiredBy","target":"claim:harness-reliability"},{"predicate":"testedBy","target":"experiment:authorization-engine"}],"verification":[]},
    {"@id":"theorem:no-ranked-dependency-cycle","@type":["Theorem"],"name":"Rank-decreasing hard dependency graphs contain no directed cycle","summary":"If every hard dependency edge strictly decreases a natural-number rank, no node can depend transitively on itself.","status":"proof-source-present","statement":"DependsPath g a a -> False, assuming each dependency edge strictly decreases rank.","relations":[{"predicate":"requires","target":"assumption:rank-decreases"},{"predicate":"formalizes","target":"foundation:dag"},{"predicate":"formalizes","target":"concept:mission-graph"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Graph.lean#no_dependency_cycle","status":"ci-check-required","note":"Machine-checked status requires the exact repository CI proof job to pass without admitted axioms."}]},
    {"@id":"theorem:quark-not-global-target","@type":["Theorem"],"name":"Quarks are excluded from globally dependable work kinds","summary":"The current formal kind predicate does not permit Quark as a global dependency target.","status":"proof-source-present","statement":"not GloballyDependable WorkKind.quark.","relations":[{"predicate":"formalizes","target":"concept:quark"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Graph.lean#quark_not_globally_dependable","status":"ci-check-required","note":"Proves policy encoding, not empirical optimality of the Atom/Quark boundary."}]},
    {"@id":"theorem:dispatch-requires-enabled","@type":["Theorem"],"name":"Dispatchability implies enabled state","summary":"A DispatchWitness structurally contains an EnabledWitness.","status":"proof-source-present","statement":"Dispatchable f -> Enabled f.","relations":[{"predicate":"formalizes","target":"algorithm:greedy-list-scheduler"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Scheduler.lean#dispatchable_implies_enabled","status":"ci-check-required"}]},
    {"@id":"theorem:dispatch-requires-dependencies","@type":["Theorem"],"name":"Dispatchability implies dependency satisfaction","summary":"A formal dispatch witness necessarily contains a dependency-satisfaction witness.","status":"proof-source-present","statement":"Dispatchable f -> f.dependenciesSatisfied.","relations":[{"predicate":"formalizes","target":"concept:atom"},{"predicate":"formalizes","target":"algorithm:greedy-list-scheduler"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Scheduler.lean#dispatchable_implies_dependencies_satisfied","status":"ci-check-required"}]},
    {"@id":"theorem:dispatch-requires-preconditions","@type":["Theorem"],"name":"Dispatchability implies preconditions hold","summary":"A formal dispatch witness necessarily contains its precondition witness.","status":"proof-source-present","statement":"Dispatchable f -> f.preconditionsHold.","relations":[{"predicate":"formalizes","target":"concept:atom"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Scheduler.lean#dispatchable_implies_preconditions","status":"ci-check-required"}]},
    {"@id":"theorem:dispatch-requires-authorization","@type":["Theorem"],"name":"Dispatchability implies authorization validity","summary":"A formal dispatch witness necessarily contains authorization validity.","status":"proof-source-present","statement":"Dispatchable f -> f.authorizationValid.","relations":[{"predicate":"formalizes","target":"concept:authority-model"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Scheduler.lean#dispatchable_implies_authorization","status":"ci-check-required"}]},
    {"@id":"theorem:evidence-commit-mismatch","@type":["Theorem"],"name":"Candidate commit mismatch invalidates evidence compatibility","summary":"Evidence whose exact commit identity differs from the current candidate cannot produce the formal compatibility witness.","status":"proof-source-present","statement":"e.commitId != c.commitId -> not Compatible e c.","relations":[{"predicate":"requires","target":"assumption:fingerprint-completeness"},{"predicate":"formalizes","target":"algorithm:evidence-compatibility"},{"predicate":"formalizes","target":"claim:exact-artifact-verification"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Evidence.lean#commit_mismatch_invalidates","status":"ci-check-required"}]},
    {"@id":"theorem:evidence-spec-mismatch","@type":["Theorem"],"name":"Specification mismatch invalidates evidence compatibility","summary":"Evidence for a different immutable specification revision cannot produce the formal compatibility witness.","status":"proof-source-present","statement":"e.specRevision != c.specRevision -> not Compatible e c.","relations":[{"predicate":"requires","target":"assumption:fingerprint-completeness"},{"predicate":"formalizes","target":"algorithm:evidence-compatibility"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Evidence.lean#spec_mismatch_invalidates","status":"ci-check-required"}]},
    {"@id":"theorem:evidence-input-mismatch","@type":["Theorem"],"name":"Input mismatch invalidates evidence compatibility","summary":"Evidence with a different bound input digest cannot produce the formal compatibility witness.","status":"proof-source-present","statement":"e.inputDigest != c.inputDigest -> not Compatible e c.","relations":[{"predicate":"requires","target":"assumption:fingerprint-completeness"},{"predicate":"formalizes","target":"algorithm:evidence-compatibility"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Evidence.lean#input_mismatch_invalidates","status":"ci-check-required"}]},
    {"@id":"theorem:evidence-environment-mismatch","@type":["Theorem"],"name":"Environment mismatch invalidates evidence compatibility","summary":"Evidence with a different relevant environment digest cannot produce the formal compatibility witness.","status":"proof-source-present","statement":"e.environmentDigest != c.environmentDigest -> not Compatible e c.","relations":[{"predicate":"requires","target":"assumption:fingerprint-completeness"},{"predicate":"formalizes","target":"algorithm:evidence-compatibility"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Evidence.lean#environment_mismatch_invalidates","status":"ci-check-required"}]},
    {"@id":"theorem:evidence-verifier-mismatch","@type":["Theorem"],"name":"Verifier mismatch invalidates evidence compatibility","summary":"Evidence produced by a different verifier definition cannot produce the formal compatibility witness.","status":"proof-source-present","statement":"e.verifierDigest != c.verifierDigest -> not Compatible e c.","relations":[{"predicate":"requires","target":"assumption:fingerprint-completeness"},{"predicate":"formalizes","target":"algorithm:evidence-compatibility"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Evidence.lean#verifier_mismatch_invalidates","status":"ci-check-required"}]},
    {"@id":"theorem:worker-cannot-promote","@type":["Theorem"],"name":"Worker role cannot promote the accepted frontier","summary":"The abstract role policy grants accepted-source promotion only to Coordinator, not Worker.","status":"proof-source-present","statement":"not CanPromoteAccepted Role.worker.","relations":[{"predicate":"requires","target":"assumption:role-enforcement"},{"predicate":"formalizes","target":"concept:authority-model"},{"predicate":"formalizes","target":"concept:accepted-frontier"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Authority.lean#worker_cannot_promote","status":"ci-check-required"}]},
    {"@id":"theorem:coordinator-cannot-deploy","@type":["Theorem"],"name":"Coordinator does not receive deployment authority by default","summary":"The abstract role policy keeps deployment authority separate from accepted-frontier promotion.","status":"proof-source-present","statement":"not CanDeploy Role.coordinator.","relations":[{"predicate":"requires","target":"assumption:role-enforcement"},{"predicate":"formalizes","target":"concept:deployment-frontier"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Authority.lean#coordinator_cannot_deploy_by_default","status":"ci-check-required"}]},
    {"@id":"theorem:accepted-conflict-free","@type":["Theorem"],"name":"Accepted candidates carry conflict-free evidence","summary":"The formal AcceptanceWitness contains a conflict-free premise along with reconciliation, verification, freshness, and authorization.","status":"proof-source-present","statement":"Acceptable f -> f.conflictFree.","relations":[{"predicate":"formalizes","target":"algorithm:candidate-admission"},{"predicate":"formalizes","target":"concept:accepted-frontier"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Acceptance.lean#accepted_implies_conflict_free","status":"ci-check-required","note":"Only proves the abstract conflict predicate required by the witness; semantic conflict detection completeness is external."}]},
    {"@id":"theorem:accepted-verified","@type":["Theorem"],"name":"Accepted candidates carry required verification evidence","summary":"The formal AcceptanceWitness contains a required-verification premise.","status":"proof-source-present","statement":"Acceptable f -> f.requiredVerificationPasses.","relations":[{"predicate":"formalizes","target":"algorithm:candidate-admission"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Acceptance.lean#accepted_implies_verified","status":"ci-check-required"}]},
    {"@id":"theorem:accepted-fresh","@type":["Theorem"],"name":"Accepted candidates carry fresh-evidence premise","summary":"The formal AcceptanceWitness contains evidence freshness.","status":"proof-source-present","statement":"Acceptable f -> f.evidenceFresh.","relations":[{"predicate":"formalizes","target":"algorithm:candidate-admission"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Acceptance.lean#accepted_implies_fresh_evidence","status":"ci-check-required"}]},
    {"@id":"theorem:declared-noninterference-symmetric","@type":["Theorem"],"name":"Declared non-interference predicate is symmetric","summary":"The selected declared read/write disjointness predicate yields the same Boolean/logical result under reversed candidate order.","status":"proof-source-present","statement":"DeclaredNonInterfering a b -> DeclaredNonInterfering b a.","relations":[{"predicate":"requires","target":"assumption:declared-resource-completeness"},{"predicate":"formalizes","target":"algorithm:semantic-conflict-admission"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Conflict.lean#declared_noninterference_symmetric","status":"ci-check-required","note":"Does not prove real semantic independence."}]},
    {"@id":"theorem:replay-equal-history","@type":["Theorem"],"name":"Equal event history yields equal projection under a fixed pure projector","summary":"The current replay theorem intentionally isolates the true engineering obligation: purity/determinism and complete history capture.","status":"proof-source-present","statement":"a = b -> replay project a = replay project b.","relations":[{"predicate":"requires","target":"assumption:pure-projector"},{"predicate":"formalizes","target":"algorithm:event-projection"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Replay.lean#replay_same_history","status":"ci-check-required"}]},
    {"@id":"theorem:lease-exclusion-planned","@type":["Theorem"],"name":"Exclusive lease overlap is impossible under legal transitions","summary":"Planned transition theorem: two valid exclusive write leases for the same semantic resource cannot coexist and stale fencing identities cannot regain authority.","status":"planned","statement":"ValidState s -> not exists l1 l2, Distinct l1 l2 and LiveExclusiveSameResource l1 l2.","relations":[{"predicate":"formalizes","target":"algorithm:lease-arbitration"},{"predicate":"testedBy","target":"experiment:lease-faults"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Lease.lean","status":"planned"}]},
    {"@id":"theorem:transition-invariant-preservation","@type":["Theorem"],"name":"Legal Mission execution transitions preserve global safety invariants","summary":"Planned umbrella theorem family over a formal state/event transition relation.","status":"planned","statement":"Invariant s and ValidTransition s e s' -> Invariant s'.","relations":[{"predicate":"formalizes","target":"concept:execution-history"},{"predicate":"testedBy","target":"experiment:lean-rust-conformance"}],"verification":[{"method":"Lean4","target":"formal/Gordian/Transition.lean","status":"planned"}]}
  ]
}
