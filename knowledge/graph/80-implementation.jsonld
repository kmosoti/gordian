    {"@id":"artifact:workload-corpus","@type":["ImplementationArtifact"],"name":"Gordian Seeded Workload Corpus","summary":"Checked-in golden and fixture layout for the four named workload distributions and fixed seed matrix; corpus identity is bound to the generator, format, and source manifest.","status":"implemented","url":"experiments/workloads/README.md","relations":[{"predicate":"uses","target":"artifact:workload-format"},{"predicate":"usedBy","target":"artifact:workload-generator"},{"predicate":"usedBy","target":"experiment:foundation-benchmarks"},{"predicate":"usedBy","target":"experiment:scheduler-benchmarks"}],"verification":[{"method":"Workload corpus and format checker","target":"scripts/check-workloads.sh","status":"passing","note":"Validates every golden/fixture record and the fixed seed matrix; it records no benchmark result."}]},
