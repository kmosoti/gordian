    {"@id":"artifact:gordian-kg","@type":["ImplementationArtifact"],"name":"gordian-kg Rust crate","summary":"Rust research-graph loader, validator, epistemic auditor, petgraph index, traversal engine, statistics/query CLI, and DOT exporter.","status":"implemented","url":"crates/gordian-kg","relations":[{"predicate":"implements","target":"algorithm:knowledge-index"},{"predicate":"uses","target":"tool:petgraph"},{"predicate":"benchmarkedBy","target":"experiment:knowledge-graph-benchmarks"}],"verification":[{"method":"Rust unit/CI tests","target":"crates/gordian-kg","status":"passing"}]},
    {"@id":"artifact:formal-kernel","@type":["ImplementationArtifact"],"name":"Gordian Lean Formal Kernel","summary":"Development-only Lean models and theorem sources under formal/ for graph, scheduler, evidence, authority, acceptance, conflict, replay, and future state-transition invariants. Exact-revision CI evidence binds the warning-free build, Lean-kernel environment replay, and allowlisted axiom audit to one repository state.","status":"in-progress","url":"formal/","relations":[{"predicate":"uses","target":"tool:lean4"},{"predicate":"verifiedBy","target":"tool:axiom-audit"},{"predicate":"testedBy","target":"experiment:lean-rust-conformance"},{"predicate":"contrastsWith","target":"tool:nanoda","note":"Candidate independently implemented checker, disabled in CI; the edge is not verifiedBy until verify.yml enables it."}],"verification":[{"method":"Warning-free Lean build + leanchecker environment replay + allowlisted axiom audit","target":"scripts/verify-local.sh","status":"passing"}]},
    {"@id":"artifact:mission-core","@type":["ImplementationArtifact"],"name":"Mission Graph Rust Core","summary":"Planned production Rust domain kernel for identities, immutable specification revisions, decomposition, hard dependencies, readiness, attempts, candidates, capabilities, and evidence semantics. The foundation conformance runner/generator is planned in this package at `crates/gordian-core/tests/conformance.rs` and seeds raw-graph HardDependenciesAcyclic against #4's deterministic reference algorithm.","status":"planned","url":"crates/gordian-core","relations":[{"predicate":"implements","target":"concept:mission-graph"},{"predicate":"implements","target":"concept:execution-attempt"},{"predicate":"implements","target":"algorithm:kahn-toposort"},{"predicate":"testedBy","target":"experiment:foundation-benchmarks"},{"predicate":"testedBy","target":"experiment:lean-rust-conformance"}],"verification":[]},
    {"@id":"artifact:scheduler","@type":["ImplementationArtifact"],"name":"Gordian Scheduler","summary":"Planned Rust scheduler for readiness derivation, resource/capability compatibility, semantic conflict admission, critical-path/list/heterogeneous scheduling policies, and deterministic scheduling decisions.","status":"planned","url":"crates/gordian-scheduler","relations":[{"predicate":"implements","target":"algorithm:greedy-list-scheduler"},{"predicate":"implements","target":"algorithm:critical-path"},{"predicate":"implements","target":"algorithm:semantic-conflict-admission"},{"predicate":"testedBy","target":"experiment:scheduler-benchmarks"}],"verification":[]},
    {"@id":"artifact:evidence-core","@type":["ImplementationArtifact"],"name":"Gordian Evidence and Provenance Core","summary":"Planned Rust implementation of evidence binding, verifier manifests, provenance, attestations, artifact identity, acceptance evaluation, and exact candidate freshness rules.","status":"planned","url":"crates/gordian-evidence","relations":[{"predicate":"implements","target":"algorithm:evidence-compatibility"},{"predicate":"implements","target":"concept:provenance"},{"predicate":"implements","target":"concept:attestation"},{"predicate":"testedBy","target":"experiment:evidence-mutation"}],"verification":[]},
    {"@id":"artifact:persistence-adapter","@type":["ImplementationArtifact"],"name":"Gordian PostgreSQL Persistence","summary":"Planned transactional persistence/event implementation and materialized projection layer, keeping canonical semantics independent of the SQL schema.","status":"planned","url":"crates/gordian-postgres","relations":[{"predicate":"uses","target":"tool:postgresql"},{"predicate":"implements","target":"algorithm:event-projection"},{"predicate":"testedBy","target":"experiment:persistence-benchmarks"}],"verification":[]},
    {"@id":"artifact:source-adapter","@type":["ImplementationArtifact"],"name":"Gordian Source Adapter Trait","summary":"Planned backend-neutral source-control trait: workspace spawn from an exact base, logical_change_id and exact_state_id identity, conflict observation, integration, and revision verification, with no backend named above it. Row `gordian-source` in docs/implementation/crate-map.md; owning Atoms #29 (trait) and #34.","status":"planned","url":"crates/gordian-source","relations":[{"predicate":"provides","target":"concept:change-graph","note":"The trait is the only place a substrate-specific identity crosses into the runtime."},{"predicate":"usedBy","target":"artifact:jj-adapter"},{"predicate":"usedBy","target":"artifact:git-adapter"},{"predicate":"testedBy","target":"experiment:jj-vs-git","note":"#34 varies the substrate behind this trait with everything else held constant."}],"verification":[]},
    {"@id":"artifact:jj-adapter","@type":["ImplementationArtifact"],"name":"Gordian Jujutsu Adapter","summary":"Planned Rust adapter for exact-base workspace spawn, change/candidate identities, conflict observation, integration, jj run verification, tags/releases, and accepted-frontier projection.","status":"planned","url":"crates/gordian-jj","relations":[{"predicate":"uses","target":"tool:jujutsu"},{"predicate":"uses","target":"artifact:source-adapter"},{"predicate":"implements","target":"algorithm:jj-workspace-spawn"},{"predicate":"implements","target":"algorithm:jj-candidate-integration"},{"predicate":"implements","target":"algorithm:jj-revision-verification"},{"predicate":"testedBy","target":"experiment:jj-baseline"},{"predicate":"testedBy","target":"experiment:jj-vs-git"}],"verification":[]},
    {"@id":"artifact:git-adapter","@type":["ImplementationArtifact"],"name":"Gordian Git Adapter","summary":"Planned Git implementation of the source-adapter trait, providing the control substrate for the Jujutsu-versus-Git comparison and the fallback backend for environments without Jujutsu. Row `gordian-git` in docs/implementation/crate-map.md; owning Atom #76.","status":"planned","url":"crates/gordian-git","relations":[{"predicate":"uses","target":"tool:git"},{"predicate":"uses","target":"artifact:source-adapter"},{"predicate":"contrastsWith","target":"artifact:jj-adapter"},{"predicate":"testedBy","target":"experiment:jj-vs-git"}],"verification":[]},
    {"@id":"artifact:coordination-core","@type":["ImplementationArtifact"],"name":"Gordian Coordination Core","summary":"Planned Rust lease/capability/semantic-claim coordination substrate separating worker mutation authority from accepted/deployed frontier authority.","status":"planned","url":"crates/gordian-coordination","relations":[{"predicate":"implements","target":"algorithm:coordination-plane"},{"predicate":"implements","target":"algorithm:lease-arbitration"},{"predicate":"implements","target":"algorithm:frontier-cas"},{"predicate":"testedBy","target":"experiment:lease-faults"},{"predicate":"testedBy","target":"experiment:frontier-races"}],"verification":[]},
    {"@id":"artifact:artifact-store","@type":["ImplementationArtifact"],"name":"Gordian Artifact Store","summary":"Planned content-addressed storage interface and local implementation for logs, reports, benchmark data, verifier output, binaries, and other large immutable evidence payloads.","status":"planned","url":"crates/gordian-artifacts","relations":[{"predicate":"implements","target":"algorithm:content-address-store"},{"predicate":"testedBy","target":"experiment:artifact-store"}],"verification":[]},
    {"@id":"artifact:experiment-runner","@type":["ImplementationArtifact"],"name":"Gordian Experiment Runner","summary":"Planned Rust runner for the experiments/ tree: protocol validation and digesting, run execution and recording, pre-registered analysis, and ingestion of completed runs into Result and Decision nodes. Row `gordian-experiments` in docs/implementation/crate-map.md; owning Atoms #37, #75 and #77.","status":"planned","url":"crates/gordian-experiments","relations":[{"predicate":"uses","target":"artifact:gordian-kg","note":"Ingestion writes Result and Decision nodes through the same loader the audit uses."},{"predicate":"usedBy","target":"artifact:python-orchestration"},{"predicate":"produces","target":"concept:evidence"}],"verification":[]},
    {"@id":"artifact:runtime","@type":["ImplementationArtifact"],"name":"Gordian Runtime","summary":"Planned Rust coordinator process composing Mission Graph, scheduler, coordination, persistence, Jujutsu, evidence, and worker adapters under deterministic safety semantics.","status":"planned","url":"crates/gordian-runtime","relations":[{"predicate":"uses","target":"artifact:mission-core"},{"predicate":"uses","target":"artifact:scheduler"},{"predicate":"uses","target":"artifact:evidence-core"},{"predicate":"uses","target":"artifact:coordination-core"},{"predicate":"uses","target":"artifact:persistence-adapter"},{"predicate":"uses","target":"artifact:jj-adapter"},{"predicate":"uses","target":"artifact:git-adapter"},{"predicate":"uses","target":"artifact:source-adapter"},{"predicate":"uses","target":"artifact:experiment-runner"}],"verification":[]},
    {"@id":"artifact:python-orchestration","@type":["ImplementationArtifact"],"name":"Python Experiment Orchestration","summary":"In-progress thin Python layer for experiment launch, deterministic workload generation, external process coordination, statistical/result aggregation, and research automation without duplicating Rust domain decisions; the runtime orchestration surface is not yet fully implemented.","status":"in-progress","url":"orchestration/","relations":[{"predicate":"uses","target":"tool:python"},{"predicate":"uses","target":"artifact:runtime"},{"predicate":"uses","target":"artifact:workload-generator"},{"predicate":"usedBy","target":"experiment:foundation-benchmarks"},{"predicate":"usedBy","target":"experiment:scheduler-benchmarks"}],"verification":[{"method":"Workload corpus and format checker","target":"scripts/check-workloads.sh","status":"passing","note":"Covers the deterministic dataset generator and format boundary; it is not evidence that the future runtime orchestration is complete."}]},
    {"@id":"artifact:workload-generator","@type":["ImplementationArtifact"],"name":"Gordian Workload Generator","summary":"Deterministic synthetic and repository-derived workload generator with fixed seeds, named distribution envelopes, exact graph-shape metrics, and closed source-manifest extraction.","status":"implemented","url":"orchestration/src/gordian_orchestration/workloads.py","relations":[{"predicate":"implements","target":"artifact:workload-format"},{"predicate":"produces","target":"artifact:workload-corpus"},{"predicate":"uses","target":"tool:python"},{"predicate":"testedBy","target":"artifact:workload-corpus"}],"verification":[{"method":"Workload corpus and format checker","target":"scripts/check-workloads.sh","status":"passing","note":"Checks canonical identity, graph metrics, exact envelopes, source digest framing, and the fixed seed matrix."}]},
