{
  "@graph": [
    {"@id":"foundation:htn","@type":["Concept","ScientificFoundation"],"name":"Hierarchical Task Network Planning","summary":"Planning formalism that decomposes compound tasks through methods into progressively primitive tasks under ordering and state constraints.","status":"established-field","relations":[{"predicate":"supportedBy","target":"source:htn-survey"},{"predicate":"relatedTo","target":"foundation:pocl"}],"verification":[]},
    {"@id":"foundation:pocl","@type":["Concept","ScientificFoundation"],"name":"Partial-Order Causal-Link Planning","summary":"Planning over partially ordered actions with explicit causal links and threat resolution, separating causal necessity from arbitrary total order.","status":"established-field","relations":[{"predicate":"supportedBy","target":"source:hybrid-planning-survey"},{"predicate":"relatedTo","target":"foundation:causal-link"}],"verification":[]},
    {"@id":"foundation:hybrid-planning","@type":["Concept","ScientificFoundation"],"name":"Hybrid HTN/POCL Planning","summary":"Combination of hierarchical decomposition with partial-order causal-link reasoning, useful for Gordian's separation of decomposition from execution ordering.","status":"established-research","relations":[{"predicate":"supportedBy","target":"source:hybrid-planning-survey"},{"predicate":"uses","target":"foundation:htn"},{"predicate":"uses","target":"foundation:pocl"}],"verification":[]},
    {"@id":"foundation:causal-link","@type":["Concept","ScientificFoundation"],"name":"Causal Link","summary":"Explicit relation recording that one action establishes a condition required by another, supporting reasoning about necessary ordering and threats.","status":"established-field","relations":[{"predicate":"groundedIn","target":"foundation:pocl"}],"verification":[]},
    {"@id":"foundation:hoare-logic","@type":["Concept","ScientificFoundation"],"name":"Hoare-style Preconditions/Postconditions","summary":"Program reasoning structure {P} C {Q}; Gordian borrows the contract shape for Atom assumptions and obligations without claiming all engineering work is formally verified.","status":"established-field","relations":[{"predicate":"supportedBy","target":"source:hoare-1969"}],"verification":[]},
    {"@id":"foundation:dag","@type":["Concept","ScientificFoundation"],"name":"Directed Acyclic Graph","summary":"Directed relation with no directed cycles, enabling topological order and causal prerequisite scheduling.","status":"established","relations":[{"predicate":"relatedTo","target":"foundation:topological-order"},{"predicate":"relatedTo","target":"foundation:critical-path"}],"verification":[]},
    {"@id":"foundation:topological-order","@type":["Concept","ScientificFoundation"],"name":"Topological Ordering","summary":"Linearization of a DAG consistent with directed precedence edges; useful for validation certificates and scheduling.","status":"established","relations":[{"predicate":"groundedIn","target":"foundation:dag"},{"predicate":"implementedBy","target":"algorithm:kahn-toposort"}],"verification":[]},
    {"@id":"foundation:critical-path","@type":["Concept","ScientificFoundation"],"name":"Critical Path","summary":"Longest weighted precedence path determining a lower bound on completion time and a key priority signal for DAG scheduling.","status":"established","relations":[{"predicate":"groundedIn","target":"foundation:dag"},{"predicate":"usedBy","target":"algorithm:critical-path"},{"predicate":"usedBy","target":"algorithm:heft-scheduler"}],"verification":[]},
    {"@id":"foundation:work-span","@type":["Concept","ScientificFoundation"],"name":"Work/Span Model","summary":"Parallel computation model separating total work T1 from critical-path/span T∞; greedy scheduling bounds motivate measuring available parallelism rather than agent count.","status":"established","relations":[{"predicate":"supportedBy","target":"source:work-stealing-1999"},{"predicate":"relatedTo","target":"foundation:work-stealing"}],"verification":[]},
    {"@id":"foundation:rcpsp","@type":["Concept","ScientificFoundation"],"name":"Resource-Constrained Project Scheduling","summary":"Scheduling activities subject to precedence and limited resources; generally NP-hard and relevant once workers, memory, model budgets, and capabilities constrain Atom scheduling.","status":"established-field","relations":[{"predicate":"supportedBy","target":"source:rcpsp-survey"},{"predicate":"usedBy","target":"algorithm:greedy-list-scheduler"}],"verification":[]},
    {"@id":"foundation:list-scheduling","@type":["Concept","ScientificFoundation"],"name":"List Scheduling","summary":"Priority-based scheduling family selecting ready DAG tasks and assigning them to resources; provides inexpensive baselines for Gordian scheduling research.","status":"established","relations":[{"predicate":"groundedIn","target":"foundation:dag"},{"predicate":"relatedTo","target":"foundation:heft"},{"predicate":"implementedBy","target":"algorithm:greedy-list-scheduler"}],"verification":[]},
    {"@id":"foundation:heft","@type":["Concept","ScientificFoundation"],"name":"Heterogeneous Earliest Finish Time","summary":"Low-complexity DAG scheduling heuristic prioritizing tasks by upward rank then choosing the heterogeneous worker with earliest finish time.","status":"established-heuristic","relations":[{"predicate":"supportedBy","target":"source:heft-1999"},{"predicate":"groundedIn","target":"foundation:list-scheduling"},{"predicate":"implementedBy","target":"algorithm:heft-scheduler"}],"verification":[]},
    {"@id":"foundation:cpop","@type":["Concept","ScientificFoundation"],"name":"Critical Path on a Processor","summary":"Heterogeneous DAG scheduling heuristic from the HEFT work that keeps critical-path nodes on a selected processor and schedules others by priority.","status":"established-heuristic","relations":[{"predicate":"supportedBy","target":"source:heft-1999"},{"predicate":"contrastsWith","target":"foundation:heft"}],"verification":[]},
    {"@id":"foundation:work-stealing","@type":["Concept","ScientificFoundation"],"name":"Work Stealing","summary":"Parallel scheduling technique in which idle workers steal work; classic analysis gives provable expected bounds for fully strict computations.","status":"established","relations":[{"predicate":"supportedBy","target":"source:work-stealing-1999"},{"predicate":"uses","target":"foundation:work-span"}],"verification":[]},
    {"@id":"foundation:occ","@type":["Concept","ScientificFoundation"],"name":"Optimistic Concurrency Control","summary":"Concurrency strategy allowing isolated work to proceed before validation/commit detects incompatible concurrent changes; Gordian borrows the snapshot-and-validate pattern as an analogy.","status":"established","relations":[{"predicate":"supportedBy","target":"source:occ-1981"},{"predicate":"relatedTo","target":"foundation:snapshot-isolation"},{"predicate":"relatedTo","target":"foundation:conflict-serializability"}],"verification":[]},
    {"@id":"foundation:snapshot-isolation","@type":["Concept","ScientificFoundation"],"name":"Snapshot Isolation","summary":"Stable snapshot view during a transaction/execution; Gordian adapts the stable-base idea for workers but does not equate source edits with database transactions.","status":"established-db-concept","relations":[{"predicate":"relatedTo","target":"foundation:occ"},{"predicate":"relatedTo","target":"foundation:mvcc"},{"predicate":"testedBy","target":"experiment:snapshot-vs-rebase"}],"verification":[]},
    {"@id":"foundation:mvcc","@type":["Concept","ScientificFoundation"],"name":"Multi-Version Concurrency Control","summary":"Concurrency technique retaining multiple versions so readers/executors can observe stable snapshots while newer versions emerge.","status":"established-db-concept","relations":[{"predicate":"relatedTo","target":"foundation:snapshot-isolation"},{"predicate":"motivates","target":"claim:semantic-state-vs-code-state"}],"verification":[]},
    {"@id":"foundation:conflict-serializability","@type":["Concept","ScientificFoundation"],"name":"Conflict Serializability","summary":"Database criterion reasoning about read/write conflict order; Gordian borrows conflict-set intuition while explicitly treating semantic source conflicts as richer and incompletely observed.","status":"established-db-concept","relations":[{"predicate":"relatedTo","target":"foundation:occ"},{"predicate":"motivates","target":"algorithm:semantic-conflict-admission"}],"verification":[]},
    {"@id":"foundation:leases","@type":["Concept","ScientificFoundation"],"name":"Leases","summary":"Time-bounded rights used in distributed systems; useful for work/resource ownership but insufficient alone when stale processes may continue acting after expiry.","status":"established-distributed-systems","relations":[{"predicate":"relatedTo","target":"foundation:fencing-tokens"},{"predicate":"implementedBy","target":"algorithm:lease-arbitration"}],"verification":[]},
    {"@id":"foundation:fencing-tokens","@type":["Concept","EngineeringFoundation"],"name":"Fencing Tokens","summary":"Monotonically increasing tokens allowing downstream resources to reject operations from stale lease holders after newer ownership is granted.","status":"established-pattern","relations":[{"predicate":"refines","target":"foundation:leases"},{"predicate":"usedBy","target":"algorithm:lease-arbitration"}],"verification":[]},
    {"@id":"foundation:cas","@type":["Concept","EngineeringFoundation"],"name":"Compare-and-Swap Frontier Update","summary":"Conditional mutation requiring expected prior state, preventing silent lost updates when accepted frontier changes concurrently.","status":"established-pattern","relations":[{"predicate":"implementedBy","target":"algorithm:frontier-cas"}],"verification":[]},
    {"@id":"foundation:deterministic-replay","@type":["Concept","EngineeringFoundation"],"name":"Deterministic Replay / Durable Execution","summary":"Replayable orchestration computes state from recorded history while nondeterministic/effectful activities are executed separately and their results recorded.","status":"production-established","relations":[{"predicate":"supportedBy","target":"source:temporal"},{"predicate":"implementedBy","target":"algorithm:event-projection"}],"verification":[]},
    {"@id":"foundation:idempotency","@type":["Concept","EngineeringFoundation"],"name":"Idempotency","summary":"Property that repeating an operation yields an equivalent externally relevant state; important for safe retry but must be declared and tested, not assumed.","status":"established","relations":[{"predicate":"usedBy","target":"concept:effect-class"}],"verification":[]},
    {"@id":"foundation:workflow-net","@type":["Concept","ScientificFoundation"],"name":"Workflow-Net Soundness","summary":"Petri-net-based workflow theory studying proper completion, dead transitions, liveness-related properties, and soundness classes.","status":"established-field","relations":[{"predicate":"supportedBy","target":"source:workflow-soundness"},{"predicate":"relatedTo","target":"foundation:petri-net"}],"verification":[]},
    {"@id":"foundation:petri-net","@type":["Concept","ScientificFoundation"],"name":"Petri Net","summary":"Formal model of concurrent/distributed workflows with places, transitions, and tokens; richer than Gordian's hard-dependency DAG for joins, choice, and loops.","status":"established-field","relations":[{"predicate":"contrastsWith","target":"foundation:dag"},{"predicate":"groundedIn","target":"foundation:workflow-net"}],"verification":[]},
    {"@id":"foundation:crdt","@type":["Concept","ScientificFoundation"],"name":"Conflict-Free Replicated Data Type","summary":"Replicated data structure designed for convergence under concurrent updates; can solve representation convergence without guaranteeing semantic correctness of concurrently edited software.","status":"established-field","relations":[{"predicate":"qualifiedBy","target":"claim:crdt-not-semantic-correctness"},{"predicate":"informedBy","target":"source:agentroom"}],"verification":[]},
    {"@id":"foundation:semantic-convergence","@type":["Concept","EngineeringFoundation"],"name":"Semantic Convergence","summary":"Agreement not merely on text/state representation but on compatible program meaning, interfaces, and invariants after concurrent work.","status":"conceptual","relations":[{"predicate":"contrastsWith","target":"foundation:crdt"},{"predicate":"motivates","target":"concept:semantic-claim"}],"verification":[]},
    {"@id":"foundation:capability-security","@type":["Concept","ScientificFoundation"],"name":"Capability Security / Least Authority","summary":"Security design in which actors receive explicit narrowly scoped authority required for operations instead of ambient universal privilege.","status":"established-security-principle","relations":[{"predicate":"implementedBy","target":"tool:cedar"},{"predicate":"formalizedBy","target":"theorem:worker-cannot-promote"}],"verification":[]},
    {"@id":"foundation:hermeticity","@type":["Concept","EngineeringFoundation"],"name":"Hermeticity","summary":"Constraining computation to declared inputs/environment so outputs and verification can be reproduced and dependency boundaries inspected.","status":"production-established","relations":[{"predicate":"supportedBy","target":"source:bazel-dependencies"},{"predicate":"supportedBy","target":"source:nix-reproducible"},{"predicate":"relatedTo","target":"foundation:content-addressing"}],"verification":[]},
    {"@id":"foundation:content-addressing","@type":["Concept","EngineeringFoundation"],"name":"Content Addressing","summary":"Identity derived from content digest, enabling exact artifact references, deduplication, and stale-evidence invalidation boundaries.","status":"production-established","relations":[{"predicate":"supportedBy","target":"source:nix-merkle"},{"predicate":"relatedTo","target":"foundation:merkle-dag"},{"predicate":"implementedBy","target":"algorithm:content-address-store"}],"verification":[]},
    {"@id":"foundation:merkle-dag","@type":["Concept","EngineeringFoundation"],"name":"Merkle DAG","summary":"Graph whose node identities commit cryptographically to content and descendant identities, supporting reproducible content-addressed structures.","status":"production-established","relations":[{"predicate":"supportedBy","target":"source:nix-merkle"},{"predicate":"groundedIn","target":"foundation:content-addressing"}],"verification":[]},
    {"@id":"foundation:provenance","@type":["Concept","StandardFoundation"],"name":"Entity-Activity-Agent Provenance","summary":"Provenance model separating entities, activities, agents, derivation, usage, generation, and responsibility.","status":"standardized","relations":[{"predicate":"supportedBy","target":"source:w3c-prov"}],"verification":[]},
    {"@id":"foundation:attestation","@type":["Concept","StandardFoundation"],"name":"Supply-Chain Attestation","summary":"Authenticated statement over subjects, materials, products, activity identity, and environment, adapted from in-toto/SLSA concepts.","status":"standardized-pattern","relations":[{"predicate":"supportedBy","target":"source:in-toto"},{"predicate":"supportedBy","target":"source:slsa"}],"verification":[]},
    {"@id":"foundation:verification-guided-development","@type":["Concept","EngineeringFoundation"],"name":"Verification-Guided Development","summary":"Development process combining executable formal models/proofs, optimized production implementation, differential randomized testing, and property-based testing.","status":"production-demonstrated","relations":[{"predicate":"supportedBy","target":"source:cedar-vgd"},{"predicate":"supportedBy","target":"source:cedar-spec"},{"predicate":"uses","target":"foundation:differential-random-testing"},{"predicate":"uses","target":"foundation:property-testing"}],"verification":[]},
    {"@id":"foundation:differential-random-testing","@type":["Concept","EngineeringFoundation"],"name":"Differential Random Testing","summary":"Generate diverse inputs and compare independent implementations/models to detect semantic divergence; proposed bridge between Lean reference semantics and Rust production semantics.","status":"production-demonstrated","relations":[{"predicate":"supportedBy","target":"source:cedar-vgd"},{"predicate":"implementedBy","target":"algorithm:differential-conformance"}],"verification":[]},
    {"@id":"foundation:property-testing","@type":["Concept","EngineeringFoundation"],"name":"Property-Based Testing","summary":"Generated testing over broad input domains against invariants rather than only hand-picked examples.","status":"established","relations":[{"predicate":"implementedBy","target":"tool:proptest"},{"predicate":"usedBy","target":"experiment:foundation-benchmarks"}],"verification":[]},
    {"@id":"foundation:model-checking","@type":["Concept","ScientificFoundation"],"name":"Model Checking","summary":"Systematic state-space exploration for violations of formal safety/liveness properties; useful for bounded transition and unsafe-code checks.","status":"established-field","relations":[{"predicate":"implementedBy","target":"tool:kani"},{"predicate":"implementedBy","target":"tool:loom"}],"verification":[]},
    {"@id":"foundation:concurrency-testing","@type":["Concept","EngineeringFoundation"],"name":"Controlled Concurrency Exploration","summary":"Systematically or randomly explores alternative thread/task schedules to expose rare race/deadlock behaviors.","status":"production-technique","relations":[{"predicate":"implementedBy","target":"tool:loom"},{"predicate":"implementedBy","target":"tool:shuttle"}],"verification":[]},
    {"@id":"foundation:fuzzing","@type":["Concept","EngineeringFoundation"],"name":"Coverage-Guided Fuzzing","summary":"Automated generation/mutation of inputs guided by execution coverage to find parser, protocol, and state-machine failures.","status":"established","relations":[{"predicate":"implementedBy","target":"tool:cargo-fuzz"}],"verification":[]},
    {"@id":"foundation:mutation-testing","@type":["Concept","EngineeringFoundation"],"name":"Mutation Testing","summary":"Deliberately alters implementation logic and requires tests to detect the mutation, measuring whether tests defend claimed invariants.","status":"established","relations":[{"predicate":"implementedBy","target":"tool:cargo-mutants"}],"verification":[]},
    {"@id":"foundation:benchmarking","@type":["Concept","EngineeringFoundation"],"name":"Performance Benchmarking","summary":"Measurement of latency, throughput, allocation/memory, scaling shape, and regressions under representative/adversarial workload distributions.","status":"required-method","relations":[{"predicate":"implementedBy","target":"tool:criterion"},{"predicate":"implementedBy","target":"tool:divan"},{"predicate":"implementedBy","target":"tool:iai-callgrind"}],"verification":[]},
    {"@id":"foundation:goodhart","@type":["Concept","ScientificFoundation"],"name":"Goodhart / Proxy Optimization Risk","summary":"When a proxy becomes an optimization target it may cease to represent the underlying objective; relevant to task counts, agent utilization, benchmark scores, and verifier gaming.","status":"established-warning","relations":[{"predicate":"motivates","target":"experiment:mission-ontology"},{"predicate":"motivates","target":"concept:acceptance-predicate"}],"verification":[]},
    {"@id":"foundation:formal-refinement","@type":["Concept","ScientificFoundation"],"name":"Implementation Refinement","summary":"Formal relationship showing an implementation preserves an abstract specification's semantics; absent such a theorem, differential testing supplies evidence rather than proof of equivalence.","status":"established-formal-methods","relations":[{"predicate":"relatedTo","target":"foundation:verification-guided-development"},{"predicate":"testedBy","target":"experiment:lean-rust-conformance"}],"verification":[]}
  ]
}
