  "@graph": [
    {"@id":"concept:plan-selection","@type":["Concept"],"name":"Plan Selection","summary":"Authority-controlled selection of one immutable PlanRevision for current execution while retaining alternative and historical plans.","status":"proposed","relations":[{"predicate":"uses","target":"concept:plan-revision"},{"predicate":"uses","target":"concept:event"},{"predicate":"implementedBy","target":"algorithm:plan-selection-cas"}],"verification":[]},
    {"@id":"concept:project-resource-registry","@type":["Concept"],"name":"Project Resource Registry","summary":"Typed Project-scoped registry of repositories, knowledge resources, environments, artifact stores, trackers, release channels, and deployment targets with stable external identities.","status":"proposed","relations":[{"predicate":"refines","target":"concept:project"},{"predicate":"uses","target":"concept:capability"},{"predicate":"uses","target":"concept:artifact"}],"verification":[]},
    {"@id":"concept:sandbox-backend","@type":["Concept"],"name":"Sandbox Backend","summary":"Replaceable enforcement backend that constrains worker filesystem, process, network, device, secret, time, CPU, and memory authority according to a capability envelope.","status":"proposed","relations":[{"predicate":"uses","target":"concept:capability"},{"predicate":"uses","target":"concept:effect-class"},{"predicate":"testedBy","target":"experiment:sandbox-backend-qualification"}],"verification":[]},
    {"@id":"concept:secret-broker","@type":["Concept"],"name":"Capability-Scoped Secret Broker","summary":"Authority service that resolves opaque secret references into short-lived least-privilege credentials for one approved actor, resource, sandbox, and effect without persisting plaintext in Mission state.","status":"proposed","relations":[{"predicate":"uses","target":"concept:capability"},{"predicate":"uses","target":"concept:actor"},{"predicate":"uses","target":"concept:project-resource-registry"},{"predicate":"requires","target":"concept:sandbox-backend"}],"verification":[]},
    {"@id":"concept:release-record","@type":["Concept"],"name":"Release Record","summary":"Immutable authority-controlled record binding exact accepted source, build and verifier evidence, artifact digests, provenance, toolchain/environment identity, and a release identity.","status":"proposed","relations":[{"predicate":"uses","target":"concept:accepted-frontier"},{"predicate":"uses","target":"concept:artifact"},{"predicate":"uses","target":"concept:attestation"},{"predicate":"requires","target":"concept:authority-model"}],"verification":[]},
    {"@id":"concept:deployment-record","@type":["Concept"],"name":"Deployment Record","summary":"Historical record of which immutable release or artifact set was attempted, observed, rolled back, or currently running in a target environment.","status":"proposed","relations":[{"predicate":"refines","target":"concept:deployment-frontier"},{"predicate":"uses","target":"concept:release-record"},{"predicate":"uses","target":"concept:event"},{"predicate":"requires","target":"concept:authority-model"}],"verification":[]},
    {"@id":"concept:backup-restore","@type":["Concept"],"name":"Backup and Restore","summary":"Recovery mechanism preserving canonical identities, immutable specifications, events, evidence metadata, artifacts, research state, and accepted/deployment frontiers across clean restoration.","status":"proposed","relations":[{"predicate":"uses","target":"concept:event"},{"predicate":"uses","target":"concept:artifact"},{"predicate":"uses","target":"concept:projection"}],"verification":[]},
    {"@id":"concept:migration-compatibility","@type":["Concept"],"name":"Migration and Compatibility Boundary","summary":"Explicit transformation and compatibility policy at persisted or wire boundaries that preserves historical interpretation instead of applying decorative project-wide version labels.","status":"proposed","relations":[{"predicate":"uses","target":"concept:backup-restore"},{"predicate":"uses","target":"concept:event"},{"predicate":"uses","target":"concept:projection"}],"verification":[]},
    {"@id":"concept:security-qualification","@type":["Concept"],"name":"Adversarial Security Qualification","summary":"Executable threat-model and attack evaluation of worker, planner, verifier, adapter, API, coordinator, sandbox, secret, evidence, provenance, and release authority boundaries.","status":"proposed","relations":[{"predicate":"uses","target":"concept:authority-model"},{"predicate":"uses","target":"concept:capability"},{"predicate":"uses","target":"concept:sandbox-backend"},{"predicate":"uses","target":"concept:secret-broker"},{"predicate":"testedBy","target":"experiment:release-qualification"}],"verification":[]},
    {"@id":"concept:github-project-bootstrap","@type":["Concept"],"name":"Temporary GitHub Project Bootstrap","summary":"External issue and board projection used to execute Gordian's implementation before native self-hosting; it is explicitly non-canonical and cannot establish Atom satisfaction.","status":"specified","relations":[{"predicate":"contrastsWith","target":"concept:mission-graph"},{"predicate":"implementedBy","target":"artifact:github-project-sync-script"},{"predicate":"documentedBy","target":"artifact:issue-index"}],"verification":[]},
    {"@id":"algorithm:plan-selection-cas","@type":["Algorithm"],"name":"Plan Selection Compare-and-Swap","summary":"Selects a PlanRevision only when the caller is authorized and the expected prior selected-plan identity still matches, appending an auditable event on success.","status":"planned","relations":[{"predicate":"uses","target":"concept:plan-revision"},{"predicate":"uses","target":"concept:capability"},{"predicate":"produces","target":"concept:event"}],"verification":[]},
    {"@id":"algorithm:repair-action-classification","@type":["Algorithm"],"name":"Reconciliation Repair Classification","summary":"Classifies desired-versus-observed deltas into wait, retry, verify, repair, replan, judgment escalation, abandonment, or accepted-scope-change actions while respecting effect policy.","status":"planned","relations":[{"predicate":"uses","target":"concept:reconciliation"},{"predicate":"uses","target":"concept:effect-class"},{"predicate":"produces","target":"concept:plan-revision"}],"verification":[]},
    {"@id":"hypothesis:evidence-fingerprint-worth-cost","@type":["Hypothesis"],"name":"Exact evidence fingerprints repay their invalidation cost","summary":"Seven-component fingerprints are compared against a coarser commit-only binding on the rate of accepted-but-stale evidence and on the volume of re-verification each triggers.","status":"untested","relations":[{"predicate":"testedBy","target":"experiment:evidence-invalidation-cost"},{"predicate":"qualifiedBy","target":"source:mokhov-2018","note":"Build Systems a la Carte shows early cutoff and minimality are properties of the rebuilder, not of key width, so a wider fingerprint can raise invalidation volume without improving either."},{"predicate":"qualifiedBy","target":"source:bazel-dependencies","note":"Bazel's declared-versus-actual dependency distinction is the production statement of the same tradeoff: over-declaration is cheap to state and expensive to run."}],"verification":[],"statement":"Under the generated candidate-and-rewrite corpus of experiment:evidence-invalidation-cost (#59), seven-component fingerprints reduce accepted-stale-evidence admissions to <= 0 per 1000 admissions while adding <= 25 percent re-verification wall time versus the commit-only baseline condition, over >= 300 seeded trials; otherwise reject."},
    {"@id":"hypothesis:formal-methods-add-unique-yield","@type":["Hypothesis"],"name":"The formal layer finds defect classes the Rust stack does not","summary":"Seeded defects are classified by which verification layer catches them first, isolating the classes reachable only through the Lean model.","status":"untested","relations":[{"predicate":"testedBy","target":"experiment:formal-method-yield"},{"predicate":"qualifiedBy","target":"source:cedar-vgd-fse-2024","note":"Cedar reports defects found by proof development and by differential random testing separately; a substantial share was reachable by testing alone."},{"predicate":"qualifiedBy","target":"source:newcombe-2015","note":"AWS reports formal methods finding defects at design time rather than defects invisible to testing, which is a weaker yield than this hypothesis asserts."}],"verification":[],"statement":"Under the seeded-defect matrix of experiment:formal-method-yield (#60), >= 15 percent of seeded safety-kernel defects are caught first by the Lean model or by Lean/Rust differential testing and by no layer of the Rust baseline condition, over >= 200 seeded defects; otherwise reject."},
    {"@id":"hypothesis:jsonld-petgraph-sufficient","@type":["Hypothesis"],"name":"JSON-LD shards over a petgraph index are sufficient at the corpus sizes Gordian reaches","summary":"The current adjacency index is compared against an RDF triple store on the query set the knowledge tooling actually issues, as corpus size grows.","status":"untested","relations":[{"predicate":"testedBy","target":"experiment:knowledge-backend-qualification"},{"predicate":"qualifiedBy","target":"source:petgraph","note":"petgraph supplies traversal but no query language and no RDF projection, so sufficiency has to be argued query by query rather than by capability."},{"predicate":"qualifiedBy","target":"source:w3c-prov","note":"The provenance queries acquisition.md requires are expressed naturally in a PROV/SPARQL projection and only by bespoke traversal code over an adjacency index."}],"verification":[],"statement":"Under the synthetic knowledge-corpus generator of experiment:knowledge-backend-qualification (#61), the JSON-LD plus petgraph backend answers every query in the committed query set within 100 ms at 100000 nodes and stays within 2x of the RDF-store baseline condition on every query, over >= 20 seeded corpora; otherwise reject and adopt a triple store."},
    {"@id":"hypothesis:sandbox-tiering-worth-complexity","@type":["Hypothesis"],"name":"Tiered sandboxing beats a single hardware-isolated tier","summary":"Process, user-space-kernel and microVM isolation tiers are compared on per-attempt overhead and on escape resistance against a malicious-worker fixture set.","status":"untested","relations":[{"predicate":"testedBy","target":"experiment:sandbox-backend-qualification"},{"predicate":"qualifiedBy","target":"source:firecracker-2020","note":"Firecracker reports microVM boot in about 125 ms with roughly 5 MB per-VM overhead, which is small enough that a tiering mechanism may not repay its own complexity."},{"predicate":"qualifiedBy","target":"source:gvisor-2019","note":"gVisor's measured system-call and I/O overhead shows the intermediate tier is not uniformly cheaper than the strong tier for I/O-heavy workloads."}],"verification":[],"statement":"Under the worker-workload corpus of experiment:sandbox-backend-qualification (#62), tier selection lowers median per-attempt isolation overhead by >= 30 percent versus the microVM-for-everything baseline condition while allowing 0 escapes across the malicious-worker fixture set, over >= 200 seeded trials; otherwise reject and use one tier."},
    {"@id":"experiment:evidence-invalidation-cost","@type":["Experiment"],"name":"Evidence Invalidation Safety and Cost Experiment","summary":"Injects candidate, specification, dependency, environment, and verifier changes to compare stale-evidence acceptance, unnecessary recomputation, and fingerprint overhead across binding policies.","status":"planned","url":"https://github.com/kmosoti/gordian/issues/59","relations":[{"predicate":"tests","target":"hypothesis:evidence-fingerprint-worth-cost"},{"predicate":"uses","target":"concept:evidence"},{"predicate":"uses","target":"concept:candidate"}],"verification":[{"method":"seeded fault experiment","target":"experiments/evidence-invalidation-cost/","status":"planned"}]},
    {"@id":"experiment:formal-method-yield","@type":["Experiment"],"name":"Formal-Method Defect Yield Experiment","summary":"Compares incremental verification stacks over seeded Gordian defects and records unique detection, timing, theorem relevance, model mismatch, and maintenance cost.","status":"planned","url":"https://github.com/kmosoti/gordian/issues/60","relations":[{"predicate":"tests","target":"hypothesis:formal-methods-add-unique-yield"}],"verification":[{"method":"seeded defect matrix","target":"experiments/formal-method-yield/","status":"planned"}]},
    {"@id":"experiment:knowledge-backend-qualification","@type":["Experiment"],"name":"Knowledge Graph Backend Qualification","summary":"Compares sharded JSON-LD/Rust indexing, improved streaming indexes, and embedded RDF alternatives over generated corpora and epistemic queries.","status":"planned","url":"https://github.com/kmosoti/gordian/issues/61","relations":[{"predicate":"tests","target":"hypothesis:jsonld-petgraph-sufficient"}],"verification":[{"method":"cross-backend benchmark and query equivalence","target":"experiments/knowledge-backend-qualification/","status":"planned"}]},
    {"@id":"experiment:sandbox-backend-qualification","@type":["Experiment"],"name":"Sandbox Backend Qualification","summary":"Compares enforcement strength, escape/denial behavior, startup, memory, I/O, cleanup, and operational complexity across local process, container, stronger sandbox, and microVM candidates.","status":"planned","url":"https://github.com/kmosoti/gordian/issues/62","relations":[{"predicate":"tests","target":"hypothesis:sandbox-tiering-worth-complexity"},{"predicate":"uses","target":"concept:security-qualification"},{"predicate":"informedBy","target":"source:firecracker-2020"},{"predicate":"informedBy","target":"source:gvisor-2019"}],"verification":[{"method":"threat-model benchmark and malicious worker fixtures","target":"experiments/sandbox-backend-qualification/","status":"planned"}]},
    {"@id":"experiment:release-qualification","@type":["Experiment"],"name":"End-to-End Release Qualification","summary":"Exercises clean installation, Mission execution, exact verification, admission, restart/replay, security, release/deployment, backup/restore, and performance against exact distribution artifacts.","status":"planned","url":"https://github.com/kmosoti/gordian/issues/69","relations":[{"predicate":"uses","target":"concept:release-record"},{"predicate":"uses","target":"concept:deployment-record"},{"predicate":"uses","target":"concept:backup-restore"},{"predicate":"uses","target":"concept:security-qualification"}],"verification":[{"method":"clean-environment qualification suite","target":"experiments/release-qualification/","status":"planned"}]},
    {"@id":"artifact:github-project-sync-script","@type":["ImplementationArtifact"],"name":"GitHub Project Reconciliation Script","summary":"Thin Python bootstrap utility that idempotently compares repository issue URLs with Project 9 items and adds missing issues through the authenticated GitHub CLI.","status":"implemented","url":"https://github.com/kmosoti/gordian/blob/main/scripts/sync_github_project.py","relations":[{"predicate":"implements","target":"concept:github-project-bootstrap"}],"verification":[{"method":"dry-run and post-reconciliation comparison","target":"scripts/sync_github_project.py","status":"ci-check-required"}]},
    {"@id":"artifact:issue-index","@type":["Document","ImplementationArtifact"],"name":"Gordian Atom Index","summary":"Human-readable map of the temporary 70-Atom implementation Mission, grouped by Initiative with a causal execution spine and first Codex implementation cut.","status":"current","url":"https://github.com/kmosoti/gordian/blob/main/docs/implementation/issue-index.md","relations":[{"predicate":"documents","target":"concept:github-project-bootstrap"},{"predicate":"documents","target":"concept:mission-graph"}],"verification":[]}
  ]
}
