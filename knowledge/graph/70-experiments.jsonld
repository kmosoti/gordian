{
  "@graph": [
    {"@id":"experiment:foundation-benchmarks","@type":["Experiment"],"name":"Foundation Algorithm Benchmark Matrix","summary":"Benchmark graph validation, traversal, critical-path, scheduling, evidence lookup, and projection over representative and adversarial graph shapes before selecting optimized substrate algorithms.","status":"planned-foundation","relations":[{"predicate":"tests","target":"foundation:benchmarking"},{"predicate":"tests","target":"algorithm:kahn-toposort"},{"predicate":"tests","target":"algorithm:critical-path"}],"verification":[{"method":"Rust benchmark harness","target":"benches/foundation","status":"planned","note":"Must report graph size, edge density, critical-path ratio, allocations/memory, CPU/wall time, and scaling shape."}]},
    {"@id":"experiment:scheduler-benchmarks","@type":["Experiment"],"name":"Scheduler Baseline and Optimization Benchmark","summary":"Compare FIFO/greedy ready-queue scheduling, critical-path priority, HEFT-inspired heterogeneous scheduling, and future policies on synthetic and repository-derived DAGs under heterogeneous worker costs/capabilities.","status":"planned-foundation","relations":[{"predicate":"tests","target":"algorithm:greedy-list-scheduler"},{"predicate":"tests","target":"algorithm:heft-scheduler"},{"predicate":"tests","target":"foundation:critical-path"},{"predicate":"tests","target":"foundation:rcpsp"}],"verification":[{"method":"Rust benchmark + simulation","target":"experiments/scheduler","status":"planned","note":"Measure makespan, critical-path overhead, scheduler CPU/allocation cost, resource utilization, verification/retry cost, and robustness under estimation error."}]},
    {"@id":"experiment:mission-ontology","@type":["Experiment"],"name":"Mission Graph Ontology Ablation","summary":"Compare simpler task/issue structures with Mission/PlanRevision/Initiative/Atom/Quark decomposition under controlled engineering work to measure ambiguity, planning overhead, replan churn, dependency accuracy, and outcome quality.","status":"planned","relations":[{"predicate":"tests","target":"claim:mission-ontology-useful"},{"predicate":"tests","target":"concept:mission"},{"predicate":"tests","target":"concept:plan-revision"}],"verification":[{"method":"Controlled experiment","target":"experiments/mission-ontology","status":"planned","note":"A result showing no material benefit after overhead should cause ontology simplification."}]},
    {"@id":"experiment:atom-granularity","@type":["Experiment"],"name":"Atom Scheduling Boundary Ablation","summary":"Compare coarse work units, Atom-local Quarks, and globally fine-grained primitives to determine useful scheduling granularity and black-box boundary cost.","status":"planned","relations":[{"predicate":"tests","target":"claim:atom-boundary-optimality"},{"predicate":"tests","target":"concept:atom"},{"predicate":"tests","target":"concept:quark"}],"verification":[{"method":"Benchmark + controlled task ablation","target":"experiments/atom-granularity","status":"planned","note":"Measure exposed parallelism, coordination nodes/events, integration failures, plan churn, verifier cost, and completion time."}]},
    {"@id":"experiment:semantic-conflict-prediction","@type":["Experiment"],"name":"Semantic Conflict Prediction Study","summary":"Compare path overlap, module/package ownership, semantic resource claims, and combined predictors against observed textual, compile/type, test/behavior, schema/config, and no-conflict integration outcomes.","status":"planned","relations":[{"predicate":"tests","target":"claim:semantic-claims-better"},{"predicate":"tests","target":"algorithm:semantic-conflict-admission"},{"predicate":"tests","target":"algorithm:scope-reconciliation"}],"verification":[{"method":"Paired conflict-classification experiment","target":"experiments/semantic-conflicts","status":"planned","note":"Measure precision, recall, false serialization, missed conflict cost, declaration/observation overhead, and net completion cost."}]},
    {"@id":"experiment:isolation-coordination-ablation","@type":["Experiment"],"name":"Isolation and Coordination Ablation","summary":"Hold task/model/verifier budgets constant while comparing solo execution, isolated parallel workers, isolated workers plus shared task state, and isolated workers plus semantic coordination.","status":"planned","relations":[{"predicate":"tests","target":"claim:semantic-state-vs-code-state"},{"predicate":"tests","target":"algorithm:coordination-plane"}],"verification":[{"method":"Repeated paired agent trials","target":"experiments/isolation-coordination","status":"planned","note":"Measure success, abandonment, integration repair, conflicts, wall time, model/tool cost, verifier failures, and run variance."}]},
    {"@id":"experiment:snapshot-vs-rebase","@type":["Experiment"],"name":"Stable Snapshot versus Continuous Rebase","summary":"Compare worker execution against one exact base with periodically rebased active work while stratifying by task duration and accepted-frontier change rate.","status":"planned","relations":[{"predicate":"tests","target":"claim:snapshot-better-than-rebase"},{"predicate":"tests","target":"algorithm:snapshot-execution"}],"verification":[{"method":"Controlled agent experiment","target":"experiments/snapshot-rebase","status":"planned","note":"Measure reasoning invalidation/restarts, discarded work, integration conflict, candidate quality, wall time, and cost."}]},
    {"@id":"experiment:jj-baseline","@type":["Experiment"],"name":"Supported Jujutsu Baseline Qualification","summary":"Establish the minimum supported Jujutsu release and verify required workspace/change/commit/conflict/tag/jj-run semantics against executable fixtures before building the adapter.","status":"required-foundation","relations":[{"predicate":"tests","target":"tool:jujutsu"},{"predicate":"tests","target":"algorithm:jj-revision-verification"}],"verification":[{"method":"CLI contract tests","target":"experiments/jujutsu-baseline","status":"planned","note":"The reported local jj 0.23.0 predates required current features and must be upgraded/pinned for development."}]},
    {"@id":"experiment:jj-vs-git","@type":["Experiment"],"name":"Jujutsu versus Git Orchestration Experiment","summary":"Hold Mission Graph, workers, scheduler, workload, and verifier constant while comparing equivalent Jujutsu and Git workspace/change orchestration.","status":"planned","relations":[{"predicate":"tests","target":"claim:jj-worth-complexity"},{"predicate":"tests","target":"algorithm:jj-workspace-spawn"},{"predicate":"tests","target":"tool:git"},{"predicate":"tests","target":"tool:jujutsu"}],"verification":[{"method":"Differential orchestration benchmark","target":"experiments/jj-vs-git","status":"planned","note":"Measure orchestration LOC/state transitions, identity mistakes, recovery operations, integration failures, evidence invalidation mistakes, and operator interventions."}]},
    {"@id":"experiment:evidence-mutation","@type":["Experiment"],"name":"Evidence Mutation and Staleness Fault Suite","summary":"Verify a passing evidence record becomes unusable when each relevant fingerprint component is changed one at a time or transitively invalidated.","status":"required-foundation","relations":[{"predicate":"tests","target":"algorithm:evidence-compatibility"},{"predicate":"tests","target":"claim:exact-artifact-verification"},{"predicate":"tests","target":"assumption:fingerprint-completeness"}],"verification":[{"method":"Property + mutation + integration tests","target":"experiments/evidence-mutation","status":"planned","note":"Mutate commit, spec, direct/transitive input, environment, verifier, and canonicalization identities."}]},
    {"@id":"experiment:integration-composition","@type":["Experiment"],"name":"Integration Non-Compositionality Suite","summary":"Construct candidate pairs that pass independently but fail after composition to ensure Gordian creates and verifies an explicit integration candidate.","status":"required-foundation","relations":[{"predicate":"tests","target":"concept:integration-candidate"},{"predicate":"tests","target":"algorithm:jj-candidate-integration"}],"verification":[{"method":"Fixture corpus + property tests","target":"experiments/integration-composition","status":"planned","note":"Include API contract, schema, config, resource, and test-only interactions with no textual merge conflict."}]},
    {"@id":"experiment:authorization-engine","@type":["Experiment"],"name":"Capability Policy and Cedar Evaluation","summary":"Compare a minimal internal capability evaluator with Cedar for expressiveness, analyzability, latency, policy complexity, formal assurance, and operational dependencies.","status":"planned-foundation","relations":[{"predicate":"tests","target":"tool:cedar"},{"predicate":"tests","target":"concept:capability"},{"predicate":"tests","target":"assumption:role-enforcement"}],"verification":[{"method":"Threat model + benchmark + property tests","target":"experiments/authorization","status":"planned","note":"Adopt Cedar only if its assurance/expressiveness advantage justifies runtime/dependency cost."}]},
    {"@id":"experiment:lease-faults","@type":["Experiment"],"name":"Lease and Fencing Fault Exploration","summary":"Explore overlapping requests, delayed expiry, paused stale workers, reordered messages, retries, and fencing-token enforcement across exclusive semantic-resource leases.","status":"planned-foundation","relations":[{"predicate":"tests","target":"concept:lease"},{"predicate":"tests","target":"algorithm:lease-arbitration"},{"predicate":"tests","target":"theorem:lease-exclusion-planned"}],"verification":[{"method":"Lean + Loom + Shuttle + fault injection","target":"experiments/leases","status":"planned","note":"Formal transition invariant plus executable concurrency exploration."}]},
    {"@id":"experiment:frontier-races","@type":["Experiment"],"name":"Accepted Frontier Race and Lost-Update Suite","summary":"Inject simultaneous coordinator promotions, stale expected frontiers, retry after uncertain result, and duplicate promotion commands.","status":"required-foundation","relations":[{"predicate":"tests","target":"algorithm:frontier-cas"},{"predicate":"tests","target":"concept:accepted-frontier"}],"verification":[{"method":"State-machine + concurrency tests","target":"experiments/frontier-cas","status":"planned","note":"No test schedule may silently overwrite a newer accepted frontier."}]},
    {"@id":"experiment:replay-faults","@type":["Experiment"],"name":"Replay Determinism and Event Fault Suite","summary":"Destroy/rebuild projections and inject duplicate, reordered, missing, unknown-version, and partially committed event scenarios.","status":"required-foundation","relations":[{"predicate":"tests","target":"algorithm:event-projection"},{"predicate":"tests","target":"assumption:pure-projector"}],"verification":[{"method":"Generated state-machine traces + fault injection","target":"experiments/replay","status":"planned","note":"Canonical projection rebuild must match persisted canonical state for valid histories; invalid histories must reject/normalize explicitly."}]},
    {"@id":"experiment:derived-vs-mutable-state","@type":["Experiment"],"name":"Derived State versus Mutable Status","summary":"Compare canonical-fact-derived readiness/blocking/satisfaction with manually mutated workflow statuses under failures, candidate rewrites, delayed events, and dependency changes.","status":"planned","relations":[{"predicate":"tests","target":"claim:derived-state-reduces-staleness"},{"predicate":"tests","target":"algorithm:reconciliation"}],"verification":[{"method":"Controlled state divergence simulation","target":"experiments/derived-state","status":"planned","note":"Measure stale divergence, correction count, time-to-detect, and incorrect scheduling decisions."}]},
    {"@id":"experiment:lean-rust-conformance","@type":["Experiment"],"name":"Lean/Rust Semantic Differential Testing","summary":"Generate inputs for formalized safety semantics, evaluate both executable Lean models and optimized Rust, and persist/shrink any mismatches.","status":"required-foundation","relations":[{"predicate":"tests","target":"algorithm:differential-conformance"},{"predicate":"tests","target":"foundation:formal-refinement"}],"verification":[{"method":"Differential randomized testing","target":"formal/conformance","status":"planned","note":"Passing is evidence of conformance, not a universal refinement theorem unless exhaustive/formally refined."}]},
    {"@id":"experiment:formal-value","@type":["Experiment"],"name":"Formal Methods Value Study","summary":"Track defects found uniquely by proof development, DRT, PBT, model checking, mutation testing, and ordinary tests together with engineering/maintenance cost.","status":"planned-longitudinal","relations":[{"predicate":"tests","target":"claim:formalization-pays"},{"predicate":"tests","target":"tool:lean4"}],"verification":[{"method":"Longitudinal defect/cost ledger","target":"experiments/formal-value","status":"planned","note":"Formalization expands only when measured value or safety criticality justifies it."}]},
    {"@id":"experiment:verification-stack","@type":["Experiment"],"name":"Verification Technique Coverage Study","summary":"Seed representative defects and determine which layers catch them: type system, unit/PBT, mutation, fuzz, Kani, Loom/Shuttle, Lean, DRT, integration, and fault simulation.","status":"planned-foundation","relations":[{"predicate":"tests","target":"tool:kani"},{"predicate":"tests","target":"tool:cargo-fuzz"},{"predicate":"tests","target":"tool:cargo-mutants"}],"verification":[{"method":"Seeded defect matrix","target":"experiments/verification-stack","status":"planned","note":"Avoid using every tool by default; retain techniques that cover named defect classes cost-effectively."}]},
    {"@id":"experiment:knowledge-graph-benchmarks","@type":["Experiment"],"name":"Knowledge Graph Scale and Query Benchmarks","summary":"Benchmark shard loading, validation, audit, traversal, evidence neighborhood, shortest path, and export over synthetic research graphs as corpus size grows.","status":"required-foundation","relations":[{"predicate":"tests","target":"algorithm:knowledge-index"},{"predicate":"tests","target":"tool:petgraph"}],"verification":[{"method":"Rust benchmark suite","target":"benches/knowledge-graph","status":"planned","note":"Compare current adjacency-list index with simpler maps and alternative graph representations before committing to a backend."}]},
    {"@id":"experiment:artifact-store","@type":["Experiment"],"name":"Artifact Content Addressing Validation","summary":"Test digest identity, deduplication, relocation, corruption detection, metadata lookup, and garbage-collection behavior for evidence payloads.","status":"planned","relations":[{"predicate":"tests","target":"algorithm:content-address-store"}],"verification":[{"method":"Property + integration benchmark","target":"experiments/artifact-store","status":"planned"}]},
    {"@id":"experiment:persistence-benchmarks","@type":["Experiment"],"name":"Persistence and Projection Benchmark","summary":"Measure PostgreSQL event append, transactional frontier updates, recursive dependency queries, projection rebuild, and evidence lookup across realistic graph/event volumes.","status":"planned","relations":[{"predicate":"tests","target":"tool:postgresql"},{"predicate":"tests","target":"algorithm:event-projection"}],"verification":[{"method":"Database benchmark + fault tests","target":"experiments/persistence","status":"planned","note":"Compare normalized relational structures with denormalized/materialized projections; preserve rebuild correctness."}]},
    {"@id":"experiment:distributed-faults","@type":["Experiment"],"name":"Distributed Coordinator Fault Simulation","summary":"Simulate partitions, latency, connection loss, duplicate messages, stale leases, coordinator failover, and uncertain acknowledgements before distributed deployment.","status":"later-foundation","relations":[{"predicate":"tests","target":"tool:turmoil"},{"predicate":"tests","target":"algorithm:frontier-cas"},{"predicate":"tests","target":"algorithm:lease-arbitration"}],"verification":[{"method":"Turmoil deterministic simulation","target":"experiments/distributed","status":"planned","note":"Distribution must not be introduced before single-node state semantics are stable."}]},
    {"@id":"experiment:admission-mutation","@type":["Experiment"],"name":"Admission Safety Mutation Suite","summary":"Deliberately remove/negate conflict, freshness, verification, reconciliation, or authorization checks and require the executable test suite to detect every safety regression.","status":"required-foundation","relations":[{"predicate":"tests","target":"algorithm:candidate-admission"},{"predicate":"groundedIn","target":"foundation:mutation-testing"}],"verification":[{"method":"cargo-mutants + targeted manual mutants","target":"experiments/admission-mutation","status":"planned"}]}
  ]
