  "@graph": [
    {"@id":"experiment:foundation-benchmarks","@type":["Experiment"],"name":"Foundation Algorithm Benchmark Matrix","summary":"Benchmark graph validation, traversal, critical-path, scheduling, evidence lookup, and projection over representative and adversarial graph shapes before selecting optimized substrate algorithms.","status":"planned","relations":[{"predicate":"tests","target":"foundation:benchmarking"},{"predicate":"tests","target":"algorithm:kahn-toposort"},{"predicate":"tests","target":"algorithm:critical-path"},{"predicate":"informedBy","target":"source:georges-2007"}],"verification":[{"method":"Rust benchmark harness","target":"benches/foundation","status":"planned","note":"Must report graph size, edge density, critical-path ratio, allocations/memory, CPU/wall time, and scaling shape."}],"url":"https://github.com/kmosoti/gordian/issues/5"},
    {"@id":"experiment:scheduler-benchmarks","@type":["Experiment"],"name":"Scheduler Baseline and Optimization Benchmark","summary":"Compare FIFO/greedy ready-queue scheduling, critical-path priority, HEFT-inspired heterogeneous scheduling, and future policies on synthetic and repository-derived DAGs under heterogeneous worker costs/capabilities.","status":"planned","relations":[{"predicate":"tests","target":"algorithm:greedy-list-scheduler"},{"predicate":"tests","target":"algorithm:heft-scheduler"},{"predicate":"tests","target":"foundation:critical-path"},{"predicate":"tests","target":"foundation:rcpsp"},{"predicate":"informedBy","target":"source:kolisch-hartmann-2006","note":"PSPLIB evaluation protocol for scheduling heuristics."}],"verification":[{"method":"Rust benchmark + simulation","target":"experiments/scheduler-benchmarks/","status":"planned","note":"Measure makespan, critical-path overhead, scheduler CPU/allocation cost, resource utilization, verification/retry cost, and robustness under estimation error."}],"url":"https://github.com/kmosoti/gordian/issues/24"},
    {"@id":"experiment:mission-ontology","@type":["Experiment"],"name":"Mission Graph Ontology Ablation","summary":"Compare simpler task/issue structures with Mission/PlanRevision/Initiative/Atom/Quark decomposition under controlled engineering work to measure ambiguity, planning overhead, replan churn, dependency accuracy, and outcome quality.","status":"planned","relations":[{"predicate":"tests","target":"hypothesis:mission-ontology-useful"},{"predicate":"tests","target":"concept:mission"},{"predicate":"tests","target":"concept:plan-revision"},{"predicate":"informedBy","target":"source:miller-2024","note":"Resampling, clustered standard errors and paired comparison per docs/testing/statistical-contract.md."}],"verification":[{"method":"Controlled experiment","target":"experiments/mission-ontology/","status":"planned","note":"A result showing no material benefit after overhead should cause ontology simplification."}],"url":"https://github.com/kmosoti/gordian/issues/50"},
    {"@id":"experiment:atom-granularity","@type":["Experiment"],"name":"Atom Scheduling Boundary Ablation","summary":"Compare coarse work units, Atom-local Quarks, and globally fine-grained primitives to determine useful scheduling granularity and black-box boundary cost.","status":"planned","relations":[{"predicate":"tests","target":"hypothesis:atom-boundary-optimality"},{"predicate":"tests","target":"concept:atom"},{"predicate":"tests","target":"concept:quark"},{"predicate":"informedBy","target":"source:miller-2024","note":"Resampling, clustered standard errors and paired comparison per docs/testing/statistical-contract.md."}],"verification":[{"method":"Benchmark + controlled task ablation","target":"experiments/atom-granularity/","status":"planned","note":"Measure exposed parallelism, coordination nodes/events, integration failures, plan churn, verifier cost, and completion time."}],"url":"https://github.com/kmosoti/gordian/issues/51"},
    {"@id":"experiment:semantic-conflict-prediction","@type":["Experiment"],"name":"Semantic Conflict Prediction Study","summary":"Compare path overlap, module/package ownership, semantic resource claims, and combined predictors against observed textual, compile/type, test/behavior, schema/config, and no-conflict integration outcomes.","status":"planned","relations":[{"predicate":"tests","target":"hypothesis:semantic-claims-better"},{"predicate":"tests","target":"algorithm:semantic-conflict-admission"},{"predicate":"tests","target":"algorithm:scope-reconciliation"},{"predicate":"informedBy","target":"source:miller-2024","note":"Resampling, clustered standard errors and paired comparison per docs/testing/statistical-contract.md."},{"predicate":"informedBy","target":"source:owhadi-kareshk-2019","note":"Supplies the published predictor-quality baseline P2 that a semantic-claim predictor must beat."},{"predicate":"informedBy","target":"source:guimaraes-2012","note":"Supplies the continuous-background-merge baseline P1 and its detection-latency measure."}],"verification":[{"method":"Paired conflict-classification experiment","target":"experiments/semantic-conflict-prediction/","status":"planned","note":"Measure precision, recall, false serialization, missed conflict cost, declaration/observation overhead, and net completion cost."}],"url":"https://github.com/kmosoti/gordian/issues/52"},
    {"@id":"experiment:isolation-coordination-ablation","@type":["Experiment"],"name":"Isolation and Coordination Ablation","summary":"Hold task/model/verifier budgets constant while comparing solo execution, isolated parallel workers, isolated workers plus shared task state, and isolated workers plus semantic coordination.","status":"planned","relations":[{"predicate":"tests","target":"claim:semantic-state-vs-code-state"},{"predicate":"tests","target":"algorithm:coordination-plane"},{"predicate":"informedBy","target":"source:miller-2024","note":"Resampling, clustered standard errors and paired comparison per docs/testing/statistical-contract.md."}],"verification":[{"method":"Repeated paired agent trials","target":"experiments/isolation-coordination-ablation/","status":"planned","note":"Measure success, abandonment, integration repair, conflicts, wall time, model/tool cost, verifier failures, and run variance."}],"url":"https://github.com/kmosoti/gordian/issues/39"},
    {"@id":"experiment:snapshot-vs-rebase","@type":["Experiment"],"name":"Stable Snapshot versus Continuous Rebase","summary":"Compare worker execution against one exact base with periodically rebased active work while stratifying by task duration and accepted-frontier change rate.","status":"planned","relations":[{"predicate":"tests","target":"hypothesis:snapshot-better-than-rebase"},{"predicate":"tests","target":"algorithm:snapshot-execution"},{"predicate":"informedBy","target":"source:miller-2024","note":"Resampling, clustered standard errors and paired comparison per docs/testing/statistical-contract.md."}],"verification":[{"method":"Controlled agent experiment","target":"experiments/snapshot-vs-rebase/","status":"planned","note":"Measure reasoning invalidation/restarts, discarded work, integration conflict, candidate quality, wall time, and cost."}],"url":"https://github.com/kmosoti/gordian/issues/53"},
    {"@id":"experiment:jj-baseline","@type":["Experiment"],"name":"Supported Jujutsu Baseline Qualification","summary":"Establish the minimum supported Jujutsu release and verify required workspace/change/commit/conflict/tag behavior plus jj-run command and read-only-flag presence against executable fixtures before building the adapter; Atom #33 owns jj-run execution semantics.","status":"registered","relations":[{"predicate":"tests","target":"tool:jujutsu"},{"predicate":"tests","target":"algorithm:jj-revision-verification"},{"predicate":"informedBy","target":"source:jj-changelog"}],"verification":[{"method":"CLI contract tests","target":"experiments/jj-baseline/manifest.json","status":"passing","note":"The committed manifest records a successful disposable-repository suite against the pin in scripts/bootstrap-jj.sh (DEFAULT_JJ_VERSION), which remains the single source of that version. The experiment stays registered until result ingestion exists and maps its fixed-n benchmark report into a Result node."}],"url":"https://github.com/kmosoti/gordian/issues/1"},
    {"@id":"experiment:jj-vs-git","@type":["Experiment"],"name":"Jujutsu versus Git Orchestration Experiment","summary":"Hold Mission Graph, workers, scheduler, workload, and verifier constant while comparing equivalent Jujutsu and Git workspace/change orchestration.","status":"planned","relations":[{"predicate":"tests","target":"hypothesis:jj-worth-complexity"},{"predicate":"tests","target":"algorithm:jj-workspace-spawn"},{"predicate":"tests","target":"tool:git"},{"predicate":"tests","target":"tool:jujutsu"},{"predicate":"informedBy","target":"source:miller-2024","note":"Resampling, clustered standard errors and paired comparison per docs/testing/statistical-contract.md."}],"verification":[{"method":"Differential orchestration benchmark","target":"experiments/jj-vs-git/","status":"planned","note":"Measure orchestration LOC/state transitions, identity mistakes, recovery operations, integration failures, evidence invalidation mistakes, and operator interventions."}],"url":"https://github.com/kmosoti/gordian/issues/34"},
    {"@id":"experiment:evidence-mutation","@type":["Experiment"],"name":"Evidence Mutation and Staleness Fault Suite","summary":"Verify a passing evidence record becomes unusable when each relevant fingerprint component is changed one at a time or transitively invalidated.","status":"planned","relations":[{"predicate":"tests","target":"algorithm:evidence-compatibility"},{"predicate":"tests","target":"claim:exact-artifact-verification"},{"predicate":"tests","target":"assumption:fingerprint-completeness"}],"verification":[{"method":"Property + mutation + integration tests","target":"experiments/evidence-mutation/","status":"planned","note":"Mutate commit, spec, direct/transitive input, environment, verifier, and canonicalization identities."}],"url":"https://github.com/kmosoti/gordian/issues/15"},
    {"@id":"experiment:integration-composition","@type":["Experiment"],"name":"Integration Non-Compositionality Suite","summary":"Construct candidate pairs that pass independently but fail after composition to ensure Gordian creates and verifies an explicit integration candidate.","status":"planned","relations":[{"predicate":"tests","target":"concept:integration-candidate"},{"predicate":"tests","target":"algorithm:jj-candidate-integration"}],"verification":[{"method":"Fixture corpus + property tests","target":"experiments/integration-composition/","status":"planned","note":"Include API contract, schema, config, resource, and test-only interactions with no textual merge conflict."}],"url":"https://github.com/kmosoti/gordian/issues/32"},
    {"@id":"experiment:authorization-engine","@type":["Experiment"],"name":"Capability Policy and Cedar Evaluation","summary":"Compare a minimal internal capability evaluator with Cedar for expressiveness, analyzability, latency, policy complexity, formal assurance, and operational dependencies.","status":"planned","relations":[{"predicate":"tests","target":"tool:cedar"},{"predicate":"tests","target":"concept:capability"},{"predicate":"tests","target":"assumption:role-enforcement"},{"predicate":"informedBy","target":"source:birgisson-2014"}],"verification":[{"method":"Threat model + benchmark + property tests","target":"experiments/authorization-engine/","status":"planned","note":"Adopt Cedar only if its assurance/expressiveness advantage justifies runtime/dependency cost."}],"url":"https://github.com/kmosoti/gordian/issues/18"},
    {"@id":"experiment:lease-faults","@type":["Experiment"],"name":"Lease and Fencing Fault Exploration","summary":"Explore overlapping requests, delayed expiry, paused stale workers, reordered messages, retries, and fencing-token enforcement across exclusive semantic-resource leases.","status":"planned","relations":[{"predicate":"tests","target":"concept:lease"},{"predicate":"tests","target":"algorithm:lease-arbitration"},{"predicate":"tests","target":"theorem:lease-exclusion"}],"verification":[{"method":"Lean + Loom + Shuttle + fault injection","target":"experiments/lease-faults/","status":"planned","note":"Formal transition invariant plus executable concurrency exploration."}],"url":"https://github.com/kmosoti/gordian/issues/23"},
    {"@id":"experiment:frontier-races","@type":["Experiment"],"name":"Accepted Frontier Race and Lost-Update Suite","summary":"Inject simultaneous coordinator promotions, stale expected frontiers, retry after uncertain result, and duplicate promotion commands.","status":"planned","relations":[{"predicate":"tests","target":"algorithm:frontier-cas"},{"predicate":"tests","target":"concept:accepted-frontier"}],"verification":[{"method":"State-machine + concurrency tests","target":"experiments/frontier-races/","status":"planned","note":"No test schedule may silently overwrite a newer accepted frontier."}],"url":"https://github.com/kmosoti/gordian/issues/19"},
    {"@id":"experiment:replay-faults","@type":["Experiment"],"name":"Replay Determinism and Event Fault Suite","summary":"Destroy/rebuild projections and inject duplicate, reordered, missing, unknown-version, and partially committed event scenarios.","status":"planned","relations":[{"predicate":"tests","target":"algorithm:event-projection"},{"predicate":"tests","target":"assumption:pure-projector"}],"verification":[{"method":"Generated state-machine traces + fault injection","target":"experiments/replay-faults/","status":"planned","note":"Canonical projection rebuild must match persisted canonical state for valid histories; invalid histories must reject/normalize explicitly."}],"url":"https://github.com/kmosoti/gordian/issues/28"},
    {"@id":"experiment:derived-vs-mutable-state","@type":["Experiment"],"name":"Derived State versus Mutable Status","summary":"Compare canonical-fact-derived readiness/blocking/satisfaction with manually mutated workflow statuses under failures, candidate rewrites, delayed events, and dependency changes.","status":"planned","relations":[{"predicate":"tests","target":"hypothesis:derived-state-reduces-staleness"},{"predicate":"tests","target":"algorithm:reconciliation"},{"predicate":"informedBy","target":"source:miller-2024","note":"Resampling, clustered standard errors and paired comparison per docs/testing/statistical-contract.md."}],"verification":[{"method":"Controlled state divergence simulation","target":"experiments/derived-vs-mutable-state/","status":"planned","note":"Measure stale divergence, correction count, time-to-detect, and incorrect scheduling decisions."}],"url":"https://github.com/kmosoti/gordian/issues/54"},
    {"@id":"experiment:lean-rust-conformance","@type":["Experiment"],"name":"Lean/Rust Semantic Differential Testing","summary":"Generate raw graph nodes and edges for the seeded HardDependenciesAcyclic predicate, evaluate both the executable Lean model and #4's deterministic Rust reference algorithm, and persist and shrink any mismatch. The bounded seed is owned by #7; a full semantic conformance suite is later work.","status":"planned","relations":[{"predicate":"tests","target":"algorithm:differential-conformance"},{"predicate":"tests","target":"foundation:formal-refinement"}],"verification":[{"method":"Differential randomized testing","target":"formal/conformance","status":"planned","note":"Passing is evidence of correspondence for HardDependenciesAcyclic, not a refinement theorem. The runner/generator is `crates/gordian-core/tests/conformance.rs`; the conformance tree and G-204 are owned by #7."}],"url":"https://github.com/kmosoti/gordian/issues/7"},
    {"@id":"experiment:formal-value","@type":["Experiment"],"name":"Formal Methods Value Study","summary":"Track defects found uniquely by proof development, DRT, PBT, model checking, mutation testing, and ordinary tests together with engineering/maintenance cost.","status":"planned","relations":[{"predicate":"tests","target":"hypothesis:formalization-pays"},{"predicate":"tests","target":"tool:lean4"},{"predicate":"informedBy","target":"source:klein-2009"}],"verification":[{"method":"Longitudinal defect/cost ledger","target":"experiments/formal-value/","status":"planned","note":"Formalization expands only when measured value or safety criticality justifies it."}],"url":"https://github.com/kmosoti/gordian/issues/60"},
    {"@id":"experiment:verification-stack","@type":["Experiment"],"name":"Verification Technique Coverage Study","summary":"Seed representative defects and determine which layers catch them: type system, unit/PBT, mutation, fuzz, Kani, Loom/Shuttle, Lean, DRT, integration, and fault simulation.","status":"planned","relations":[{"predicate":"tests","target":"tool:kani"},{"predicate":"tests","target":"tool:cargo-fuzz"},{"predicate":"tests","target":"tool:cargo-mutants"}],"verification":[{"method":"Seeded defect matrix","target":"experiments/verification-stack/","status":"planned","note":"Avoid using every tool by default; retain techniques that cover named defect classes cost-effectively."}],"url":"https://github.com/kmosoti/gordian/issues/6"},
    {"@id":"experiment:knowledge-graph-benchmarks","@type":["Experiment"],"name":"Knowledge Graph Scale and Query Benchmarks","summary":"Benchmark shard loading, validation, audit, traversal, evidence neighborhood, shortest path, and export over synthetic research graphs as corpus size grows.","status":"planned","relations":[{"predicate":"tests","target":"algorithm:knowledge-index"},{"predicate":"tests","target":"tool:petgraph"},{"predicate":"informedBy","target":"source:mytkowicz-2009"}],"verification":[{"method":"Rust benchmark suite","target":"benches/knowledge-graph","status":"planned","note":"Compare current adjacency-list index with simpler maps and alternative graph representations before committing to a backend."}],"url":"https://github.com/kmosoti/gordian/issues/61"},
    {"@id":"experiment:artifact-store","@type":["Experiment"],"name":"Artifact Content Addressing Validation","summary":"Test digest identity, deduplication, relocation, corruption detection, metadata lookup, and garbage-collection behavior for evidence payloads.","status":"planned","relations":[{"predicate":"tests","target":"algorithm:content-address-store"}],"verification":[{"method":"Property + integration benchmark","target":"experiments/artifact-store/","status":"planned"}],"url":"https://github.com/kmosoti/gordian/issues/14"},
    {"@id":"experiment:persistence-benchmarks","@type":["Experiment"],"name":"Persistence and Projection Benchmark","summary":"Measure PostgreSQL event append, transactional frontier updates, recursive dependency queries, projection rebuild, and evidence lookup across realistic graph/event volumes.","status":"planned","relations":[{"predicate":"tests","target":"tool:postgresql"},{"predicate":"tests","target":"algorithm:event-projection"}],"verification":[{"method":"Database benchmark + fault tests","target":"experiments/persistence-benchmarks/","status":"planned","note":"Compare normalized relational structures with denormalized/materialized projections; preserve rebuild correctness."}],"url":"https://github.com/kmosoti/gordian/issues/25"},
    {"@id":"experiment:distributed-faults","@type":["Experiment"],"name":"Distributed Coordinator Fault Simulation","summary":"Simulate partitions, latency, connection loss, duplicate messages, stale leases, coordinator failover, and uncertain acknowledgements before distributed deployment.","status":"planned","relations":[{"predicate":"tests","target":"tool:turmoil"},{"predicate":"tests","target":"algorithm:frontier-cas"},{"predicate":"tests","target":"algorithm:lease-arbitration"}],"verification":[{"method":"Turmoil deterministic simulation","target":"experiments/distributed-faults/","status":"planned","note":"Distribution must not be introduced before single-node state semantics are stable."}],"url":"https://github.com/kmosoti/gordian/issues/42"},
    {"@id":"experiment:admission-mutation","@type":["Experiment"],"name":"Admission Safety Mutation Suite","summary":"Deliberately remove/negate conflict, freshness, verification, reconciliation, or authorization checks and require the executable test suite to detect every safety regression.","status":"planned","relations":[{"predicate":"tests","target":"algorithm:candidate-admission"},{"predicate":"groundedIn","target":"foundation:mutation-testing"}],"verification":[{"method":"cargo-mutants + targeted manual mutants","target":"experiments/admission-mutation/","status":"planned"}],"url":"https://github.com/kmosoti/gordian/issues/19"},
    {"@id":"experiment:compositional-verifier-inheritance","@type":["Experiment"],"name":"Compositional Verifier Inheritance Classification","summary":"Measure how often a verifier declared compositional passes a component candidate and then fails, or would have failed, on the integration candidate containing it. The compositional flag is the only mechanism by which batch admission avoids re-running every verifier on every member, and it is an author's assertion rather than a proof.","status":"planned","relations":[{"predicate":"tests","target":"assumption:compositional-verifier-inheritance"},{"predicate":"tests","target":"algorithm:candidate-admission"},{"predicate":"tests","target":"concept:integration-candidate"},{"predicate":"informedBy","target":"source:miller-2024"}],"verification":[{"method":"Classification experiment","target":"experiments/compositional-verifier-inheritance/","status":"planned","note":"class: classification. Any inherited-pass-with-integration-failure rate above 1 percent removes the compositional flag, per docs/testing/statistical-contract.md."}],"url":"https://github.com/kmosoti/gordian/issues/16"}
  ]
}
