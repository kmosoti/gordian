  "@graph": [
    {"@id":"algorithm:kahn-toposort","@type":["Algorithm"],"name":"Kahn Topological Validation","summary":"Linear-time DAG validation/topological ordering using in-degrees and a ready queue; #4's deterministic reference algorithm for raw hard-dependency nodes and edges and the foundation conformance seed.","status":"specified","statement":"Reject the hard dependency graph when fewer than all nodes can be removed from zero-in-degree frontier processing.","relations":[{"predicate":"groundedIn","target":"foundation:topological-order"},{"predicate":"implementedBy","target":"artifact:mission-core"},{"predicate":"benchmarkedBy","target":"experiment:foundation-benchmarks"},{"predicate":"testedBy","target":"experiment:lean-rust-conformance"},{"predicate":"supportedBy","target":"source:kahn-1962"}],"verification":[]},
    {"@id":"algorithm:critical-path","@type":["Algorithm"],"name":"Critical Path Computation","summary":"Dynamic programming over a topologically ordered DAG to compute longest weighted precedence path and per-node slack/rank signals.","status":"planned","statement":"Compute a lower bound on Mission completion from dependency-constrained task durations independent of worker count.","relations":[{"predicate":"groundedIn","target":"foundation:critical-path"},{"predicate":"usedBy","target":"algorithm:greedy-list-scheduler"},{"predicate":"usedBy","target":"algorithm:heft-scheduler"},{"predicate":"benchmarkedBy","target":"experiment:scheduler-benchmarks"},{"predicate":"supportedBy","target":"source:kelley-walker-1959"}],"verification":[]},
    {"@id":"algorithm:greedy-list-scheduler","@type":["Algorithm"],"name":"Greedy Ready-Queue List Scheduler","summary":"Simple baseline repeatedly assigns ready Atoms to available compatible workers using an explicit priority policy; retained as a correctness/performance oracle rather than assumed final scheduler.","status":"planned","statement":"Produce a valid dependency-respecting schedule under resource/capability constraints using a deterministic ready queue.","relations":[{"predicate":"groundedIn","target":"foundation:list-scheduling"},{"predicate":"groundedIn","target":"foundation:rcpsp"},{"predicate":"contrastsWith","target":"algorithm:heft-scheduler"},{"predicate":"benchmarkedBy","target":"experiment:scheduler-benchmarks"},{"predicate":"supportedBy","target":"source:graham-1966"},{"predicate":"supportedBy","target":"source:kwok-ahmad-1999"}],"verification":[]},
    {"@id":"algorithm:heft-scheduler","@type":["Algorithm"],"name":"HEFT-Inspired Heterogeneous Scheduler","summary":"Research scheduler baseline using upward rank and earliest finish estimates across heterogeneous workers/capabilities/costs; adapted carefully because agent success probability and verification cost differ from compute-task duration.","status":"planned","statement":"Prioritize dependency-critical Atoms and assign compatible heterogeneous workers by expected finish/cost estimates under a deterministic safety envelope.","relations":[{"predicate":"groundedIn","target":"foundation:heft"},{"predicate":"uses","target":"algorithm:critical-path"},{"predicate":"contrastsWith","target":"algorithm:greedy-list-scheduler"},{"predicate":"testedBy","target":"experiment:scheduler-benchmarks"},{"predicate":"supportedBy","target":"source:heft-2002"}],"verification":[]},
    {"@id":"algorithm:semantic-conflict-admission","@type":["Algorithm"],"name":"Semantic Conflict Admission","summary":"Conservative concurrency admission over declared semantic read/write sets plus hard dependency order, with observed scope expansion forcing re-evaluation.","status":"specified","statement":"Admit i and j concurrently only if no hard order exists and each write set is disjoint from the other's declared reads/writes under the selected resource model.","relations":[{"predicate":"groundedIn","target":"foundation:conflict-serializability"},{"predicate":"uses","target":"concept:semantic-claim"},{"predicate":"formalizedBy","target":"theorem:declared-noninterference-symmetric"},{"predicate":"testedBy","target":"experiment:semantic-conflict-prediction"},{"predicate":"qualifiedBy","target":"source:lessenich-2018","note":"No developer-proposed conflict indicator predicted conflicts usefully across 163 repositories; a declaration-based admission rule inherits that risk."}],"verification":[]},
    {"@id":"algorithm:scope-reconciliation","@type":["Algorithm"],"name":"Declared/Observed Scope Reconciliation","summary":"Compares instrumented resource/file/interface observations to an Atom's declared scope and emits scope-expansion facts when new accesses appear.","status":"planned","statement":"D_observed should be contained within policy-authorized D_declared; unexpected writes trigger re-admission before promotion.","relations":[{"predicate":"groundedIn","target":"source:bazel-dependencies"},{"predicate":"uses","target":"concept:semantic-claim"},{"predicate":"produces","target":"concept:scope-expansion"},{"predicate":"testedBy","target":"experiment:semantic-conflict-prediction"}],"verification":[]},
    {"@id":"algorithm:snapshot-execution","@type":["Algorithm"],"name":"Snapshot-Isolated Worker Execution","summary":"Assigns an exact immutable base to a worker workspace, avoids implicit continuous rebasing, then reconciles the frozen candidate against current accepted state at integration.","status":"specified","statement":"Worker reasoning occurs against an exact source snapshot; staleness is handled explicitly at candidate integration.","relations":[{"predicate":"groundedIn","target":"foundation:occ"},{"predicate":"groundedIn","target":"foundation:snapshot-isolation"},{"predicate":"implementedBy","target":"tool:jujutsu"},{"predicate":"testedBy","target":"experiment:snapshot-vs-rebase"}],"verification":[]},
    {"@id":"algorithm:coordination-plane","@type":["Algorithm"],"name":"Shared Semantic Coordination Plane","summary":"Publishes work ownership, claims, interfaces, readiness, scope changes, candidate events, and conflicts without granting workers unconstrained shared source mutation.","status":"planned","statement":"Workers coordinate through small explicit shared facts while retaining isolated mutable source state.","relations":[{"predicate":"uses","target":"concept:semantic-claim"},{"predicate":"uses","target":"concept:event"},{"predicate":"testedBy","target":"experiment:isolation-coordination-ablation"},{"predicate":"groundedIn","target":"source:smith-1980","note":"Contract Net supplies the announce/bid/award/commit structure; Gordian adds evidence-bound admission, which Contract Net has no counterpart for."},{"predicate":"qualifiedBy","target":"source:lesser-2004"}],"verification":[]},
    {"@id":"algorithm:lease-arbitration","@type":["Algorithm"],"name":"Lease and Fencing Arbitration","summary":"Grants scoped read/write leases over semantic resources, rejects incompatible concurrent grants, and uses monotonically increasing fencing tokens where downstream enforcement exists.","status":"planned","statement":"Exclusive resource grants cannot overlap in valid logical time and stale holders are rejected by newer fencing identity.","relations":[{"predicate":"groundedIn","target":"foundation:leases"},{"predicate":"groundedIn","target":"foundation:fencing-tokens"},{"predicate":"formalizedBy","target":"theorem:lease-exclusion"},{"predicate":"testedBy","target":"experiment:lease-faults"},{"predicate":"supportedBy","target":"source:gray-cheriton-1989"},{"predicate":"supportedBy","target":"source:kleppmann-2016"}],"verification":[]},
    {"@id":"algorithm:evidence-compatibility","@type":["Algorithm"],"name":"Evidence Compatibility and Freshness","summary":"Checks exact candidate, specification, resolved input/dependency, environment, verifier, and canonicalization identities before evidence can satisfy an acceptance predicate.","status":"specified","statement":"Any relevant identity mismatch makes the evidence incompatible with the current subject.","relations":[{"predicate":"groundedIn","target":"foundation:hermeticity"},{"predicate":"groundedIn","target":"foundation:attestation"},{"predicate":"formalizedBy","target":"theorem:evidence-commit-mismatch"},{"predicate":"testedBy","target":"experiment:evidence-mutation"}],"verification":[]},
    {"@id":"algorithm:candidate-admission","@type":["Algorithm"],"name":"Candidate Admission","summary":"Accepts only candidates reconciled with current frontier, conflict-free, completely verified with fresh evidence, and promoted by an authorized actor.","status":"specified","statement":"Acceptance is a proof-carrying safety boundary over exact facts, not a mutable Done status.","relations":[{"predicate":"uses","target":"algorithm:evidence-compatibility"},{"predicate":"uses","target":"algorithm:frontier-cas"},{"predicate":"formalizedBy","target":"theorem:accepted-conflict-free"},{"predicate":"formalizedBy","target":"theorem:worker-cannot-promote"},{"predicate":"testedBy","target":"experiment:admission-mutation"}],"verification":[]},
    {"@id":"algorithm:frontier-cas","@type":["Algorithm"],"name":"Accepted Frontier Compare-and-Swap","summary":"Promotes a candidate only if the accepted frontier still equals the version/candidate against which reconciliation and admission were evaluated.","status":"planned","statement":"CAS(frontier, expected, candidate) fails rather than overwriting a concurrently advanced frontier.","relations":[{"predicate":"groundedIn","target":"foundation:cas"},{"predicate":"testedBy","target":"experiment:frontier-races"},{"predicate":"groundedIn","target":"source:herlihy-1991"},{"predicate":"contrastsWith","target":"source:lamport-1998","note":"A single lease-holding coordinator plus compare-and-swap replaces replicated consensus here; the tradeoff is admission throughput against mechanism size."}],"verification":[]},
    {"@id":"algorithm:event-projection","@type":["Algorithm"],"name":"Deterministic Event Projection","summary":"Pure projection of canonical ordered events into query state; external effects are represented by recorded results rather than invoked during replay.","status":"specified","statement":"For the same deterministic projector and equal event history, canonical projection is equal.","relations":[{"predicate":"groundedIn","target":"foundation:deterministic-replay"},{"predicate":"formalizedBy","target":"theorem:replay-equal-history"},{"predicate":"testedBy","target":"experiment:replay-faults"},{"predicate":"groundedIn","target":"source:helland-2016"}],"verification":[]},
    {"@id":"algorithm:reconciliation","@type":["Algorithm"],"name":"Mission Reconciliation","summary":"Compares Mission Graph obligations against evidence-supported observed state and derives satisfied, execution, verification, repair, replanning, blocked, or await-observation outcomes.","status":"specified","statement":"The next action is derived from planned/observed delta rather than hand-edited workflow status.","relations":[{"predicate":"uses","target":"concept:planned-world"},{"predicate":"uses","target":"concept:observed-world"},{"predicate":"uses","target":"algorithm:event-projection"},{"predicate":"testedBy","target":"experiment:derived-vs-mutable-state"}],"verification":[]},
    {"@id":"algorithm:jj-workspace-spawn","@type":["Algorithm"],"name":"Jujutsu Workspace Spawn","summary":"Creates an isolated Jujutsu workspace at an exact base and associates one logical change identity with one executing Atom/attempt.","status":"planned","statement":"One normal-path worker owns one mutable logical change in one isolated workspace from an exact base.","relations":[{"predicate":"groundedIn","target":"source:jj-docs"},{"predicate":"implementedBy","target":"tool:jujutsu"},{"predicate":"testedBy","target":"experiment:jj-vs-git"}],"verification":[]},
    {"@id":"algorithm:jj-candidate-integration","@type":["Algorithm"],"name":"Jujutsu Candidate Integration","summary":"Builds an explicit integration state over selected independent candidate parents rather than linearizing unrelated work, then runs integration verification.","status":"planned","statement":"Independent change topology is preserved until explicit integration; unresolved conflicts remain intermediate states and cannot be accepted.","relations":[{"predicate":"groundedIn","target":"source:jj-conflicts"},{"predicate":"groundedIn","target":"source:jj-docs"},{"predicate":"testedBy","target":"experiment:integration-composition"},{"predicate":"qualifiedBy","target":"source:apel-2011","note":"Semistructured merge removes a class of spurious conflicts that first-class conflicted commits still surface, so Jujutsu's conflict representation is not the strongest available merge semantics."}],"verification":[]},
    {"@id":"algorithm:jj-revision-verification","@type":["Algorithm"],"name":"Jujutsu Revision Verification","summary":"Uses exact revision materialization and, on supported Jujutsu releases, jj run to execute verification over isolated private working copies.","status":"planned","statement":"Verification commands execute against exact immutable revision identities and return evidence bound to those identities.","relations":[{"predicate":"groundedIn","target":"source:jj-changelog"},{"predicate":"implementedBy","target":"tool:jujutsu"},{"predicate":"testedBy","target":"experiment:jj-baseline"}],"verification":[]},
    {"@id":"algorithm:content-address-store","@type":["Algorithm"],"name":"Content-Addressed Artifact Storage","summary":"Stores immutable evidence/artifact payloads by digest while relational metadata records logical names, media type, provenance, and subject bindings.","status":"planned","statement":"Artifact identity is stable under relocation and duplicate content can share storage identity.","relations":[{"predicate":"groundedIn","target":"foundation:content-addressing"},{"predicate":"groundedIn","target":"foundation:merkle-dag"},{"predicate":"testedBy","target":"experiment:artifact-store"},{"predicate":"groundedIn","target":"source:mokhov-2018"}],"verification":[]},
    {"@id":"algorithm:differential-conformance","@type":["Algorithm"],"name":"Lean/Rust Differential Conformance Testing","summary":"Generate raw graph nodes and edges for the seeded HardDependenciesAcyclic predicate, evaluate the executable Lean model and the Rust reference implementation from #4, and compare exactly. The #7 harness is scoped to this seed with an injected disagreement; a general conformance relation over the whole substrate is not in scope.","status":"planned","statement":"A mismatch between model and Rust implementation fails the conformance check; passing randomized tests is strong evidence but not universal refinement proof.","relations":[{"predicate":"groundedIn","target":"foundation:differential-random-testing"},{"predicate":"groundedIn","target":"foundation:verification-guided-development"},{"predicate":"testedBy","target":"experiment:lean-rust-conformance"},{"predicate":"groundedIn","target":"source:cedar-vgd-fse-2024"},{"predicate":"contrastsWith","target":"source:wilcox-2015"}],"verification":[]},
    {"@id":"algorithm:knowledge-index","@type":["Algorithm"],"name":"Typed Research Graph Index","summary":"Deterministically merges JSON-LD shards into a validated directed graph with indexed identities, traversal, shortest paths, evidence queries, statistics, epistemic audits, and export.","status":"implemented","statement":"Every graph edge targets an existing node and epistemic node classes satisfy minimum provenance/test/checker metadata rules.","relations":[{"predicate":"implementedBy","target":"artifact:gordian-kg"},{"predicate":"uses","target":"tool:petgraph"},{"predicate":"benchmarkedBy","target":"experiment:knowledge-graph-benchmarks"}],"verification":[]}
  ]
}
