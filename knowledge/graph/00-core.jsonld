  "@graph": [
    {"@id":"concept:mission-graph","@type":["Concept"],"name":"Mission Graph","summary":"Semantic control plane for desired engineering state, decomposition, causal prerequisites, contracts, constraints, and acceptance.","status":"research-core","relations":[{"predicate":"contains","target":"concept:mission"},{"predicate":"contains","target":"concept:plan-revision"},{"predicate":"contains","target":"concept:initiative"},{"predicate":"contains","target":"concept:atom"},{"predicate":"contains","target":"concept:quark"},{"predicate":"groundedIn","target":"foundation:htn"},{"predicate":"groundedIn","target":"foundation:pocl"},{"predicate":"specifiedBy","target":"artifact:mission-spec"}],"verification":[]},
    {"@id":"concept:change-graph","@type":["Concept"],"name":"Change Graph","summary":"Source-state DAG containing evolving logical changes and exact immutable candidates, normally represented by Jujutsu.","status":"research-core","relations":[{"predicate":"implementedBy","target":"tool:jujutsu"},{"predicate":"contrastsWith","target":"concept:mission-graph"},{"predicate":"specifiedBy","target":"artifact:jj-protocol"}],"verification":[]},
    {"@id":"concept:execution-history","@type":["Concept"],"name":"Execution History","summary":"Concrete attempts, effects, leases, outcomes, and observations of actors attempting work.","status":"research-core","relations":[{"predicate":"contains","target":"concept:execution-attempt"},{"predicate":"contains","target":"concept:event"},{"predicate":"groundedIn","target":"foundation:deterministic-replay"}],"verification":[]},
    {"@id":"concept:evidence-graph","@type":["Concept"],"name":"Evidence Graph","summary":"Evidence, artifacts, provenance, attestations, verifier identity, and compatibility relationships used to justify acceptance.","status":"research-core","relations":[{"predicate":"contains","target":"concept:evidence"},{"predicate":"contains","target":"concept:artifact"},{"predicate":"contains","target":"concept:attestation"},{"predicate":"groundedIn","target":"foundation:provenance"},{"predicate":"groundedIn","target":"foundation:attestation"}],"verification":[]},
    {"@id":"concept:authority-model","@type":["Concept"],"name":"Authority Model","summary":"Capability model separating private work execution, accepted-frontier promotion, and deployment authority.","status":"research-core","relations":[{"predicate":"contains","target":"concept:capability"},{"predicate":"groundedIn","target":"foundation:capability-security"},{"predicate":"formalizedBy","target":"theorem:worker-cannot-promote"},{"predicate":"formalizedBy","target":"theorem:coordinator-cannot-deploy"}],"verification":[]},
    {"@id":"concept:project","@type":["Concept"],"name":"Project","summary":"Persistent namespace/system boundary associating Missions, repositories, knowledge, policies, environments, and releases.","status":"specified","relations":[{"predicate":"contains","target":"concept:mission"}],"verification":[]},
    {"@id":"concept:mission","@type":["Concept"],"name":"Mission","summary":"Stable desired-state contract defined by goal, constraints, and acceptance independent of one implementation strategy.","status":"specified","relations":[{"predicate":"decomposesInto","target":"concept:plan-revision"},{"predicate":"groundedIn","target":"foundation:htn"},{"predicate":"testedBy","target":"experiment:mission-ontology"}],"verification":[]},
    {"@id":"concept:plan-revision","@type":["Concept"],"name":"PlanRevision","summary":"Immutable strategy/decomposition proposal targeting a Mission specification while preserving prior plans and rationale.","status":"specified","relations":[{"predicate":"decomposesInto","target":"concept:initiative"},{"predicate":"groundedIn","target":"foundation:htn"},{"predicate":"groundedIn","target":"foundation:pocl"}],"verification":[]},
    {"@id":"concept:initiative","@type":["Concept"],"name":"Initiative","summary":"Compound capability or subgoal with its own acceptance contract, decomposed into schedulable Atoms.","status":"specified","relations":[{"predicate":"decomposesInto","target":"concept:atom"},{"predicate":"groundedIn","target":"foundation:htn"}],"verification":[]},
    {"@id":"concept:atom","@type":["Concept"],"name":"Atom","summary":"Smallest globally schedulable and independently verifiable work contract in the current Gordian design.","status":"hypothesis-backed-spec","relations":[{"predicate":"decomposesInto","target":"concept:quark"},{"predicate":"executedAs","target":"concept:execution-attempt"},{"predicate":"uses","target":"concept:verifier-manifest"},{"predicate":"uses","target":"concept:semantic-claim"},{"predicate":"testedBy","target":"experiment:atom-granularity"},{"predicate":"formalizedBy","target":"theorem:dispatch-requires-dependencies"}],"verification":[]},
    {"@id":"concept:quark","@type":["Concept"],"name":"Quark","summary":"Executor-local primitive inside one Atom; intentionally hidden from global hard-dependency scheduling.","status":"hypothesis-backed-spec","relations":[{"predicate":"formalizedBy","target":"theorem:quark-not-global-target"},{"predicate":"testedBy","target":"experiment:atom-granularity"}],"verification":[]},
    {"@id":"concept:execution-attempt","@type":["Concept"],"name":"ExecutionAttempt","summary":"One concrete actor attempt against an exact base to realize an Atom or Quark; outcome belongs to the attempt, not the work specification.","status":"specified","relations":[{"predicate":"produces","target":"concept:candidate"},{"predicate":"produces","target":"concept:event"},{"predicate":"uses","target":"concept:effect-class"},{"predicate":"projectsTo","target":"foundation:provenance"}],"verification":[]},
    {"@id":"concept:candidate","@type":["Concept"],"name":"Candidate","summary":"Frozen exact implementation subject handed to verification; source mutation after freeze creates a different candidate identity.","status":"specified","relations":[{"predicate":"uses","target":"concept:change-graph"},{"predicate":"produces","target":"concept:evidence"},{"predicate":"formalizedBy","target":"theorem:evidence-commit-mismatch"},{"predicate":"testedBy","target":"experiment:evidence-mutation"}],"verification":[]},
    {"@id":"concept:integration-candidate","@type":["Concept"],"name":"Integration Candidate","summary":"Distinct candidate composing multiple source candidates; receives independent integration verification because component success is not generally compositional.","status":"specified","relations":[{"predicate":"refines","target":"concept:candidate"},{"predicate":"testedBy","target":"experiment:integration-composition"},{"predicate":"motivatedBy","target":"claim:posthoc-integration-risk"}],"verification":[]},
    {"@id":"concept:artifact","@type":["Concept"],"name":"Artifact","summary":"Immutable or identity-addressed entity consumed or produced by an activity, such as source state, binary, report, schema, or model output.","status":"specified","relations":[{"predicate":"groundedIn","target":"foundation:content-addressing"},{"predicate":"projectsTo","target":"foundation:provenance"}],"verification":[]},
    {"@id":"concept:evidence","@type":["Concept"],"name":"Evidence","summary":"Observation relevant to an acceptance predicate and bound to the exact identities declared relevant by its verifier policy.","status":"specified","relations":[{"predicate":"uses","target":"concept:artifact"},{"predicate":"uses","target":"concept:verifier-manifest"},{"predicate":"groundedIn","target":"foundation:provenance"},{"predicate":"groundedIn","target":"foundation:attestation"},{"predicate":"formalizedBy","target":"theorem:evidence-commit-mismatch"}],"verification":[]},
    {"@id":"concept:attestation","@type":["Concept"],"name":"Attestation","summary":"Authenticated claim about an exact subject/activity/material set; establishes provenance of a claim, not truth by signature alone.","status":"specified","relations":[{"predicate":"groundedIn","target":"foundation:attestation"},{"predicate":"projectsTo","target":"source:in-toto"},{"predicate":"projectsTo","target":"source:slsa"}],"verification":[]},
    {"@id":"concept:event","@type":["Concept"],"name":"Event","summary":"Immutable historical fact used by deterministic projection and provenance; carries identity, causal references, actor, subject, and payload.","status":"specified","relations":[{"predicate":"usedBy","target":"algorithm:event-projection"},{"predicate":"groundedIn","target":"foundation:deterministic-replay"}],"verification":[]},
    {"@id":"concept:actor","@type":["Concept"],"name":"Actor","summary":"Human, software agent, coordinator, or service responsible for an activity or claim.","status":"specified","relations":[{"predicate":"projectsTo","target":"foundation:provenance"},{"predicate":"uses","target":"concept:capability"}],"verification":[]},
    {"@id":"concept:capability","@type":["Concept"],"name":"Capability","summary":"Positive authority grant scoped to an actor, action, resource, and optionally time/fencing context.","status":"specified","relations":[{"predicate":"groundedIn","target":"foundation:capability-security"},{"predicate":"implementedBy","target":"tool:cedar"},{"predicate":"testedBy","target":"experiment:authorization-engine"}],"verification":[]},
    {"@id":"concept:lease","@type":["Concept"],"name":"Lease","summary":"Time-bounded coordination grant over a semantic resource; exclusive writes should use fencing where stale actors can outlive expiry.","status":"specified","relations":[{"predicate":"groundedIn","target":"foundation:leases"},{"predicate":"groundedIn","target":"foundation:fencing-tokens"},{"predicate":"testedBy","target":"experiment:lease-faults"},{"predicate":"formalizedBy","target":"theorem:lease-exclusion-planned"}],"verification":[]},
    {"@id":"concept:semantic-resource","@type":["Concept"],"name":"Semantic Resource","summary":"Domain-level resource or interface such as type, API, schema, config key, crate, artifact, or service used for coordination beyond filenames.","status":"experimental","relations":[{"predicate":"usedBy","target":"concept:semantic-claim"},{"predicate":"testedBy","target":"experiment:semantic-conflict-prediction"}],"verification":[]},
    {"@id":"concept:semantic-claim","@type":["Concept"],"name":"Semantic Read/Write Claim","summary":"Declared read, write, provide, or require relation over semantic resources used as a scheduling prediction rather than proof.","status":"experimental","relations":[{"predicate":"uses","target":"concept:semantic-resource"},{"predicate":"usedBy","target":"algorithm:semantic-conflict-admission"},{"predicate":"motivatedBy","target":"claim:interface-contracts"},{"predicate":"testedBy","target":"experiment:semantic-conflict-prediction"}],"verification":[]},
    {"@id":"concept:accepted-frontier","@type":["Concept"],"name":"Accepted Frontier","summary":"Authority-controlled source state admitted as current accepted reality after reconciliation, conflict checks, verification, freshness, and authorization.","status":"specified","relations":[{"predicate":"controlledBy","target":"algorithm:candidate-admission"},{"predicate":"controlledBy","target":"algorithm:frontier-cas"},{"predicate":"formalizedBy","target":"theorem:accepted-conflict-free"},{"predicate":"formalizedBy","target":"theorem:worker-cannot-promote"}],"verification":[]},
    {"@id":"concept:deployment-frontier","@type":["Concept"],"name":"Deployment Frontier","summary":"Separate record of what immutable release/artifact is actually deployed; source acceptance does not imply deployment.","status":"specified","relations":[{"predicate":"contrastsWith","target":"concept:accepted-frontier"},{"predicate":"formalizedBy","target":"theorem:coordinator-cannot-deploy"}],"verification":[]},
    {"@id":"concept:projection","@type":["Concept"],"name":"Projection","summary":"Rebuildable query-oriented state deterministically derived from canonical event/history facts.","status":"specified","relations":[{"predicate":"implementedBy","target":"algorithm:event-projection"},{"predicate":"formalizedBy","target":"theorem:replay-equal-history"}],"verification":[]},
    {"@id":"concept:planned-world","@type":["Concept"],"name":"Planned World","summary":"Mission Graph obligations and desired acceptable state, distinct from observed evidence-supported reality.","status":"architecture-core","relations":[{"predicate":"representedBy","target":"concept:mission-graph"},{"predicate":"contrastsWith","target":"concept:observed-world"}],"verification":[]},
    {"@id":"concept:observed-world","@type":["Concept"],"name":"Observed World","summary":"Current evidence-supported state reconstructed from execution, artifacts, observations, and provenance.","status":"architecture-core","relations":[{"predicate":"representedBy","target":"concept:evidence-graph"},{"predicate":"contrastsWith","target":"concept:planned-world"}],"verification":[]},
    {"@id":"concept:acceptance-predicate","@type":["Concept"],"name":"Acceptance Predicate","summary":"Explicit evaluable condition determining whether compatible evidence justifies satisfaction of a work objective.","status":"specified","relations":[{"predicate":"uses","target":"concept:evidence"},{"predicate":"implementedBy","target":"algorithm:evidence-compatibility"}],"verification":[]},
    {"@id":"concept:verifier-manifest","@type":["Concept"],"name":"Verifier Manifest","summary":"Declared set and aggregation rule of verifier obligations required for a specification/candidate.","status":"specified","relations":[{"predicate":"uses","target":"concept:acceptance-predicate"},{"predicate":"uses","target":"concept:evidence"}],"verification":[]},
    {"@id":"concept:effect-class","@type":["Concept"],"name":"Effect Class","summary":"Classification of execution as pure, hermetic, external read, idempotent write, compensatable write, irreversible, or judgment to govern retry/replay.","status":"specified","relations":[{"predicate":"groundedIn","target":"foundation:idempotency"},{"predicate":"groundedIn","target":"foundation:deterministic-replay"}],"verification":[]},
    {"@id":"concept:scope-expansion","@type":["Concept"],"name":"Scope Expansion","summary":"Observed access or effect outside a work contract's declared semantic scope, triggering conflict and admission re-evaluation.","status":"specified","relations":[{"predicate":"uses","target":"concept:semantic-claim"},{"predicate":"implementedBy","target":"algorithm:scope-reconciliation"}],"verification":[]},
    {"@id":"concept:reconciliation","@type":["Concept"],"name":"Reconciliation","summary":"Closed-loop comparison of planned obligations with justified observed state to choose execution, verification, repair, replanning, blocking, or satisfaction.","status":"architecture-core","relations":[{"predicate":"uses","target":"concept:planned-world"},{"predicate":"uses","target":"concept:observed-world"},{"predicate":"implementedBy","target":"algorithm:reconciliation"}],"verification":[]},
    {"@id":"concept:provenance","@type":["Concept"],"name":"Provenance","summary":"Trace of entities, activities, actors, materials, derivations, and responsibility supporting inspectable engineering history.","status":"specified","relations":[{"predicate":"groundedIn","target":"foundation:provenance"},{"predicate":"projectsTo","target":"source:w3c-prov"}],"verification":[]},
    {"@id":"concept:replan","@type":["Concept"],"name":"Replanning","summary":"Creation/selection of a new PlanRevision when evidence shows the current strategy is unsuitable while preserving Mission identity and historical provenance.","status":"specified","relations":[{"predicate":"uses","target":"concept:plan-revision"},{"predicate":"groundedIn","target":"foundation:htn"},{"predicate":"groundedIn","target":"foundation:pocl"}],"verification":[]}
  ]
