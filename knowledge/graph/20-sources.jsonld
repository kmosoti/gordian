  "@graph": [
    {"@id":"source:htn-survey","@type":["Source","ScientificFoundation"],"name":"HTN planning: Overview, comparison, and beyond","summary":"Georgievski and Aiello survey of hierarchical task network planning, decomposition methods, task networks, ordering, and comparison to classical planning.","status":"peer-reviewed","url":"https://doi.org/10.1016/j.artint.2015.02.002","source_kind":"paper","authors":"Georgievski, Aiello","year":2015,"venue_or_publisher":"Artificial Intelligence 222","identifier":"10.1016/j.artint.2015.02.002","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:weld-1994","@type":["Source","ScientificFoundation"],"name":"An Introduction to Least Commitment Planning","summary":"Weld's tutorial account of partial-order causal-link planning, presenting SNLP (McAllester and Rosenblitt 1991) and UCPOP (Penberthy and Weld 1992) as the primary POCL algorithms, together with causal links, threats, and promotion/demotion. Replaces the removed planning-literature placeholder node, whose URL returned HTTP 404 on 2026-08-30.","status":"peer-reviewed","url":"https://doi.org/10.1609/aimag.v15i4.1109","source_kind":"paper","authors":"Weld","year":1994,"venue_or_publisher":"AI Magazine 15(4)","identifier":"10.1609/aimag.v15i4.1109","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:bercher-2019","@type":["Source","Review"],"name":"A Survey on Hierarchical Planning - One Abstract Idea, Many Concrete Realizations","summary":"Bercher, Alford and Hoeller survey hierarchical planning formalisms and their combination with partial-order causal-link reasoning, covering hybrid HTN/POCL problem classes and their complexity.","status":"peer-reviewed","url":"https://doi.org/10.24963/ijcai.2019/875","source_kind":"paper","authors":"Bercher, Alford, Hoeller","year":2019,"venue_or_publisher":"IJCAI 2019","identifier":"10.24963/ijcai.2019/875","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:hoare-1969","@type":["Source","ScientificFoundation"],"name":"An Axiomatic Basis for Computer Programming","summary":"Hoare's foundational work on reasoning with preconditions and postconditions.","status":"peer-reviewed","url":"https://doi.org/10.1145/363235.363259","source_kind":"paper","authors":"Hoare","year":1969,"venue_or_publisher":"Communications of the ACM 12(10)","identifier":"10.1145/363235.363259","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:occ-1981","@type":["Source","ScientificFoundation"],"name":"On Optimistic Methods for Concurrency Control","summary":"Kung and Robinson's classic optimistic concurrency work motivating private execution followed by validation/commit rather than continuous global mutation.","status":"peer-reviewed","url":"https://doi.org/10.1145/319566.319567","source_kind":"paper","authors":"Kung, Robinson","year":1981,"venue_or_publisher":"ACM Transactions on Database Systems 6(2)","identifier":"10.1145/319566.319567","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:berenson-1995","@type":["Source","ScientificFoundation"],"name":"A Critique of ANSI SQL Isolation Levels","summary":"Berenson, Bernstein, Gray, Melton, O'Neil and O'Neil define snapshot isolation and show that the ANSI phenomena do not characterise the isolation levels they name; the primary source for foundation:snapshot-isolation.","status":"peer-reviewed","url":"https://doi.org/10.1145/223784.223785","source_kind":"paper","authors":"Berenson, Bernstein, Gray, Melton, O'Neil, O'Neil","year":1995,"venue_or_publisher":"SIGMOD 1995","identifier":"10.1145/223784.223785","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:bernstein-goodman-1981","@type":["Source","ScientificFoundation"],"name":"Concurrency Control in Distributed Database Systems","summary":"Bernstein and Goodman's survey of serializability theory, conflict graphs and multi-version concurrency control; the primary source for foundation:mvcc and foundation:conflict-serializability.","status":"peer-reviewed","url":"https://doi.org/10.1145/356842.356846","source_kind":"paper","authors":"Bernstein, Goodman","year":1981,"venue_or_publisher":"ACM Computing Surveys 13(2)","identifier":"10.1145/356842.356846","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:garcia-molina-salem-1987","@type":["Source","ScientificFoundation"],"name":"Sagas","summary":"Garcia-Molina and Salem's long-lived transaction model with compensating transactions; the origin of the compensatable-write effect class.","status":"peer-reviewed","url":"https://doi.org/10.1145/38713.38742","source_kind":"paper","authors":"Garcia-Molina, Salem","year":1987,"venue_or_publisher":"SIGMOD 1987","identifier":"10.1145/38713.38742","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:kahn-1962","@type":["Source","ScientificFoundation"],"name":"Topological sorting of large networks","summary":"Kahn's in-degree frontier algorithm for topologically sorting a directed network; the algorithm algorithm:kahn-toposort implements and the primary source for foundation:dag and foundation:topological-order.","status":"peer-reviewed","url":"https://doi.org/10.1145/368996.369025","source_kind":"paper","authors":"Kahn","year":1962,"venue_or_publisher":"Communications of the ACM 5(11)","identifier":"10.1145/368996.369025","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:kelley-walker-1959","@type":["Source","ScientificFoundation"],"name":"Critical-path planning and scheduling","summary":"Kelley and Walker's original critical-path method: longest weighted precedence path as a completion lower bound and slack as a priority signal.","status":"peer-reviewed","url":"https://doi.org/10.1145/1460299.1460318","source_kind":"paper","authors":"Kelley, Walker","year":1959,"venue_or_publisher":"Eastern Joint IRE-AIEE-ACM Computer Conference 1959","identifier":"10.1145/1460299.1460318","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:graham-1966","@type":["Source","ScientificFoundation"],"name":"Bounds for Certain Multiprocessing Anomalies","summary":"Graham's list-scheduling analysis giving the (2 - 1/m) makespan bound and the scheduling anomalies that follow from priority-list choice.","status":"peer-reviewed","url":"https://doi.org/10.1002/j.1538-7305.1966.tb01709.x","source_kind":"paper","authors":"Graham","year":1966,"venue_or_publisher":"Bell System Technical Journal 45(9)","identifier":"10.1002/j.1538-7305.1966.tb01709.x","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:graham-1969","@type":["Source","ScientificFoundation"],"name":"Bounds on Multiprocessing Timing Anomalies","summary":"Graham's extension of the list-scheduling bounds, including the effect of changing task times, processor counts and precedence constraints.","status":"peer-reviewed","url":"https://doi.org/10.1137/0117039","source_kind":"paper","authors":"Graham","year":1969,"venue_or_publisher":"SIAM Journal on Applied Mathematics 17(2)","identifier":"10.1137/0117039","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:brent-1974","@type":["Source","ScientificFoundation"],"name":"The Parallel Evaluation of General Arithmetic Expressions","summary":"Brent's work/span bound: a computation with work T1 and span Tinf runs in T1/p + Tinf on p processors; the analytical basis for measuring available parallelism rather than agent count.","status":"peer-reviewed","url":"https://doi.org/10.1145/321812.321815","source_kind":"paper","authors":"Brent","year":1974,"venue_or_publisher":"Journal of the ACM 21(2)","identifier":"10.1145/321812.321815","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:work-stealing-1999","@type":["Source","ScientificFoundation"],"name":"Scheduling Multithreaded Computations by Work Stealing","summary":"Blumofe and Leiserson analysis of randomized work stealing with expected execution-time and space bounds for fully strict computations.","status":"peer-reviewed","url":"https://doi.org/10.1145/324133.324234","source_kind":"paper","authors":"Blumofe, Leiserson","year":1999,"venue_or_publisher":"Journal of the ACM 46(5)","identifier":"10.1145/324133.324234","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:heft-2002","@type":["Source","ScientificFoundation"],"name":"Performance-Effective and Low-Complexity Task Scheduling for Heterogeneous Computing","summary":"Topcuoglu, Hariri and Wu introduce HEFT and CPOP for scheduling weighted DAGs across heterogeneous processors using upward rank and earliest-finish heuristics. Replaces the former HEFT node, whose DOI returned HTTP 404 on 2026-08-30 and whose recorded year was wrong by three years.","status":"peer-reviewed","url":"https://doi.org/10.1109/71.993206","source_kind":"paper","authors":"Topcuoglu, Hariri, Wu","year":2002,"venue_or_publisher":"IEEE Transactions on Parallel and Distributed Systems 13(3)","identifier":"10.1109/71.993206","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:kwok-ahmad-1999","@type":["Source","Review"],"name":"Static scheduling algorithms for allocating directed task graphs to multiprocessors","summary":"Kwok and Ahmad's taxonomy and comparative evaluation of static DAG scheduling heuristics, the reference survey for list-scheduling baselines.","status":"peer-reviewed","url":"https://doi.org/10.1145/344588.344618","source_kind":"paper","authors":"Kwok, Ahmad","year":1999,"venue_or_publisher":"ACM Computing Surveys 31(4)","identifier":"10.1145/344588.344618","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:gerasoulis-yang-1993","@type":["Source","ScientificFoundation"],"name":"On the granularity and clustering of directed acyclic task graphs","summary":"Gerasoulis and Yang analyse task-graph granularity and clustering, giving the grain-size condition under which clustering does not degrade the schedule.","status":"peer-reviewed","url":"https://doi.org/10.1109/71.242154","source_kind":"paper","authors":"Gerasoulis, Yang","year":1993,"venue_or_publisher":"IEEE Transactions on Parallel and Distributed Systems 4(6)","identifier":"10.1109/71.242154","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:yang-gerasoulis-1994","@type":["Source","ScientificFoundation"],"name":"DSC: Scheduling Parallel Tasks on an Unbounded Number of Processors","summary":"Yang and Gerasoulis's dominant-sequence clustering algorithm; quantifies the parallel-time cost of coarsening task granularity and so bounds what a coarser scheduling unit can gain.","status":"peer-reviewed","url":"https://doi.org/10.1109/71.308533","source_kind":"paper","authors":"Yang, Gerasoulis","year":1994,"venue_or_publisher":"IEEE Transactions on Parallel and Distributed Systems 5(9)","identifier":"10.1109/71.308533","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:brucker-1999","@type":["Source","Review"],"name":"Resource-constrained project scheduling: notation, classification, models, and methods","summary":"Brucker, Drexl, Moehring, Neumann and Pesch's classification of RCPSP models, the standard notation and hardness results. Replaces the former RCPSP node, which carried no authors, a title belonging to no work, and a DOI that returned HTTP 404 on 2026-08-30.","status":"peer-reviewed","url":"https://doi.org/10.1016/S0377-2217(98)00204-5","source_kind":"paper","authors":"Brucker, Drexl, Moehring, Neumann, Pesch","year":1999,"venue_or_publisher":"European Journal of Operational Research 112(1)","identifier":"10.1016/S0377-2217(98)00204-5","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:kolisch-hartmann-2006","@type":["Source","Review"],"name":"Experimental investigation of heuristics for resource-constrained project scheduling: An update","summary":"Kolisch and Hartmann's controlled comparison of RCPSP heuristics on the PSPLIB instance sets; the reference protocol for evaluating a scheduling heuristic against a common baseline.","status":"peer-reviewed","url":"https://doi.org/10.1016/j.ejor.2005.01.065","source_kind":"paper","authors":"Kolisch, Hartmann","year":2006,"venue_or_publisher":"European Journal of Operational Research 174(1)","identifier":"10.1016/j.ejor.2005.01.065","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:workflow-soundness","@type":["Source","ScientificFoundation"],"name":"Soundness of Workflow Nets: Classification, Decidability, and Analysis","summary":"Formal workflow-net research on proper completion, dead transitions, soundness classes, and analysis using Petri nets.","status":"peer-reviewed","url":"https://doi.org/10.1007/s00165-010-0161-4","source_kind":"paper","authors":"van der Aalst, van Hee, ter Hofstede, Sidorova, Verbeek, Voorhoeve, Wynn","year":2011,"venue_or_publisher":"Formal Aspects of Computing 23(3)","identifier":"10.1007/s00165-010-0161-4","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:murata-1989","@type":["Source","ScientificFoundation"],"name":"Petri nets: Properties, analysis and applications","summary":"Murata's reference survey of Petri-net structure, reachability, liveness, boundedness and analysis techniques; workflow nets are a subclass of the model defined here.","status":"peer-reviewed","url":"https://doi.org/10.1109/5.24143","source_kind":"paper","authors":"Murata","year":1989,"venue_or_publisher":"Proceedings of the IEEE 77(4)","identifier":"10.1109/5.24143","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:lamport-1978","@type":["Source","ScientificFoundation"],"name":"Time, Clocks, and the Ordering of Events in a Distributed System","summary":"Lamport's happened-before relation and logical clocks; the origin of the causal-reference structure carried by concept:event.","status":"peer-reviewed","url":"https://doi.org/10.1145/359545.359563","source_kind":"paper","authors":"Lamport","year":1978,"venue_or_publisher":"Communications of the ACM 21(7)","identifier":"10.1145/359545.359563","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:lamport-1998","@type":["Source","ScientificFoundation"],"name":"The Part-Time Parliament","summary":"Lamport's Paxos consensus protocol; the reference model for a replicated linearizable decision sequence, and the alternative Gordian's single admitting coordinator declines in favour of a lease plus compare-and-swap.","status":"peer-reviewed","url":"https://doi.org/10.1145/279227.279229","source_kind":"paper","authors":"Lamport","year":1998,"venue_or_publisher":"ACM Transactions on Computer Systems 16(2)","identifier":"10.1145/279227.279229","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:ongaro-2014","@type":["Source","ScientificFoundation"],"name":"In Search of an Understandable Consensus Algorithm (Raft)","summary":"Ongaro and Ousterhout's Raft consensus algorithm with an explicit leader and log; the standard implementable alternative to a single-coordinator lease for linearizing frontier promotion. USENIX proceedings papers carry no DOI, so the identifier is the stable USENIX presentation URL.","status":"peer-reviewed","url":"https://www.usenix.org/conference/atc14/technical-sessions/presentation/ongaro","source_kind":"paper","authors":"Ongaro, Ousterhout","year":2014,"venue_or_publisher":"USENIX ATC 2014","identifier":"https://www.usenix.org/conference/atc14/technical-sessions/presentation/ongaro","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:burrows-2006","@type":["Source","EngineeringFoundation"],"name":"The Chubby lock service for loosely-coupled distributed systems","summary":"Burrows's account of Chubby: coarse-grained locks with sequencers, the production system whose sequencer design fencing tokens generalise. USENIX proceedings papers carry no DOI, so the identifier is the stable USENIX proceedings URL.","status":"peer-reviewed","url":"https://www.usenix.org/legacy/event/osdi06/tech/burrows.html","source_kind":"paper","authors":"Burrows","year":2006,"venue_or_publisher":"USENIX OSDI 2006","identifier":"https://www.usenix.org/legacy/event/osdi06/tech/burrows.html","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:gray-cheriton-1989","@type":["Source","ScientificFoundation"],"name":"Leases: An Efficient Fault-Tolerant Mechanism for Distributed File Cache Consistency","summary":"Gray and Cheriton introduce the lease: a time-bounded right whose expiry bounds the blocking a failed holder can cause. The primary source for foundation:leases.","status":"peer-reviewed","url":"https://doi.org/10.1145/74850.74870","source_kind":"paper","authors":"Gray, Cheriton","year":1989,"venue_or_publisher":"SOSP 1989","identifier":"10.1145/74850.74870","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:kleppmann-2016","@type":["Source","EngineeringFoundation"],"name":"How to do distributed locking","summary":"Kleppmann's analysis of why a lease alone is insufficient when a stale holder resumes after a pause, and the fencing-token construction that lets the downstream resource reject it. The primary source for foundation:fencing-tokens.","status":"documentation","url":"https://martin.kleppmann.com/2016/02/08/how-to-do-distributed-locking.html","source_kind":"documentation","maintainer_or_publisher":"Martin Kleppmann","version_or_commit_or_edition":"revision of 2016-02-08","canonical_url":"https://martin.kleppmann.com/2016/02/08/how-to-do-distributed-locking.html","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:herlihy-1991","@type":["Source","ScientificFoundation"],"name":"Wait-Free Synchronization","summary":"Herlihy's consensus hierarchy establishing compare-and-swap as a universal primitive; the reason a conditional frontier update is expressible without consensus machinery.","status":"peer-reviewed","url":"https://doi.org/10.1145/114005.102808","source_kind":"paper","authors":"Herlihy","year":1991,"venue_or_publisher":"ACM Transactions on Programming Languages and Systems 13(1)","identifier":"10.1145/114005.102808","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:shapiro-2011","@type":["Source","ScientificFoundation"],"name":"Conflict-Free Replicated Data Types","summary":"Shapiro, Preguica, Baquero and Zawirski define CRDTs and prove strong eventual consistency for state- and operation-based replicas. The primary source for foundation:crdt, and the source of its scope limit: convergence of the replicated representation, not of program meaning.","status":"peer-reviewed","url":"https://doi.org/10.1007/978-3-642-24550-3_29","source_kind":"paper","authors":"Shapiro, Preguica, Baquero, Zawirski","year":2011,"venue_or_publisher":"SSS 2011, LNCS 6976","identifier":"10.1007/978-3-642-24550-3_29","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:helland-2012","@type":["Source","EngineeringFoundation"],"name":"Idempotence Is Not a Medical Condition","summary":"Helland's treatment of at-least-once messaging and the conditions under which repeating an operation is safe; the primary source for foundation:idempotency and for the retry rules attached to concept:effect-class.","status":"peer-reviewed","url":"https://doi.org/10.1145/2181796.2187821","source_kind":"paper","authors":"Helland","year":2012,"venue_or_publisher":"ACM Queue 10(4)","identifier":"10.1145/2181796.2187821","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:helland-2016","@type":["Source","EngineeringFoundation"],"name":"Immutability Changes Everything","summary":"Helland's argument that append-only immutable facts make derived state rebuildable and history inspectable; Crossref records the issue as CACM 59(1), issued 2015-12-21. The primary source for concept:event and foundation:deterministic-replay.","status":"peer-reviewed","url":"https://doi.org/10.1145/2844112","source_kind":"paper","authors":"Helland","year":2016,"venue_or_publisher":"Communications of the ACM 59(1)","identifier":"10.1145/2844112","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:temporal","@type":["Source","EngineeringFoundation"],"name":"Temporal Durable Execution Documentation","summary":"Official Temporal documentation for deterministic workflow replay, durable event history, and separating replayable workflow logic from effectful Activities.","status":"documentation","url":"https://docs.temporal.io/","source_kind":"documentation","maintainer_or_publisher":"Temporal Technologies","version_or_commit_or_edition":"docs.temporal.io, latest","canonical_url":"https://docs.temporal.io/","retrieved_at":"2026-08-30","relations":[],"verification":[]},
    {"@id":"source:mokhov-2018","@type":["Source","ScientificFoundation"],"name":"Build Systems a la Carte","summary":"Mokhov, Mitchell and Peyton Jones factor build systems into a scheduler and a rebuilder and give the conditions for minimality and early cutoff. The theory Gordian's evidence fingerprint re-derives: a content-addressed key with a complete dependency set is exactly the rebuilder that supports early cutoff, and an incomplete one is not.","status":"peer-reviewed","url":"https://doi.org/10.1145/3236774","source_kind":"paper","authors":"Mokhov, Mitchell, Peyton Jones","year":2018,"venue_or_publisher":"ICFP 2018, PACMPL 2","identifier":"10.1145/3236774","retrieved_at":"2026-08-30","relations":[],"verification":[]},
