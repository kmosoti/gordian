    {"@id":"sourcerev:caid-v2","@type":["SourceRevision"],"name":"CAID arXiv:2603.21489v2","summary":"Current cited version of source:caid. arXiv:2603.21489v2, submitted 2026-07-08, retrieved 2026-08-30. Reports +25.6 absolute on PaperBench and +14.7 on Commit0, and in Table 3 reports worktree isolation 63.3 against soft isolation 55.5 on PaperBench and 59.1 against 56.1 on Commit0-Lite. Supersedes sourcerev:caid-v1.","status":"current","url":"https://arxiv.org/abs/2603.21489v2","source_id":"source:caid","version_label":"arXiv:2603.21489v2","revision_date":"2026-07-08","retrieved_at":"2026-08-30","immutable_locator":"arXiv:2603.21489v2, abstract and Table 3","content_digest":"","relations":[{"predicate":"supersedes","target":"sourcerev:caid-v1"},{"predicate":"partOf","target":"source:caid","note":"Current cited revision v2 of this source."}],"verification":[]},
