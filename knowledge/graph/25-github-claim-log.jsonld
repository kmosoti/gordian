      "@id": "algorithm:github-claim-log-cas",
      "@type": ["Algorithm"],
      "name": "GitHub Claim-Log Compare-and-Swap",
      "summary": "Append-only claim events represented by empty Git commits and linearized by create-once or force=false fast-forward reference mutation.",
      "status": "specified",
      "statement": "A claim or release becomes authoritative only when its event commit is accepted as the next head of refs/heads/gordian-claim-log; readers validate every event to an accepted-main root, and conflicting writers reread and converge or lose without projection writes.",
      "relations": [
        {"predicate": "informedBy", "target": "sourcerev:github-rest-git-refs-2026-08-31"},
        {"predicate": "informedBy", "target": "sourcerev:github-rest-git-commits-2026-08-31"},
        {"predicate": "implementedBy", "target": "artifact:python-orchestration"}
      ],
      "verification": []
    },
    {
      "@id": "algorithm:github-legacy-claim-adoption",
      "@type": ["Algorithm"],
      "name": "GitHub Legacy Claim Adoption",
      "summary": "One-time, fail-closed migration of Atom 70's validated legacy claim projection into the canonical claim log.",
      "status": "specified",
      "statement": "Adoption is permitted only when GORDIAN_ACTOR exactly matches the sole live server-time legacy comment, the authenticated login is the issue's sole assignee, the issue is OPEN, Project 9 is In Progress, the canonical log has no Atom 70 lease, and the active-lease cap permits a normal CAS claim; the existing comment is then updated in place with canonical identifiers.",
      "relations": [
        {"predicate": "uses", "target": "algorithm:github-claim-log-cas"},
        {"predicate": "implementedBy", "target": "artifact:python-orchestration"},
        {"predicate": "relatedTo", "target": "decision:bootstrap-claim-log-cas"}
      ],
      "verification": []
    },
    {
      "@id": "decision:bootstrap-claim-log-cas",
      "@type": ["Decision"],
      "name": "Use a GitHub append-only ref as bootstrap claim authority",
      "summary": "The temporary bootstrap loop selects one global Git claim log rather than arbitrating leases from issue-comment timestamps, assignees, or Project status.",
      "status": "adopted",
      "statement": "Until native leases exist, claim state is the validated canonical JSON at the head of refs/heads/gordian-claim-log; GitHub issue and Project mutations are projections reconciled after the ref CAS. Same-actor idempotence applies only to live leases, stale leases require explicit release, projection cleanup is limited to mutations introduced by the current attempt, and Atom 70's legacy projection may be adopted exactly once under the dedicated fail-closed migration predicates.",
      "relations": [
        {"predicate": "uses", "target": "algorithm:github-claim-log-cas"},
        {"predicate": "informedBy", "target": "sourcerev:github-rest-git-refs-2026-08-31"},
        {"predicate": "informedBy", "target": "sourcerev:github-rest-git-commits-2026-08-31"},
