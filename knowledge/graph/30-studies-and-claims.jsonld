{
  "@graph": [
    {"@id":"claim:isolation-useful","@type":["Claim"],"name":"Isolated worker state is useful for concurrent agent engineering","summary":"CAID reports substantial gains over single-agent baselines using dependency-aware delegation, isolated workspaces, structured integration, and executable verification; isolation is one mechanism in a larger bundle rather than independently isolated by that experiment.","status":"evidence-supported-bounded","statement":"Isolated mutable source state is a credible component of concurrent agent engineering architectures.","relations":[{"predicate":"supportedBy","target":"source:caid"},{"predicate":"qualifiedBy","target":"source:storm"},{"predicate":"qualifiedBy","target":"source:agentroom"},{"predicate":"motivates","target":"algorithm:snapshot-execution"}],"verification":[]},
    {"@id":"claim:coordination-beyond-isolation","@type":["Claim"],"name":"Isolation alone is insufficient coordination","summary":"STORM reports gains over a worktree-based multi-agent baseline using explicit state management; AgentRoom's small ablations also attribute much of its benefit to coordination signals rather than CRDT merging alone.","status":"evidence-supported-not-universal","statement":"Concurrent coding agents benefit from explicit shared coordination/state beyond merely isolated workspaces in the studied settings.","relations":[{"predicate":"supportedBy","target":"source:storm"},{"predicate":"supportedBy","target":"source:agentroom"},{"predicate":"supportedBy","target":"source:caid"},{"predicate":"motivates","target":"concept:semantic-claim"},{"predicate":"motivates","target":"algorithm:coordination-plane"}],"verification":[]},
    {"@id":"claim:semantic-state-vs-code-state","@type":["Claim"],"name":"Code isolation and semantic coordination should be separate planes","summary":"Synthesis of CAID, STORM, AgentRoom, MVCC-style reasoning, and source-control constraints: workers can mutate isolated code snapshots while sharing explicit intent, claim, dependency, and interface state.","status":"engineering-deduction","statement":"Gordian should combine isolated code state with coordinated semantic state instead of either unconstrained shared mutation or coordination only at merge time.","relations":[{"predicate":"supportedBy","target":"source:caid"},{"predicate":"supportedBy","target":"source:storm"},{"predicate":"supportedBy","target":"source:agentroom"},{"predicate":"groundedIn","target":"foundation:mvcc"},{"predicate":"testedBy","target":"experiment:isolation-coordination-ablation"}],"verification":[]},
    {"@id":"claim:posthoc-integration-risk","@type":["Claim"],"name":"Post-hoc merge is a material integration risk for coding agents","summary":"AgenticFlict reports textual conflicts in 27.67 percent of more than 107K successfully merge-simulated agent PRs, making conflict handling non-negligible at scale.","status":"evidence-supported-textual-scope","statement":"Agent integration conflict occurs frequently enough that Gordian should treat integration and repair as first-class rather than a negligible tail event.","relations":[{"predicate":"supportedBy","target":"source:agenticflict"},{"predicate":"qualifiedBy","target":"claim:textual-not-semantic-conflict"},{"predicate":"motivates","target":"concept:integration-candidate"},{"predicate":"motivates","target":"algorithm:semantic-conflict-admission"}],"verification":[]},
    {"@id":"claim:textual-not-semantic-conflict","@type":["Claim"],"name":"Textual conflict rate is not semantic conflict rate","summary":"A clean text merge can still violate interfaces, schemas, invariants, or behavior, while overlapping text can sometimes be reconciled safely. AgenticFlict's reported rate therefore cannot be generalized to all semantic conflicts.","status":"logical-deduction","statement":"Textual merge-conflict observations are a lower-dimensional signal and not a direct estimate of total semantic incompatibility.","relations":[{"predicate":"supportedBy","target":"source:agenticflict"},{"predicate":"groundedIn","target":"foundation:semantic-convergence"},{"predicate":"motivates","target":"concept:semantic-resource"}],"verification":[]},
    {"@id":"claim:interface-contracts","@type":["Claim"],"name":"Interface and dependency contracts are useful pre-concurrency state","summary":"CodeTeam reports benefits from normalizing architecture into machine-checkable ownership, public-interface, and dependency constraints before concurrent implementation.","status":"evidence-supported-contextual","statement":"Making interfaces and dependency boundaries explicit before concurrent implementation is a credible coordination mechanism.","relations":[{"predicate":"supportedBy","target":"source:codeteam"},{"predicate":"motivates","target":"concept:semantic-claim"},{"predicate":"motivates","target":"concept:verifier-manifest"},{"predicate":"testedBy","target":"experiment:semantic-conflict-prediction"}],"verification":[]},
    {"@id":"claim:harness-reliability","@type":["Claim"],"name":"Coding-agent reliability is a harness/system property","summary":"The reliability synthesis emphasizes execution state, permissions, retrieval, memory, verification, observability, recovery, and resource allocation in addition to model capability.","status":"evidence-supported-synthesis","statement":"Gordian should place safety and correctness obligations in the execution substrate rather than depending on worker model judgment alone.","relations":[{"predicate":"supportedBy","target":"source:reliable-agents"},{"predicate":"motivates","target":"concept:authority-model"},{"predicate":"motivates","target":"concept:evidence-graph"},{"predicate":"motivates","target":"algorithm:candidate-admission"}],"verification":[]},
    {"@id":"claim:exact-artifact-verification","@type":["Claim"],"name":"Verification should bind to exact immutable subjects","summary":"Jujutsu preserves logical change identity through rewrites while exact commit identity changes; provenance/attestation systems likewise bind claims to exact subjects and materials.","status":"strong-engineering-deduction","statement":"Candidate verification must bind to exact commit/spec/input/environment/verifier identity rather than only a mutable logical work identity.","relations":[{"predicate":"groundedIn","target":"source:jj-docs"},{"predicate":"groundedIn","target":"source:in-toto"},{"predicate":"groundedIn","target":"source:slsa"},{"predicate":"formalizedBy","target":"theorem:evidence-commit-mismatch"},{"predicate":"testedBy","target":"experiment:evidence-mutation"}],"verification":[]},
    {"@id":"claim:change-id-commit-id-separation","@type":["Claim"],"name":"Logical change identity and exact verification identity must be separate","summary":"A Jujutsu change ID survives rewrites while a commit ID identifies one exact concrete state, providing a natural mapping from evolving implementation identity to immutable verification subject.","status":"verified-current-tool-semantics","statement":"Agents may operate on logical change identity while verification applies to exact commit identity.","relations":[{"predicate":"supportedBy","target":"source:jj-docs"},{"predicate":"motivates","target":"concept:candidate"},{"predicate":"motivates","target":"concept:evidence"}],"verification":[]},
    {"@id":"claim:jj-graph-causality","@type":["Claim"],"name":"Jujutsu graph topology should reflect causal dependency rather than finish order","summary":"Independent work can remain sibling changes; dependent work can use ancestry, and explicit integration can use multi-parent states. This avoids encoding chronology as causality.","status":"engineering-deduction","statement":"Gordian should not serialize independent Jujutsu changes merely because workers finish sequentially.","relations":[{"predicate":"groundedIn","target":"source:jj-docs"},{"predicate":"testedBy","target":"experiment:jj-vs-git"},{"predicate":"motivates","target":"algorithm:jj-candidate-integration"}],"verification":[]},
    {"@id":"claim:crdt-not-semantic-correctness","@type":["Claim"],"name":"CRDT convergence does not imply program semantic correctness","summary":"CRDTs can guarantee convergence of replicated state under their merge semantics, while incompatible program assumptions can remain after text/state convergence.","status":"logical-engineering-deduction","statement":"A converged shared source representation cannot substitute for semantic coordination and integration verification.","relations":[{"predicate":"groundedIn","target":"foundation:crdt"},{"predicate":"supportedBy","target":"source:agentroom"},{"predicate":"motivates","target":"concept:semantic-claim"}],"verification":[]},
    {"@id":"claim:deterministic-core-effectful-boundary","@type":["Claim"],"name":"Coordinator replay should be deterministic while effects are recorded externally","summary":"Durable-execution systems separate deterministic replayable orchestration from external effects. LLM calls, clocks, live network reads, and writes should become recorded activities/events rather than being repeated during replay.","status":"strong-engineering-foundation","statement":"Gordian's core projection/reconciliation semantics should be deterministic functions of recorded history, with nondeterministic effects at explicit boundaries.","relations":[{"predicate":"groundedIn","target":"source:temporal"},{"predicate":"formalizedBy","target":"theorem:replay-equal-history"},{"predicate":"testedBy","target":"experiment:replay-faults"}],"verification":[]},
    {"@id":"claim:derived-state-reduces-staleness","@type":["Hypothesis"],"name":"Derived workflow state reduces stale coordination","summary":"Ready, blocked, active, verifying, and satisfied derived from canonical dependencies/attempts/evidence should diverge less than manually maintained status fields.","status":"unvalidated","statement":"Derived state materially reduces stale-status coordination errors compared with mutable workflow status.","relations":[{"predicate":"testedBy","target":"experiment:derived-vs-mutable-state"},{"predicate":"groundedIn","target":"foundation:deterministic-replay"}],"verification":[]},
    {"@id":"claim:semantic-claims-better","@type":["Hypothesis"],"name":"Semantic resource claims improve conflict prediction","summary":"Domain resource/interface read-write claims may capture harmful cross-file coupling that path ownership misses, but declaration and observation overhead may erase the benefit.","status":"unvalidated","statement":"Semantic resource claims improve expected conflict-prediction utility over path-only ownership after accounting for maintenance cost.","relations":[{"predicate":"testedBy","target":"experiment:semantic-conflict-prediction"},{"predicate":"motivatedBy","target":"source:codeteam"},{"predicate":"motivatedBy","target":"source:agenticflict"}],"verification":[]},
    {"@id":"claim:snapshot-better-than-rebase","@type":["Hypothesis"],"name":"Stable snapshots outperform continuous active rebasing for agents","summary":"Stable exact source bases may reduce reasoning invalidation while increasing integration staleness; the net effect depends on task duration and frontier-change rate.","status":"unvalidated","statement":"Stable snapshot execution has lower total completion/repair cost than continuously rebasing active coding agents under representative concurrent workloads.","relations":[{"predicate":"testedBy","target":"experiment:snapshot-vs-rebase"},{"predicate":"groundedIn","target":"foundation:occ"},{"predicate":"supportedBy","target":"source:caid"},{"predicate":"qualifiedBy","target":"source:storm"}],"verification":[]},
    {"@id":"claim:atom-boundary-optimality","@type":["Hypothesis"],"name":"Atom is a useful global scheduling boundary","summary":"Keeping Quarks executor-local may preserve black-box modularity while Atoms remain independently schedulable/verifiable, but the boundary could be too coarse or too administratively expensive.","status":"unvalidated","statement":"Atom-level global scheduling exposes sufficient useful parallelism with lower coordination overhead than globally scheduling Quark-like primitives.","relations":[{"predicate":"testedBy","target":"experiment:atom-granularity"}],"verification":[]},
    {"@id":"claim:mission-ontology-useful","@type":["Hypothesis"],"name":"Mission decomposition ontology improves engineering coordination","summary":"Project, Mission, PlanRevision, Initiative, Atom, Quark may provide useful separation of objective, strategy, compound subgoal, schedulable contract, and local execution primitive.","status":"unvalidated","statement":"The Mission Graph decomposition vocabulary reduces ambiguity and coordination cost compared with simpler issue/task structures on representative work.","relations":[{"predicate":"testedBy","target":"experiment:mission-ontology"},{"predicate":"groundedIn","target":"foundation:htn"},{"predicate":"groundedIn","target":"foundation:pocl"}],"verification":[]},
    {"@id":"claim:jj-worth-complexity","@type":["Hypothesis"],"name":"Jujutsu materially simplifies Gordian source coordination","summary":"Jujutsu's change IDs, workspaces, operation log, first-class conflicts, revsets, and multi-parent changes may reduce orchestration complexity compared with careful Git worktrees/branches.","status":"unvalidated","statement":"A Jujutsu adapter produces materially lower coordination/recovery complexity or fewer identity/verification mistakes than an equivalent Git adapter.","relations":[{"predicate":"testedBy","target":"experiment:jj-vs-git"},{"predicate":"groundedIn","target":"source:jj-docs"}],"verification":[]},
    {"@id":"claim:formalization-pays","@type":["Hypothesis"],"name":"Formalizing substrate invariants catches meaningful defects at acceptable cost","summary":"Lean proofs plus executable-model differential testing may catch defects ordinary Rust testing misses, but proof maintenance may not justify itself for every subsystem.","status":"unvalidated","statement":"Verification-guided formalization has positive defect-detection value per engineering cost for Gordian's safety kernel.","relations":[{"predicate":"testedBy","target":"experiment:formal-value"},{"predicate":"supportedBy","target":"source:cedar-vgd"}],"verification":[]}
  ]
}
