    {
      "@id": "algorithm:snapshot-execution",
      "@type": ["Algorithm"],
      "name": "Snapshot-isolated execution",
      "summary": "Give each worker an exact immutable base and isolated Jujutsu workspace; handle staleness during integration rather than continuously rebasing active reasoning state.",
