    {
      "@id": "theorem:no-ranked-dependency-cycle",
      "@type": ["Theorem"],
      "name": "Rank-decreasing dependency graphs are acyclic",
      "summary": "If every hard dependency strictly decreases a natural-number rank, no node can depend transitively on itself.",
      "statement": "DependsPath g a a -> False, assuming each dependency edge strictly decreases rank.",
      "status": "proof-source-present",
      "relations": [
        {"predicate": "formalizes", "target": "concept:mission-graph"},
        {"predicate": "groundedIn", "target": "source:workflow-nets"}
      ],
      "verification": [
        {"method": "Lean4", "target": "formal/Gordian/Graph.lean#no_dependency_cycle", "status": "ci-required", "note": "Proof is relative to the rank-decrease premise."}
      ]
    },
    {
      "@id": "theorem:quark-boundary",
      "@type": ["Theorem"],
      "name": "Quarks are not global hard-dependency targets",
      "summary": "Under the v0 kind predicate, Quark is excluded from globally dependable work kinds.",
      "statement": "not GloballyDependable WorkKind.quark",
      "status": "proof-source-present",
      "relations": [
        {"predicate": "formalizes", "target": "concept:quark"}
      ],
      "verification": [
        {"method": "Lean4", "target": "formal/Gordian/Graph.lean#quark_not_globally_dependable", "status": "ci-required"}
      ]
    },
    {
      "@id": "theorem:dispatch-requires-dependencies",
      "@type": ["Theorem"],
      "name": "Dispatch requires dependency satisfaction",
      "summary": "Any Dispatchable witness contains an Enabled witness, which contains dependency satisfaction and precondition witnesses.",
      "statement": "Dispatchable f -> f.dependenciesSatisfied.",
      "status": "proof-source-present",
      "relations": [
        {"predicate": "formalizes", "target": "algorithm:dependency-admission"}
      ],
      "verification": [
        {"method": "Lean4", "target": "formal/Gordian/Scheduler.lean#dispatchable_implies_dependencies_satisfied", "status": "ci-required"}
      ]
    },
    {
      "@id": "theorem:evidence-identity-binding",
      "@type": ["Theorem"],
      "name": "Identity mismatch invalidates evidence compatibility",
      "summary": "Commit, spec, input, environment, or verifier digest mismatch contradicts the compatibility witness.",
      "statement": "A mismatch in any required bound identity implies not Compatible evidence candidate.",
      "status": "proof-source-present",
      "relations": [
        {"predicate": "formalizes", "target": "algorithm:evidence-freshness"},
        {"predicate": "groundedIn", "target": "source:slsa"},
        {"predicate": "groundedIn", "target": "source:in-toto"}
      ],
      "verification": [
        {"method": "Lean4", "target": "formal/Gordian/Evidence.lean", "status": "ci-required"}
      ]
    },
    {
      "@id": "theorem:worker-cannot-promote",
      "@type": ["Theorem"],
      "name": "Worker role cannot promote accepted frontier",
      "summary": "The v0 authority model grants accepted-frontier promotion only to Coordinator.",
      "statement": "not CanPromoteAccepted Role.worker.",
      "status": "proof-source-present",
      "relations": [
        {"predicate": "formalizes", "target": "concept:accepted-frontier"},
        {"predicate": "supportedBy", "target": "source:reliable-agents"}
      ],
      "verification": [
        {"method": "Lean4", "target": "formal/Gordian/Authority.lean#worker_cannot_promote", "status": "ci-required"}
      ]
    },
    {
      "@id": "theorem:accepted-conflict-free",
      "@type": ["Theorem"],
      "name": "Accepted candidates are conflict-free under the admission witness",
      "summary": "An AcceptanceWitness carries reconciliation, conflict-free, verification, freshness, and authority evidence.",
      "statement": "Acceptable f -> f.conflictFree.",
      "status": "proof-source-present",
      "relations": [
        {"predicate": "formalizes", "target": "algorithm:candidate-admission"}
      ],
      "verification": [
        {"method": "Lean4", "target": "formal/Gordian/Acceptance.lean#accepted_implies_conflict_free", "status": "ci-required"}
      ]
    },
    {
      "@id": "theorem:declared-noninterference-symmetric",
      "@type": ["Theorem"],
      "name": "Declared non-interference is symmetric",
      "summary": "The v0 read/write admission predicate gives the same non-interference result regardless of transaction ordering.",
      "statement": "DeclaredNonInterfering a b -> DeclaredNonInterfering b a.",
      "status": "proof-source-present",
      "relations": [
        {"predicate": "formalizes", "target": "concept:semantic-claims"}
      ],
      "verification": [
        {"method": "Lean4", "target": "formal/Gordian/Conflict.lean#declared_noninterference_symmetric", "status": "ci-required", "note": "This proves symmetry of the declared predicate, not real-world semantic independence."}
      ]
    },
    {
      "@id": "theorem:replay-same-history",
      "@type": ["Theorem"],
      "name": "Deterministic projector returns equal state for equal history",
      "summary": "For a fixed pure projection function, equal event histories project to equal state.",
      "statement": "a = b -> replay project a = replay project b.",
      "status": "proof-source-present",
      "relations": [
        {"predicate": "formalizes", "target": "algorithm:reconciliation"}
      ],
      "verification": [
        {"method": "Lean4", "target": "formal/Gordian/Replay.lean#replay_same_history", "status": "ci-required", "note": "This is deliberately narrow: determinism of external effects is not assumed."}
      ]
    },
    {
      "@id": "claim:isolation-plus-coordination",
      "@type": ["Claim"],
      "name": "Isolation should be paired with explicit coordination",
      "summary": "Recent agent studies jointly suggest isolated execution is useful but insufficient without shared coordination/state management.",
      "statement": "For concurrent software agents, isolated code state plus explicit coordination is better supported than uncoordinated isolated workspaces alone.",
      "status": "evidence-supported-not-universal",
