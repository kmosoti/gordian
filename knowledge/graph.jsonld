      "@id": "hypothesis:atom-boundary",
      "@type": ["Hypothesis"],
      "name": "Atom is the correct global scheduling boundary",
      "summary": "Scheduling at Atom granularity while keeping Quarks local produces useful parallelism and preserves black-box modularity.",
